@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IBacklogService BacklogService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Мой день</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка данных...</p>
        </div>
    }
    else if (dashboard != null)
    {
        <!-- Заголовок -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Мой день</h2>
                <p class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</p>
            </div>
            <div>
                <button class="btn btn-outline-primary me-2" @onclick="RefreshData">
                    🔄 Обновить
                </button>
                <button class="btn btn-primary" @onclick="SaveDailyPlan" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    💾 Сохранить план
                </button>
            </div>
        </div>

        <div class="row">
            <!-- Левая колонка - Работал вчера -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">📋 Что я делал вчера?</h5>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (dashboard.WorkedYesterday != null && dashboard.WorkedYesterday.Any())
                        {
                            <div class="list-group">
                                @foreach (var task in dashboard.WorkedYesterday)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>@task.Title</strong>
                                                <br />
                                                <small class="text-muted">
                                                    Проект: @task.ProjectName | Статус: @task.Status
                                                </small>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => AddBlockerForTask(task.Id, task.Title)">
                                                ⚠️ Блокер
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="mt-3">
                                <textarea class="form-control" @bind="workedYesterdayNotes"
                                          placeholder="Дополнительные заметки о сделанном..." rows="2"></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <p>Нет записей о работе за вчера</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Правая колонка - План на сегодня -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">🎯 Что я планирую сделать сегодня?</h5>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (dashboard.PlanForToday != null && dashboard.PlanForToday.Any())
                        {
                            <div class="list-group">
                                @foreach (var task in dashboard.PlanForToday)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>@task.Title</strong>
                                                <br />
                                                <small class="text-muted">
                                                    Проект: @task.ProjectName | Статус: @task.Status
                                                </small>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => AddBlockerForTask(task.Id, task.Title)">
                                                ⚠️ Блокер
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="mt-3">
                                <textarea class="form-control" @bind="planForTodayNotes"
                                          placeholder="Дополнительные заметки о планах..." rows="2"></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <p>Нет запланированных задач</p>
                                <button class="btn btn-sm btn-primary" @onclick="GoToProjects">
                                    Перейти к проектам
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Блокеры -->
        <div class="row mt-2">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">⚠️ Мои блокеры</h5>
                        <button class="btn btn-sm btn-light" @onclick="ShowAddBlockerModal">
                            + Добавить блокер
                        </button>
                    </div>
                    <div class="card-body">
                        @if (dashboard.ActiveBlockers != null && dashboard.ActiveBlockers.Any())
                        {
                            <div class="list-group">
                                @foreach (var blocker in dashboard.ActiveBlockers)
                                {
                                    <div class="list-group-item list-group-item-danger">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@blocker.Description</strong>
                                                <br />
                                                <small class="text-muted">
                                                    Серьезность: @blocker.Severity |
                                                    Создан: @blocker.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                                </small>
                                            </div>
                                            <button class="btn btn-sm btn-outline-success"
                                                    @onclick="() => ResolveBlocker(blocker.Id)">
                                                ✅ Разрешен
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <p>Нет активных блокеров. Отлично!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Статистика -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3>@dashboard.TotalTasksAssigned</h3>
                        <span>Всего задач</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3>@dashboard.TasksInProgress</h3>
                        <span>В работе</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3>@dashboard.TasksCompletedToday</h3>
                        <span>Выполнено сегодня</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3 class="text-danger">@dashboard.OverdueTasks</h3>
                        <span>Просрочено</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            <h5>Не удалось загрузить данные</h5>
            <p>Попробуйте обновить страницу</p>
            <button class="btn btn-primary" @onclick="RefreshData">Обновить</button>
        </div>
    }

    <!-- Модальное окно добавления блокера -->
    @if (showBlockerModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Добавление блокера</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseBlockerModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(selectedTaskForBlocker))
                        {
                            <div class="alert alert-info">
                                Связанная задача: <strong>@selectedTaskForBlocker</strong>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Описание проблемы *</label>
                            <textarea @bind="newBlockerDescription" class="form-control" rows="3"
                                      placeholder="Опишите, что мешает работе..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Серьезность</label>
                            <select @bind="newBlockerSeverity" class="form-select">
                                <option value="Low">Низкая</option>
                                <option value="Medium">Средняя</option>
                                <option value="High">Высокая</option>
                                <option value="Critical">Критическая</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseBlockerModal">Отмена</button>
                        <button class="btn btn-danger" @onclick="AddBlocker" disabled="@isSavingBlocker">
                            @if (isSavingBlocker)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Добавить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .list-group-item {
        transition: background-color 0.2s;
    }

        .list-group-item:hover {
            background-color: #f8f9fa;
        }

    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
    }
</style>

@code {
    private PersonalDashboardResponse? dashboard;
    private string workedYesterdayNotes = "";
    private string planForTodayNotes = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showBlockerModal = false;
    private string newBlockerDescription = "";
    private string newBlockerSeverity = "Medium";
    private Guid? selectedBlockerTaskId = null;
    private string selectedTaskForBlocker = "";
    private bool isSavingBlocker = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var result = await DashboardService.GetPersonalDashboardAsync();
            if (result.Success && result.Data != null)
            {
                dashboard = result.Data;
                await LoadSavedDailyPlan();
            }
            else
            {
                Console.WriteLine($"Ошибка загрузки: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки дашборда: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSavedDailyPlan()
    {
        try
        {
            // Здесь можно загрузить сохраненные заметки из API
            // Пока оставляем пустым
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки заметок: {ex.Message}");
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task SaveDailyPlan()
    {
        if (dashboard == null) return;

        isSaving = true;
        try
        {
            var request = new UpdateDailyTasksRequest
            {
                Date = DateTime.Now.Date,
                WorkedYesterday = dashboard.WorkedYesterday.Select(t => new DailyTaskItem
                {
                    TaskId = t.Id,
                    TaskTitle = t.Title,
                    Notes = workedYesterdayNotes
                }).ToList(),
                PlanForToday = dashboard.PlanForToday.Select(t => new DailyTaskItem
                {
                    TaskId = t.Id,
                    TaskTitle = t.Title,
                    Notes = planForTodayNotes
                }).ToList(),
                Blockers = dashboard.ActiveBlockers.Select(b => new DailyBlockerItem
                {
                    Description = b.Description,
                    Severity = b.Severity
                }).ToList()
            };

            var result = await DashboardService.UpdateDailyTasksAsync(request);
            if (result.Success)
            {
                await JS.InvokeVoidAsync("alert", "План на день сохранен!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Ошибка сохранения: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка сохранения: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Произошла ошибка при сохранении");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AddBlockerForTask(Guid taskId, string taskTitle)
    {
        selectedBlockerTaskId = taskId;
        selectedTaskForBlocker = taskTitle;
        newBlockerDescription = "";
        newBlockerSeverity = "Medium";
        showBlockerModal = true;
    }

    private void ShowAddBlockerModal()
    {
        selectedBlockerTaskId = null;
        selectedTaskForBlocker = "";
        newBlockerDescription = "";
        newBlockerSeverity = "Medium";
        showBlockerModal = true;
    }

    private void CloseBlockerModal()
    {
        showBlockerModal = false;
        selectedBlockerTaskId = null;
        selectedTaskForBlocker = "";
        newBlockerDescription = "";
    }

    private async Task AddBlocker()
    {
        if (string.IsNullOrWhiteSpace(newBlockerDescription))
        {
            await JS.InvokeVoidAsync("alert", "Введите описание блокера");
            return;
        }

        isSavingBlocker = true;
        try
        {
            ApiResponse<BlockerResponse>? result = null;

            if (selectedBlockerTaskId.HasValue)
            {
                var request = new AddBlockerRequest
                {
                    Description = newBlockerDescription,
                    Severity = newBlockerSeverity
                };
                result = await BacklogService.AddBlockerAsync(selectedBlockerTaskId.Value, request);
            }
            else
            {
                // Блокер без привязки к задаче - можно добавить через отдельный API
                // Пока просто закрываем модальное окно
                CloseBlockerModal();
                await JS.InvokeVoidAsync("alert", "Блокер добавлен (без привязки к задаче)");
                await LoadData();
                return;
            }

            if (result != null && result.Success)
            {
                CloseBlockerModal();
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Блокер добавлен");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Ошибка: {result?.Message ?? "Неизвестная ошибка"}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка добавления блокера: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Произошла ошибка при добавлении блокера");
        }
        finally
        {
            isSavingBlocker = false;
        }
    }

    private async Task ResolveBlocker(Guid blockerId)
    {
        try
        {
            var request = new ResolveBlockerRequest
            {
                ResolutionNote = "Разрешен пользователем"
            };
            var result = await BacklogService.ResolveBlockerAsync(blockerId, request);
            if (result.Success)
            {
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Блокер отмечен как разрешенный");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка разрешения блокера: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Произошла ошибка");
        }
    }

    private void GoToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private string GetStatusName(string status)
    {
        return status switch
        {
            "Backlog" => "Бэклог",
            "ToDo" => "To Do",
            "InProgress" => "In Progress",
            "Done" => "Done",
            _ => status
        };
    }
}