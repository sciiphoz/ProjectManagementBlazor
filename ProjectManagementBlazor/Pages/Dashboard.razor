@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IBacklogService BacklogService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject ISprintService SprintService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IErrorHandlingService ErrorHandling

<PageTitle>Мой день</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка данных...</p>
        </div>
    }
    else
    {
        <!-- Заголовок -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Мой день</h2>
                <p class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</p>
            </div>
            <div>
                <button class="btn btn-outline-primary" @onclick="RefreshData">
                    🔄 Обновить
                </button>
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <!-- Фильтр по проекту -->
<div class="col-md-4">
    <label class="form-label">Фильтр по проекту</label>
    <select class="form-select" value="@selectedProjectFilter" @onchange="OnProjectFilterChanged">
        <option value="">Все проекты</option>
        @foreach (var project in projects)
        {
            <option value="@project.Id">@project.Name</option>
        }
    </select>
</div>
<div class="col-md-4">
    <label class="form-label">Сортировка</label>
    <select class="form-select" value="@sortBy" @onchange="OnSortByChanged">
        <option value="project">По проекту</option>
        <option value="status">По статусу</option>
        <option value="title">По названию</option>
    </select>
</div>
<div class="col-md-4 d-flex align-items-end">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" 
               @bind="showOnlyActive" @bind:event="onchange" 
               id="showOnlyActive" />
        <label class="form-check-label" for="showOnlyActive">
            Только активные (не выполненные)
        </label>
    </div>
</div>

        <!-- Мои задачи -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">📋 Мои задачи (@filteredTasks.Count)</h5>
            </div>
            <div class="card-body">
                @if (filteredTasks.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Задача</th>
                                    <th>Проект</th>
                                    <th>Спринт</th>
                                    <th>Статус</th>
                                    <th>Story Points</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in filteredTasks)
                                {
                                    <tr>
                                        <td>
                                            <strong>@task.Title</strong>
                                            @if (!string.IsNullOrEmpty(task.Description))
                                            {
                                                <br />
                                                <small class="text-muted">@(task.Description.Length > 80 ? task.Description[..80] + "..." : task.Description)</small>
                                            }
                                        </td
                                        <td>@task.ProjectName</td
                                        <td>@task.SprintName</td
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(task.Status)">
                                                @GetStatusName(task.Status)
                                            </span>
                                        </td
                                        <td>
                                            @if (task.StoryPoints.HasValue)
                                            {
                                                <span class="badge bg-info">@task.StoryPoints SP</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td
                                        <td>
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-sm btn-outline-primary" 
                                                        title="Открыть задачу"
                                                        @onclick="() => GoToTask(task.Id, task.ProjectId)">
                                                    📖 Открыть
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" 
                                                        title="Добавить блокер"
                                                        @onclick="() => AddBlockerForTask(task.Id, task.Title)">
                                                    ⚠️ Блокер
                                                </button>
                                            </div>
                                        </td
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <p>У вас нет активных задач</p>
                        <button class="btn btn-sm btn-primary" @onclick="GoToProjects">
                            Перейти к проектам
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Статистика -->
        <div class="row">
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3>@allTasksCount</h3>
                        <span>Всего задач</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3>@allTasksCount - @completedTasksCount</h3>
                        <span>Активных задач</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3>@completedTasksCount</h3>
                        <span>Выполнено</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Модальное окно добавления блокера -->
    @if (showBlockerModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Добавление блокера</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseBlockerModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(selectedTaskForBlocker))
                        {
                            <div class="alert alert-info">
                                Связанная задача: <strong>@selectedTaskForBlocker</strong>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Описание проблемы *</label>
                            <textarea @bind="newBlockerDescription" class="form-control" rows="3" 
                                      placeholder="Опишите, что мешает работе..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Серьезность</label>
                            <select @bind="newBlockerSeverity" class="form-select">
                                <option value="Low">Низкая</option>
                                <option value="Medium">Средняя</option>
                                <option value="High">Высокая</option>
                                <option value="Critical">Критическая</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseBlockerModal">Отмена</button>
                        <button class="btn btn-danger" @onclick="AddBlocker" disabled="@isSavingBlocker">
                            @if (isSavingBlocker)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Добавить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .table td {
        vertical-align: middle;
    }
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        z-index: 1050;
    }
    .btn-group {
        gap: 5px;
    }
</style>

@code {
    private List<MyTaskViewModel> myTasks = new();
    private List<ProjectResponse> projects = new();
    private List<MyTaskViewModel> filteredTasks = new();
    private string? errorMessage = null;
    private bool isLoading = true;
    
    // Фильтры
    private string selectedProjectFilter = "";
    private string sortBy = "project";
    private bool showOnlyActive = true;
    
    // Статистика
    private int allTasksCount = 0;
    private int completedTasksCount = 0;
    
    // Блокеры
    private bool showBlockerModal = false;
    private string newBlockerDescription = "";
    private string newBlockerSeverity = "Medium";
    private Guid? selectedBlockerTaskId = null;
    private string selectedTaskForBlocker = "";
    private bool isSavingBlocker = false;

    public class MyTaskViewModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public Guid ProjectId { get; set; }
        public string ProjectName { get; set; } = string.Empty;
        public string SprintName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public decimal? StoryPoints { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            await LoadProjects();
            await LoadMyTasks();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            errorMessage = "Не удалось загрузить данные";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadProjects()
    {
        try
        {
            var projectsResult = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 100 });
            if (projectsResult.Success && projectsResult.Data != null)
            {
                projects = projectsResult.Data.Items;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки проектов: {ex.Message}");
            projects = new List<ProjectResponse>();
        }
    }

    private async Task LoadMyTasks()
    {
        myTasks.Clear();
        
        try
        {
            var userResult = await AuthService.GetCurrentUserAsync();
            if (!userResult.Success || userResult.Data == null)
            {
                Console.WriteLine("Не удалось получить текущего пользователя");
                return;
            }
            
            var projectsResult = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 100 });
            if (!projectsResult.Success || projectsResult.Data == null)
            {
                Console.WriteLine("Не удалось получить проекты пользователя");
                return;
            }
            
            foreach (var project in projectsResult.Data.Items)
            {
                var sprintsResult = await SprintService.GetProjectSprintsAsync(project.Id);
                List<SprintBriefResponse> sprints = new();
                if (sprintsResult.Success && sprintsResult.Data != null)
                {
                    sprints = sprintsResult.Data;
                }
                
                var backlogResult = await BacklogService.GetProjectBacklogAsync(project.Id, new PagedRequest { PageNumber = 1, PageSize = 100 });
                if (backlogResult.Success && backlogResult.Data != null)
                {
                    var userTasks = backlogResult.Data.Items
                        .Where(t => t.Assignee?.Id == userResult.Data.Id);
                    
                    foreach (var task in userTasks)
                    {
                        var sprintName = "";
                        if (task.Sprint != null)
                        {
                            sprintName = task.Sprint.Name;
                        }
                        
                        myTasks.Add(new MyTaskViewModel
                        {
                            Id = task.Id,
                            Title = task.Title ?? "Без названия",
                            Description = task.Description,
                            ProjectId = project.Id,
                            ProjectName = project.Name,
                            SprintName = sprintName,
                            Status = task.Status,
                            StoryPoints = task.StoryPoints
                        });
                    }
                }
            }
            
            allTasksCount = myTasks.Count;
            completedTasksCount = myTasks.Count(t => t.Status == "Done");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки задач: {ex.Message}");
            throw;
        }
    }

    private void OnFilterChanged()
    {
        ApplyFilters();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        var query = myTasks.AsEnumerable();
        
        // Фильтр по проекту
        if (!string.IsNullOrEmpty(selectedProjectFilter))
        {
            query = query.Where(t => t.ProjectId.ToString() == selectedProjectFilter);
        }
        
        // Фильтр по активности
        if (showOnlyActive)
        {
            query = query.Where(t => t.Status != "Done");
        }
        
        // Сортировка
        query = sortBy switch
        {
            "status" => query.OrderBy(t => GetStatusOrder(t.Status)),
            "title" => query.OrderBy(t => t.Title),
            _ => query.OrderBy(t => t.ProjectName).ThenBy(t => t.Status)
        };
        
        filteredTasks = query.ToList();
    }

    private int GetStatusOrder(string status)
    {
        return status switch
        {
            "ToDo" => 1,
            "InProgress" => 2,
            "Review" => 3,
            "Backlog" => 4,
            "Done" => 5,
            _ => 6
        };
    }

    private async Task RefreshData()
    {
        await LoadData();
        await JS.InvokeVoidAsync("alert", "Данные обновлены");
    }

    private async Task GoToTask(Guid taskId, Guid projectId)
    {
        try
        {
            var taskResult = await BacklogService.GetBacklogItemByIdAsync(taskId);
            if (taskResult.Success && taskResult.Data != null && taskResult.Data.Sprint != null)
            {
                var sprintId = taskResult.Data.Sprint.Id;
                // Передаём TaskId как часть пути
                Navigation.NavigateTo($"/sprints/{sprintId}/{taskId}");
            }
            else
            {
                await ErrorHandling.TriggerError("Эта задача не находится в активном спринте");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка перехода к задаче: {ex.Message}");
            await ErrorHandling.TriggerError("Не удалось открыть задачу");
        }
    }

    private void AddBlockerForTask(Guid taskId, string taskTitle)
    {
        selectedBlockerTaskId = taskId;
        selectedTaskForBlocker = taskTitle;
        newBlockerDescription = "";
        newBlockerSeverity = "Medium";
        showBlockerModal = true;
    }

    private void CloseBlockerModal()
    {
        showBlockerModal = false;
        selectedBlockerTaskId = null;
        selectedTaskForBlocker = "";
        newBlockerDescription = "";
    }

    private async Task AddBlocker()
    {
        if (string.IsNullOrWhiteSpace(newBlockerDescription))
        {
            await ErrorHandling.TriggerError("Введите описание блокера");
            return;
        }

        isSavingBlocker = true;
        try
        {
            if (selectedBlockerTaskId.HasValue)
            {
                var request = new AddBlockerRequest
                {
                    Description = newBlockerDescription,
                    Severity = newBlockerSeverity
                };
                var result = await BacklogService.AddBlockerAsync(selectedBlockerTaskId.Value, request);
                
                if (result != null && result.Success)
                {
                    CloseBlockerModal();
                    await JS.InvokeVoidAsync("alert", "Блокер добавлен");
                }
                else
                {
                    await ErrorHandling.TriggerError($"Ошибка: {result?.Message ?? "Неизвестная ошибка"}");
                }
            }
            else
            {
                CloseBlockerModal();
                await JS.InvokeVoidAsync("alert", "Блокер добавлен");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
            await ErrorHandling.TriggerError("Произошла ошибка");
        }
        finally
        {
            isSavingBlocker = false;
        }
    }

    private void GoToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private void OnProjectFilterChanged(ChangeEventArgs e)
    {
        selectedProjectFilter = e.Value?.ToString() ?? "";
        ApplyFilters();
        StateHasChanged();
    }

    private void OnSortByChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "project";
        ApplyFilters();
        StateHasChanged();
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Backlog" => "bg-secondary",
            "ToDo" => "bg-info",
            "InProgress" => "bg-warning text-dark",
            "Review" => "bg-primary",
            "Done" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetStatusName(string status)
    {
        return status switch
        {
            "Backlog" => "Бэклог",
            "ToDo" => "To Do",
            "InProgress" => "In Progress",
            "Review" => "Review",
            "Done" => "Done",
            _ => status
        };
    }
}