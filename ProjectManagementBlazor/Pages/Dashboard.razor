@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IBacklogService BacklogService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject ISprintService SprintService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling
@inject DialogService DialogService

<PageTitle>Мой день</PageTitle>

<div class="dashboard-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else
    {
        <!-- Заголовок -->
        <div class="dash-header">
            <div>
                <h2>Мой день</h2>
                <span class="text-muted small">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</span>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshData">
                <i class="bi bi-arrow-repeat"></i>
            </button>
        </div>

        <!-- Метрики -->
        <div class="dash-metrics">
            <div class="dash-metric">
                <span class="dash-metric-value">@allTasksCount</span>
                <span class="dash-metric-label">Всего</span>
            </div>
            <div class="dash-metric text-warning">
                <span class="dash-metric-value">@myTasks.Count(t => t.Status == "InProgress")</span>
                <span class="dash-metric-label">В работе</span>
            </div>
            <div class="dash-metric text-danger">
                <span class="dash-metric-value">@myTasks.Count(t => t.Status != "Done" && t.SprintEndDate.HasValue && t.SprintEndDate.Value.Date < DateTime.Now.Date)</span>
                <span class="dash-metric-label">Просрочено</span>
            </div>
            <div class="dash-metric text-success">
                <span class="dash-metric-value">@completedTasksCount</span>
                <span class="dash-metric-label">Выполнено</span>
            </div>
        </div>

        <!-- Фильтры -->
        <div class="dash-filters">
            <select class="form-select form-select-sm" value="@selectedProjectFilter" @onchange="OnProjectFilterChanged">
                <option value="">Все проекты</option>
                @foreach (var p in projects)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
            <select class="form-select form-select-sm" value="@sortBy" @onchange="OnSortByChanged">
                <option value="deadline">По дедлайну</option>
                <option value="project">По проекту</option>
                <option value="status">По статусу</option>
            </select>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary @(statusFilter == "active" ? "active" : "")" @onclick="ShowActiveFilter">
                    Активные
                </button>
                <button class="btn btn-outline-secondary @(statusFilter == "overdue" ? "active" : "")" @onclick="ShowOverdueFilter">
                    Просрочены
                </button>
                <button class="btn btn-outline-secondary @(statusFilter == "done" ? "active" : "")" @onclick="ShowDoneFilter">
                    Готово
                </button>
            </div>
        </div>

        <!-- Задачи -->
        @if (errorMessage != null)
        {
            <div class="alert alert-danger small">@errorMessage</div>
        }

        @if (filteredTasks.Any())
        {
            <!-- Просроченные -->
            @if (overdueTasks.Any())
            {
                <div class="task-group danger">
                    <div class="task-group-header">
                        <i class="bi bi-exclamation-triangle me-1"></i> Просроченные · @overdueTasks.Count
                    </div>
                    @foreach (var t in overdueTasks)
                    {
                        <div class="task-row overdue" @onclick="() => GoToTask(t.Id, t.ProjectId, t.SprintId)">
                            <div class="task-row-left">
                                <span class="task-title">@t.Title</span>
                                <span class="task-sub">@t.ProjectName · @t.SprintName</span>
                            </div>
                            <span class="badge bg-danger">@(t.SprintEndDate?.ToString("dd.MM"))</span>
                        </div>
                    }
                </div>
            }

            <!-- Скоро дедлайн -->
            @if (dueSoonTasks.Any())
            {
                <div class="task-group warning">
                    <div class="task-group-header">
                        <i class="bi bi-clock me-1"></i> Скоро дедлайн · @dueSoonTasks.Count
                    </div>
                    @foreach (var t in dueSoonTasks)
                    {
                        var daysLeft = (t.SprintEndDate!.Value.Date - DateTime.Now.Date).Days;
                        <div class="task-row due-soon" @onclick="() => GoToTask(t.Id, t.ProjectId, t.SprintId)">
                            <div class="task-row-left">
                                <span class="task-title">@t.Title</span>
                                <span class="task-sub">@t.ProjectName · @t.SprintName</span>
                            </div>
                            <span class="badge bg-warning text-dark">@daysLeft дн.</span>
                        </div>
                    }
                </div>
            }

            <!-- Активные -->
            @if (normalTasks.Any())
            {
                <div class="task-group">
                    <div class="task-group-header">
                        <i class="bi bi-list-check me-1"></i> Активные · @normalTasks.Count
                    </div>
                    @foreach (var t in normalTasks)
                    {
                        <div class="task-row" @onclick="() => GoToTask(t.Id, t.ProjectId, t.SprintId)">
                            <div class="task-row-left">
                                <span class="task-title">@t.Title</span>
                                <span class="task-sub">@t.ProjectName · @t.SprintName</span>
                            </div>
                            <span class="badge @GetStatusBadgeClass(t.Status)">@GetStatusName(t.Status)</span>
                        </div>
                    }
                </div>
            }

            <!-- Выполненные -->
            @if (doneTasks.Any() && statusFilter != "active" && statusFilter != "overdue")
            {
                <div class="task-group success">
                    <div class="task-group-header">
                        <i class="bi bi-check-circle me-1"></i> Выполненные · @doneTasks.Count
                    </div>
                    @foreach (var t in doneTasks)
                    {
                        <div class="task-row done">
                            <span>@t.Title</span>
                            <span class="text-muted small">@t.ProjectName</span>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center py-4 text-muted small">
                @if (myTasks.Any())
                {
                    <p>Нет задач по фильтрам</p>
                }
                else
                {
                    <p>Нет задач в активных спринтах</p>
                    <button class="btn btn-primary btn-sm mt-2" @onclick="GoToProjects">Перейти к проектам</button>
                }
            </div>
        }
    }
</div>

<style>
    .dashboard-page {
        max-width: 650px;
        margin: 0 auto;
    }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .dash-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .dash-metrics {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .dash-metric {
        flex: 1;
        text-align: center;
        padding: 0.5rem;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.5rem;
    }

    .dash-metric-value {
        font-size: 1.25rem;
        font-weight: 700;
        display: block;
        color: inherit;
    }

    .dash-metric-label {
        font-size: 0.65rem;
        color: var(--text-secondary);
    }

    .dash-filters {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

        .dash-filters .btn-group {
            gap: 0;
        }

            .dash-filters .btn-group .btn {
                border-radius: 0.25rem !important;
                margin-right: 0.25rem;
            }

                .dash-filters .btn-group .btn:last-child {
                    margin-right: 0;
                }

    .task-group {
        margin-bottom: 1rem;
    }

    .task-group-header {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        margin-bottom: 0.375rem;
    }

    .task-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0.625rem;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.375rem;
        margin-bottom: 0.25rem;
        cursor: pointer;
        transition: box-shadow 0.1s;
    }

        .task-row:hover {
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
        }

        .task-row.overdue {
            border-left: 3px solid #EF4444;
        }

        .task-row.due-soon {
            border-left: 3px solid #F59E0B;
        }

        .task-row.done {
            opacity: 0.6;
        }

    .task-row-left {
        min-width: 0;
    }

    .task-title {
        font-size: 0.8rem;
        font-weight: 500;
        display: block;
    }

    .task-sub {
        font-size: 0.7rem;
        color: var(--text-secondary);
    }

    [data-bs-theme="dark"] .dash-metric,
    [data-bs-theme="dark"] .task-row {
        background: #1E293B;
        border-color: #334155;
    }
</style>

@code {
    private List<MyTaskViewModel> myTasks = new();
    private List<ProjectResponse> projects = new();
    private List<MyTaskViewModel> filteredTasks = new();

    private string? errorMessage = null;
    private bool isLoading = true;
    
    private string selectedProjectFilter = "";
    private string sortBy = "deadline";
    private string statusFilter = "active";
    
    private int allTasksCount = 0;
    private int completedTasksCount = 0;
    private int activeSprintsCount = 0;

    private List<MyTaskViewModel> overdueTasks
    {
        get
        {
            return filteredTasks.Where(t =>
                t.Status != "Done" &&
                t.SprintEndDate.HasValue &&
                t.SprintEndDate.Value.Date < DateTime.Now.Date
            ).ToList();
        }
    }

    private List<MyTaskViewModel> dueSoonTasks
    {
        get
        {
            return filteredTasks.Where(t =>
                t.Status != "Done" &&
                t.SprintEndDate.HasValue &&
                t.SprintEndDate.Value.Date >= DateTime.Now.Date &&
                (t.SprintEndDate.Value.Date - DateTime.Now.Date).Days <= 2
            ).ToList();
        }
    }

    private List<MyTaskViewModel> normalTasks
    {
        get
        {
            return filteredTasks.Where(t =>
                t.Status != "Done" &&
                (!t.SprintEndDate.HasValue || (t.SprintEndDate.Value.Date - DateTime.Now.Date).Days > 2)
            ).ToList();
        }
    }

    private List<MyTaskViewModel> doneTasks
    {
        get
        {
            return filteredTasks.Where(t => t.Status == "Done").ToList();
        }
    }

    public class MyTaskViewModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public Guid ProjectId { get; set; }
        public string ProjectName { get; set; } = "";
        public string SprintName { get; set; } = "";
        public Guid SprintId { get; set; }
        public DateTime? SprintEndDate { get; set; }
        public string Status { get; set; } = "";
        public decimal? StoryPoints { get; set; }
        public bool IsProjectArchived { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            await LoadProjects();
            await LoadMyTasks();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            errorMessage = "Не удалось загрузить данные";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadProjects()
    {
        try
        {
            var r = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 100 });
            if (r.Success && r.Data != null)
            {
                projects = r.Data.Items.Where(p => !p.IsArchived).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки проектов: {ex.Message}");
            projects = new List<ProjectResponse>();
        }
    }

    private async Task LoadMyTasks()
    {
        myTasks.Clear();
        try
        {
            var userResult = await AuthService.GetCurrentUserAsync();
            if (!userResult.Success || userResult.Data == null)
            {
                return;
            }
            var currentUserId = userResult.Data.Id;
            var projectsResult = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 100 });
            if (!projectsResult.Success || projectsResult.Data == null)
            {
                return;
            }

            foreach (var project in projectsResult.Data.Items.Where(x => !x.IsArchived))
            {
                var sprintsResult = await SprintService.GetProjectSprintsAsync(project.Id);
                if (!sprintsResult.Success || sprintsResult.Data == null)
                {
                    continue;
                }
                var activeSprints = sprintsResult.Data.Where(s => s.IsActive).ToList();
                if (!activeSprints.Any())
                {
                    continue;
                }
                activeSprintsCount += activeSprints.Count;

                var backlogResult = await BacklogService.GetProjectBacklogAsync(project.Id, new PagedRequest { PageNumber = 1, PageSize = 200 });
                if (!backlogResult.Success || backlogResult.Data == null)
                {
                    continue;
                }

                var tasks = backlogResult.Data.Items.Where(t =>
                    t.Assignee?.Id == currentUserId &&
                    t.Sprint != null &&
                    activeSprints.Any(s => s.Id == t.Sprint.Id)
                );

                foreach (var task in tasks)
                {
                    var sprint = activeSprints.First(s => s.Id == task.Sprint.Id);
                    myTasks.Add(new MyTaskViewModel
                    {
                        Id = task.Id,
                        Title = task.Title ?? "—",
                        Description = task.Description,
                        ProjectId = project.Id,
                        ProjectName = project.Name,
                        SprintName = sprint.Name,
                        SprintId = sprint.Id,
                        SprintEndDate = sprint.EndDate,
                        Status = task.Status,
                        StoryPoints = task.StoryPoints,
                        IsProjectArchived = project.IsArchived
                    });
                }
            }
            allTasksCount = myTasks.Count;
            completedTasksCount = myTasks.Count(t => t.Status == "Done");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки задач: {ex.Message}");
        }
    }

    private void ApplyFilters()
    {
        var query = myTasks.AsEnumerable();

        if (!string.IsNullOrEmpty(selectedProjectFilter))
        {
            query = query.Where(t => t.ProjectId.ToString() == selectedProjectFilter);
        }

        query = statusFilter switch
        {
            "active" => query.Where(t => t.Status != "Done"),
            "overdue" => query.Where(t => t.Status != "Done" && t.SprintEndDate.HasValue && t.SprintEndDate.Value.Date < DateTime.Now.Date),
            "done" => query.Where(t => t.Status == "Done"),
            _ => query
        };

        query = sortBy switch
        {
            "deadline" => query.OrderBy(t => t.SprintEndDate ?? DateTime.MaxValue),
            "status" => query.OrderBy(t => GetStatusOrder(t.Status)),
            _ => query.OrderBy(t => t.ProjectName)
        };

        filteredTasks = query.ToList();
    }

    private int GetStatusOrder(string status)
    {
        return status switch
        {
            "InProgress" => 1,
            "ToDo" => 2,
            _ => 5
        };
    }

    private void ShowActiveFilter()
    {
        SetStatusFilter("active");
    }

    private void ShowOverdueFilter()
    {
        SetStatusFilter("overdue");
    }

    private void ShowDoneFilter()
    {
        SetStatusFilter("done");
    }

    private void SetStatusFilter(string filter)
    {
        statusFilter = filter;
        ApplyFilters();
        StateHasChanged();
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task GoToTask(Guid taskId, Guid projectId, Guid sprintId)
    {
        try
        {
            if (sprintId != Guid.Empty)
            {
                Navigation.NavigateTo($"/sprints/{sprintId}/{taskId}");
            }
            else
            {
                await ErrorHandling.TriggerError("Задача не в активном спринте");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка перехода: {ex.Message}");
            await ErrorHandling.TriggerError("Не удалось открыть задачу");
        }
    }

    private void GoToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private void OnProjectFilterChanged(ChangeEventArgs e)
    {
        selectedProjectFilter = e.Value?.ToString() ?? "";
        ApplyFilters();
        StateHasChanged();
    }

    private void OnSortByChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "deadline";
        ApplyFilters();
        StateHasChanged();
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "InProgress" => "bg-warning text-dark",
            "Done" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetStatusName(string status)
    {
        return status switch
        {
            "InProgress" => "В работе",
            "Done" => "Готово",
            _ => "К выполнению"
        };
    }
}