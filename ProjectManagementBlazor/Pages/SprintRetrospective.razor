@page "/retrospective/{SprintId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IRetrospectiveService RetrospectiveService
@inject ISprintService SprintService
@inject IAuthService AuthService
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject DialogService DialogService

<PageTitle>Ретроспектива спринта</PageTitle>

<div class="retro-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (sprint != null)
    {
        <div class="retro-header">
            <div>
                <h2>Ретроспектива</h2>
                <span class="text-muted small">@sprint.Name · @sprint.StartDate.ToString("dd.MM") — @sprint.EndDate.ToString("dd.MM")</span>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i> К спринтам
            </button>
        </div>

        <div class="retro-grid">
            @foreach (var col in new[] {
                ("Good", "Что прошло хорошо", "bg-success", "newGoodItem"),
                ("Bad", "Что нужно улучшить", "bg-warning text-dark", "newBadItem"),
                ("Idea", "Идеи", "bg-info text-white", "newIdeaItem"),
                ("Action", "Действия", "bg-danger text-white", "newActionItem")
                })
            {
                var (category, title, headerClass, fieldName) = col;
                var items = category switch
                {
                    "Good" => retrospective?.GoodItems,
                    "Bad" => retrospective?.BadItems,
                    "Idea" => retrospective?.Ideas,
                    "Action" => retrospective?.Actions,
                    _ => null
                };
                <div class="retro-col">
                    <div class="retro-col-header @headerClass">
                        <span>@title</span>
                        <span class="retro-col-count">@(items?.Count ?? 0)</span>
                    </div>
                    <div class="retro-col-body">
                        @if (items != null && items.Any())
                        {
                            foreach (var item in items)
                            {
                                <div class="retro-item @(item.HasUserVoted ? "voted" : "")">
                                    <p class="retro-item-text">@item.Content</p>
                                    <div class="retro-item-footer">
                                        <small class="text-muted">@item.CreatedBy.FullName</small>
                                        <div class="d-flex gap-1">
                                            @if (!isViewer)
                                            {
                                                <button class="btn btn-sm @(item.HasUserVoted ? "btn-primary" : "btn-outline-primary")"
                                                        @onclick="() => ToggleVote(item.Id, !item.HasUserVoted)">
                                                    <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">
                                                    <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                                </span>
                                            }
                                            @if (!isViewer && isEditable && currentUserId == item.CreatedBy.Id)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(item.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted small py-3">Нет записей</div>
                        }
                        @if (!isViewer && isEditable)
                        {
                            <textarea class="form-control form-control-sm" rows="2"
                                      placeholder="Добавить пункт..."
                                      @bind="GetFieldRef(fieldName).Value"></textarea>
                            <button class="btn btn-sm @GetButtonClass(category) mt-1 w-100"
                                    @onclick="() => AddItem(category)"
                                    disabled="string.IsNullOrWhiteSpace(GetFieldRef(fieldName).Value)">
                                <i class="bi bi-plus me-1"></i> Добавить
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (retrospective != null)
        {
            <div class="retro-summary">
                <div class="retro-summary-item">
                    <span class="text-muted small">Самый популярный пункт</span>
                    <span class="text-success fw-medium">@topGoodItem</span>
                </div>
                <div class="retro-summary-item">
                    <span class="text-muted small">Главное улучшение</span>
                    <span class="text-warning fw-medium">@topBadItem</span>
                </div>
                <div class="retro-summary-item">
                    <span class="text-muted small">Лучшая идея</span>
                    <span class="text-info fw-medium">@topIdeaItem</span>
                </div>
                <div class="retro-summary-item">
                    <span class="text-muted small">Ключевое действие</span>
                    <span class="text-danger fw-medium">@topActionItem</span>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <p>Спринт не найден</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">Назад</button>
        </div>
    }
</div>

<style>
    .retro-page {
        max-width: 1000px;
        margin: 0 auto;
    }

    .retro-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .retro-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .retro-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }

    .retro-col {
        border: 1px solid var(--border-color,#E2E8F0);
        border-radius: 0.5rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .retro-col-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .retro-col-count {
        background: rgba(0,0,0,0.1);
        border-radius: 8px;
        padding: 0.1rem 0.4rem;
        font-size: 0.65rem;
    }

    .retro-col-body {
        flex: 1;
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .retro-item {
        padding: 0.5rem;
        border: 1px solid var(--border-color,#E2E8F0);
        border-radius: 0.375rem;
    }

        .retro-item.voted {
            border-color: var(--primary-color);
            background: rgba(79,70,229,0.03);
        }

    .retro-item-text {
        font-size: 0.8rem;
        margin: 0 0 0.375rem;
    }

    .retro-item-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.7rem;
    }

    .retro-add {
        margin-top: auto;
        padding-top: 0.5rem;
    }

    .retro-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .retro-summary-item {
        padding: 0.5rem;
        border: 1px solid var(--border-color,#E2E8F0);
        border-radius: 0.375rem;
        text-align: center;
    }

        .retro-summary-item span {
            display: block;
        }

    @@media (max-width: 768px) {
        .retro-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .retro-summary {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    [data-bs-theme="dark"] .retro-col, [data-bs-theme="dark"] .retro-item, [data-bs-theme="dark"] .retro-summary-item {
        background: #1E293B;
        border-color: #334155;
    }

        [data-bs-theme="dark"] .retro-item.voted {
            background: rgba(129,140,248,0.08);
        }
</style>

@code {
    [Parameter] public Guid SprintId { get; set; }

    private SprintResponse? sprint;
    private RetrospectiveBoardResponse? retrospective;
    private Guid currentUserId;
    private bool isLoading = true;
    private bool isEditable = true;
    private bool isViewer = false;

    private string newGoodItem = "";
    private string newBadItem = "";
    private string newIdeaItem = "";
    private string newActionItem = "";

    private string topGoodItem = "—";
    private string topBadItem = "—";
    private string topIdeaItem = "—";
    private string topActionItem = "—";

    private StringRef GetFieldRef(string fieldName)
    {
        return fieldName switch
        {
            "newGoodItem" => new StringRef(() => newGoodItem, v => newGoodItem = v),
            "newBadItem" => new StringRef(() => newBadItem, v => newBadItem = v),
            "newIdeaItem" => new StringRef(() => newIdeaItem, v => newIdeaItem = v),
            "newActionItem" => new StringRef(() => newActionItem, v => newActionItem = v),
            _ => new StringRef(() => "", _ => { })
        };
    }

    private string GetButtonClass(string category)
    {
        return category switch
        {
            "Good" => "btn-success",
            "Bad" => "btn-warning",
            "Idea" => "btn-info",
            "Action" => "btn-danger",
            _ => "btn-primary"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadData();
        await CheckViewerRole();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var result = await AuthService.GetCurrentUserAsync();
            if (result.Success && result.Data != null)
            {
                currentUserId = result.Data.Id;
            }
        }
        catch { }
    }

    private async Task CheckViewerRole()
    {
        try
        {
            if (sprint == null || currentUserId == Guid.Empty) return;
            var membersResult = await ProjectService.GetProjectMembersAsync(sprint.ProjectId);
            if (membersResult.Success && membersResult.Data != null)
            {
                var member = membersResult.Data.FirstOrDefault(m => m.UserId == currentUserId);
                isViewer = member?.Role == "Viewer";
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var sprintResult = await SprintService.GetSprintByIdAsync(SprintId);
            if (sprintResult.Success && sprintResult.Data != null)
            {
                sprint = sprintResult.Data;
                isEditable = sprint.Status == "Completed";
            }

            var retroResult = await RetrospectiveService.GetRetrospectiveBoardAsync(SprintId);
            if (retroResult.Success && retroResult.Data != null)
            {
                retrospective = retroResult.Data;
                CalculateTopItems();
            }
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateTopItems()
    {
        if (retrospective == null) return;
        topGoodItem = retrospective.GoodItems.OrderByDescending(i => i.VoteCount).FirstOrDefault()?.Content ?? "—";
        topBadItem = retrospective.BadItems.OrderByDescending(i => i.VoteCount).FirstOrDefault()?.Content ?? "—";
        topIdeaItem = retrospective.Ideas.OrderByDescending(i => i.VoteCount).FirstOrDefault()?.Content ?? "—";
        topActionItem = retrospective.Actions.OrderByDescending(i => i.VoteCount).FirstOrDefault()?.Content ?? "—";
    }

    private async Task AddItem(string category)
    {
        if (isViewer) return;
        var content = category switch
        {
            "Good" => newGoodItem,
            "Bad" => newBadItem,
            "Idea" => newIdeaItem,
            "Action" => newActionItem,
            _ => ""
        };

        if (string.IsNullOrWhiteSpace(content)) return;

        var r = await RetrospectiveService.AddRetrospectiveItemAsync(SprintId,
            new AddRetrospectiveItemRequest { Category = category, Content = content });

        if (r.Success)
        {
            switch (category)
            {
                case "Good": newGoodItem = ""; break;
                case "Bad": newBadItem = ""; break;
                case "Idea": newIdeaItem = ""; break;
                case "Action": newActionItem = ""; break;
            }
            await LoadData();
        }
    }

    private async Task ToggleVote(Guid itemId, bool addVote)
    {
        if (isViewer) return;
        ApiResponse result;
        if (addVote)
        {
            result = await RetrospectiveService.VoteRetrospectiveItemAsync(itemId);
        }
        else
        {
            result = await RetrospectiveService.RemoveVoteAsync(itemId);
        }
        if (result.Success) await LoadData();
    }

    private async Task DeleteItem(Guid itemId)
    {
        if (isViewer) return;
        var ok = await DialogService.ConfirmAsync("Удалить этот элемент?", "Удаление", "Удалить", "danger");
        if (!ok) return;
        var r = await RetrospectiveService.DeleteRetrospectiveItemAsync(itemId);
        if (r.Success) await LoadData();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/sprints");
    }

    private class StringRef
    {
        private readonly Func<string> _getter;
        private readonly Action<string> _setter;

        public StringRef(Func<string> getter, Action<string> setter)
        {
            _getter = getter;
            _setter = setter;
        }

        public string Value
        {
            get => _getter();
            set => _setter(value);
        }
    }
}