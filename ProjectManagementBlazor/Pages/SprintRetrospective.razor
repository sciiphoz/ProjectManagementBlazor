@page "/retrospective/{SprintId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IRetrospectiveService RetrospectiveService
@inject ISprintService SprintService
@inject IAuthService AuthService
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DialogService DialogService
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@inject IJSRuntime JS

<PageTitle>Ретроспектива спринта</PageTitle>

<div class="retro-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (sprint != null)
    {
        <div class="retro-header">
            <div>
                <h2>Ретроспектива</h2>
                <span class="text-muted small">@sprint.Name · @sprint.StartDate.ToString("dd.MM") — @sprint.EndDate.ToString("dd.MM")</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ExportRetro">
                    <i class="bi bi-download me-1"></i> Экспорт
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i> К спринту
                </button>
            </div>
        </div>

        @if (!isEditable)
        {
            <div class="alert alert-info small py-2 mb-3">
                <i class="bi bi-info-circle me-1"></i> Ретроспектива доступна после завершения спринта.
            </div>
        }

        <div class="retro-grid">
            @* Liked *@
            <div class="retro-col">
                <div class="retro-col-header" style="background: #22c55e;">
                    <span><i class="bi bi-hand-thumbs-up me-1"></i>Что прошло хорошо</span>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="retro-col-badge">@(retrospective?.GoodItems?.Count ?? 0)</span>
                    </div>
                </div>
                <div class="retro-col-body">
                    @if (retrospective?.GoodItems?.Any() == true)
                    {
                        var top = retrospective.GoodItems.OrderByDescending(i => i.VoteCount).First();
                        @foreach (var item in retrospective.GoodItems.OrderByDescending(i => i.VoteCount))
                        {
                            var isTop = item.Id == top.Id && item.VoteCount > 0;
                            <div class="retro-card @(item.HasUserVoted ? "voted" : "") @(isTop ? "top" : "")">
                                @if (isTop)
                                {
                                    <span class="top-star">⭐</span>
                                }
                                <div class="retro-card-text">@item.Content</div>
                                <div class="retro-card-foot">
                                    <small>@item.CreatedBy.FullName</small>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (!isViewer && isEditable)
                                        {
                                            <button class="retro-vote @(item.HasUserVoted ? "active" : "")" @onclick="() => ToggleVote(item.Id, !item.HasUserVoted)">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="retro-vote-static @(item.HasUserVoted ? "active" : "")">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </span>
                                        }
                                        @if (!isViewer && isEditable && currentUserId == item.CreatedBy.Id)
                                        {
                                            <button class="btn btn-link text-danger p-0 ms-1" @onclick="() => DeleteItem(item.Id)"><i class="bi bi-x-circle small"></i></button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="retro-empty"><i class="bi bi-hand-thumbs-up fs-3 opacity-25"></i><span>Нет записей</span></div>
                    }
                    @if (!isViewer && isEditable)
                    {
                        <div class="retro-add">
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Ваша мысль..." @bind="newLikedItem"></textarea>
                            <button class="btn btn-sm w-100 mt-1 text-white" style="background: #22c55e;" @onclick='() => AddItem("Liked")' disabled="@(string.IsNullOrWhiteSpace(newLikedItem))">
                                <i class="bi bi-plus-lg me-1"></i> Добавить
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="retro-col">
                <div class="retro-col-header" style="background: #3b82f6;">
                    <span><i class="bi bi-book me-1"></i>Чему научились</span>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="retro-col-badge">@(retrospective?.Ideas?.Count ?? 0)</span>
                    </div>
                </div>
                <div class="retro-col-body">
                    @if (retrospective?.Ideas?.Any() == true)
                    {
                        var top = retrospective.Ideas.OrderByDescending(i => i.VoteCount).First();
                        @foreach (var item in retrospective.Ideas.OrderByDescending(i => i.VoteCount))
                        {
                            var isTop = item.Id == top.Id && item.VoteCount > 0;
                            <div class="retro-card @(item.HasUserVoted ? "voted" : "") @(isTop ? "top" : "")">
                                @if (isTop)
                                {
                                    <span class="top-star">⭐</span>
                                }
                                <div class="retro-card-text">@item.Content</div>
                                <div class="retro-card-foot">
                                    <small>@item.CreatedBy.FullName</small>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (!isViewer && isEditable)
                                        {
                                            <button class="retro-vote @(item.HasUserVoted ? "active" : "")" @onclick="() => ToggleVote(item.Id, !item.HasUserVoted)">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="retro-vote-static @(item.HasUserVoted ? "active" : "")">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </span>
                                        }
                                        @if (!isViewer && isEditable && currentUserId == item.CreatedBy.Id)
                                        {
                                            <button class="btn btn-link text-danger p-0 ms-1" @onclick="() => DeleteItem(item.Id)"><i class="bi bi-x-circle small"></i></button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="retro-empty"><i class="bi bi-book fs-3 opacity-25"></i><span>Нет записей</span></div>
                    }
                    @if (!isViewer && isEditable)
                    {
                        <div class="retro-add">
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Ваша мысль..." @bind="newLearnedItem"></textarea>
                            <button class="btn btn-sm w-100 mt-1 text-white" style="background: #3b82f6;" @onclick='() => AddItem("Learned")' disabled="@(string.IsNullOrWhiteSpace(newLearnedItem))">
                                <i class="bi bi-plus-lg me-1"></i> Добавить
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="retro-col">
                <div class="retro-col-header" style="background: #f59e0b;">
                    <span><i class="bi bi-exclamation-diamond me-1"></i>Чего не хватило</span>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="retro-col-badge">@(retrospective?.BadItems?.Count ?? 0)</span>
                    </div>
                </div>
                <div class="retro-col-body">
                    @if (retrospective?.BadItems?.Any() == true)
                    {
                        var top = retrospective.BadItems.OrderByDescending(i => i.VoteCount).First();
                        @foreach (var item in retrospective.BadItems.OrderByDescending(i => i.VoteCount))
                        {
                            var isTop = item.Id == top.Id && item.VoteCount > 0;
                            <div class="retro-card @(item.HasUserVoted ? "voted" : "") @(isTop ? "top" : "")">
                                @if (isTop)
                                {
                                    <span class="top-star">⭐</span>
                                }
                                <div class="retro-card-text">@item.Content</div>
                                <div class="retro-card-foot">
                                    <small>@item.CreatedBy.FullName</small>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (!isViewer && isEditable)
                                        {
                                            <button class="retro-vote @(item.HasUserVoted ? "active" : "")" @onclick="() => ToggleVote(item.Id, !item.HasUserVoted)">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="retro-vote-static @(item.HasUserVoted ? "active" : "")">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </span>
                                        }
                                        @if (!isViewer && isEditable && currentUserId == item.CreatedBy.Id)
                                        {
                                            <button class="btn btn-link text-danger p-0 ms-1" @onclick="() => DeleteItem(item.Id)"><i class="bi bi-x-circle small"></i></button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="retro-empty"><i class="bi bi-exclamation-diamond fs-3 opacity-25"></i><span>Нет записей</span></div>
                    }
                    @if (!isViewer && isEditable)
                    {
                        <div class="retro-add">
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Ваша мысль..." @bind="newLackedItem"></textarea>
                            <button class="btn btn-sm w-100 mt-1 text-white" style="background: #f59e0b;" @onclick='() => AddItem("Lacked")' disabled="@(string.IsNullOrWhiteSpace(newLackedItem))">
                                <i class="bi bi-plus-lg me-1"></i> Добавить
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="retro-col">
                <div class="retro-col-header" style="background: #ef4444;">
                    <span><i class="bi bi-rocket-takeoff me-1"></i>Действия</span>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="retro-col-badge">@(retrospective?.Actions?.Count ?? 0)</span>
                    </div>
                </div>
                <div class="retro-col-body">
                    @if (retrospective?.Actions?.Any() == true)
                    {
                        var top = retrospective.Actions.OrderByDescending(i => i.VoteCount).First();
                        @foreach (var item in retrospective.Actions.OrderByDescending(i => i.VoteCount))
                        {
                            var isTop = item.Id == top.Id && item.VoteCount > 0;
                            <div class="retro-card @(item.HasUserVoted ? "voted" : "") @(isTop ? "top" : "")">
                                @if (isTop)
                                {
                                    <span class="top-star">⭐</span>
                                }
                                <div class="retro-card-text">@item.Content</div>
                                <div class="retro-card-foot">
                                    <small>@item.CreatedBy.FullName</small>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (!isViewer && isEditable)
                                        {
                                            <button class="retro-vote @(item.HasUserVoted ? "active" : "")" @onclick="() => ToggleVote(item.Id, !item.HasUserVoted)">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="retro-vote-static @(item.HasUserVoted ? "active" : "")">
                                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.VoteCount
                                            </span>
                                        }
                                        @if (!isViewer && isEditable && currentUserId == item.CreatedBy.Id)
                                        {
                                            <button class="btn btn-link text-danger p-0 ms-1" @onclick="() => DeleteItem(item.Id)"><i class="bi bi-x-circle small"></i></button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="retro-empty"><i class="bi bi-rocket-takeoff fs-3 opacity-25"></i><span>Нет записей</span></div>
                    }
                    @if (!isViewer && isEditable)
                    {
                        <div class="retro-add">
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Ваша мысль..." @bind="newActionsItem"></textarea>
                            <button class="btn btn-sm w-100 mt-1 text-white" style="background: #ef4444;" @onclick='() => AddItem("Actions")' disabled="@(string.IsNullOrWhiteSpace(newActionsItem))">
                                <i class="bi bi-plus-lg me-1"></i> Добавить
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (retrospective != null)
        {
            var allItems = (retrospective.GoodItems ?? new())
            .Concat(retrospective.BadItems ?? new())
            .Concat(retrospective.Ideas ?? new())
            .Concat(retrospective.Actions ?? new())
            .OrderByDescending(i => i.VoteCount)
            .Take(4)
            .ToList();

            <div class="retro-summary">
                <div class="retro-summary-title"><i class="bi bi-trophy me-1"></i> Ключевые выводы</div>
                <div class="retro-summary-grid">
                    @foreach (var item in allItems)
                    {
                        var cat = item.Category switch { "Good" or "Liked" => ("Лучшее", "#22c55e"), "Bad" or "Lacked" => ("Не хватило", "#f59e0b"), "Idea" or "Learned" => ("Идея", "#3b82f6"), "Action" or "Actions" => ("Действие", "#ef4444"), _ => ("Прочее", "#6b7280") };
                        <div class="summary-card" style="border-left: 4px solid @cat.Item2;">
                            <span class="summary-label" style="color: @cat.Item2;">@cat.Item1</span>
                            <span class="summary-text">@item.Content</span>
                            <span class="summary-votes">🗳 @item.VoteCount</span>
                        </div>
                    }
                    @for (int i = allItems.Count; i < 4; i++)
                    {
                        <div class="summary-card empty">
                            <span class="summary-label text-muted">—</span>
                            <span class="summary-text text-muted">Добавьте больше пунктов</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <p>Спринт не найден</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">Назад</button>
        </div>
    }
</div>

<style>
    .retro-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .retro-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .retro-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .retro-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .retro-col {
        border-radius: 0.75rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: var(--bg-card, #fff);
        border: 1px solid var(--border-color, #E2E8F0);
    }

    .retro-col-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.55rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.02em;
    }

    .retro-col-badge {
        background: rgba(255,255,255,0.22);
        border-radius: 10px;
        padding: 0.1rem 0.5rem;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .retro-col-body {
        flex: 1;
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        max-height: 50vh;
        overflow-y: auto;
    }

    .retro-card {
        padding: 0.5rem 0.6rem;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.45rem;
        background: var(--bg-light, #F8F9FB);
        position: relative;
        transition: all 0.12s;
    }

        .retro-card:hover {
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        }

        .retro-card.voted {
            border-color: #818cf8;
            background: rgba(129,140,248,0.03);
        }

        .retro-card.top {
            border-color: #fbbf24;
        }

    .top-star {
        position: absolute;
        top: -7px;
        right: -5px;
        font-size: 1rem;
        line-height: 1;
    }

    .retro-card-text {
        font-size: 0.78rem;
        line-height: 1.35;
        margin-bottom: 0.4rem;
        word-break: break-word;
    }

    .retro-card-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.68rem;
        color: var(--text-secondary, #64748B);
    }

    .retro-vote, .retro-vote-static {
        font-size: 0.7rem;
        padding: 0.12rem 0.5rem;
        border-radius: 1rem;
        border: 1px solid var(--border-color, #E2E8F0);
        background: #fff;
        color: var(--text-secondary, #64748B);
        cursor: pointer;
        transition: all 0.12s;
    }

        .retro-vote:hover {
            background: #eff6ff;
            border-color: #818cf8;
        }

        .retro-vote.active, .retro-vote-static.active {
            background: #818cf8;
            color: #fff;
            border-color: #818cf8;
        }

    .retro-vote-static {
        cursor: default;
    }

    .retro-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem 0;
        color: var(--text-secondary, #94A3B8);
        font-size: 0.75rem;
        gap: 0.3rem;
    }

    .retro-add {
        margin-top: auto;
        padding-top: 0.4rem;
        border-top: 1px dashed var(--border-color, #E2E8F0);
    }

        .retro-add textarea {
            font-size: 0.75rem;
            resize: none;
        }

    .retro-summary {
        padding: 1rem 1.25rem;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.75rem;
        background: var(--bg-card, #fff);
    }

    .retro-summary-title {
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: var(--text-primary, #1E293B);
    }

    .retro-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.6rem;
    }

    .summary-card {
        padding: 0.6rem 0.7rem;
        border-radius: 0.5rem;
        background: var(--bg-light, #F8F9FB);
        border: 1px solid var(--border-color, #E2E8F0);
    }

        .summary-card.empty {
            border-left: 4px solid var(--border-color, #E2E8F0) !important;
        }

    .summary-label {
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        display: block;
        margin-bottom: 0.15rem;
    }

    .summary-text {
        font-size: 0.78rem;
        line-height: 1.3;
        display: block;
        margin-bottom: 0.2rem;
    }

    .summary-votes {
        font-size: 0.68rem;
        color: var(--text-secondary, #94A3B8);
    }

    [data-bs-theme="dark"] .retro-col, [data-bs-theme="dark"] .retro-summary {
        background: #1E293B;
        border-color: #334155;
    }

    [data-bs-theme="dark"] .retro-card, [data-bs-theme="dark"] .summary-card {
        background: #0F172A;
        border-color: #334155;
    }

        [data-bs-theme="dark"] .retro-card.top {
            border-color: #f59e0b;
        }

    [data-bs-theme="dark"] .retro-vote, [data-bs-theme="dark"] .retro-vote-static {
        background: #1E293B;
        border-color: #334155;
    }

        [data-bs-theme="dark"] .retro-vote:hover {
            background: #1E293B;
            border-color: #818cf8;
        }

        [data-bs-theme="dark"] .retro-vote.active, [data-bs-theme="dark"] .retro-vote-static.active {
            background: #6366f1;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .retro-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .retro-summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .retro-grid {
            grid-template-columns: 1fr;
        }

        .retro-summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Parameter] public Guid SprintId { get; set; }

    private SprintResponse? sprint;
    private RetrospectiveBoardResponse? retrospective;
    private HubConnection? _hubConnection;

    private Guid currentUserId;
    private bool isLoading = true;
    private bool isEditable = false;
    private bool isViewer = false;

    private string newLikedItem = "";
    private string newLearnedItem = "";
    private string newLackedItem = "";
    private string newActionsItem = "";

    private string GetTextField(string label) => label switch
    {
        "Liked" => newLikedItem,
        "Learned" => newLearnedItem,
        "Lacked" => newLackedItem,
        "Actions" => newActionsItem,
        _ => ""
    };

    private void SetTextField(string label, string value)
    {
        switch (label)
        {
            case "Liked": newLikedItem = value; break;
            case "Learned": newLearnedItem = value; break;
            case "Lacked": newLackedItem = value; break;
            case "Actions": newActionsItem = value; break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadData();
        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl("https://localhost:7254/hubs/comments")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<RetrospectiveItemResponse>("RetroItemAdded", (item) =>
        {
            if (retrospective == null) return;

            switch (item.Category)
            {
                case "Good":
                    retrospective.GoodItems ??= new();
                    if (!retrospective.GoodItems.Any(i => i.Id == item.Id))
                        retrospective.GoodItems.Add(item);
                    break;
                case "Bad":
                    retrospective.BadItems ??= new();
                    if (!retrospective.BadItems.Any(i => i.Id == item.Id))
                        retrospective.BadItems.Add(item);
                    break;
                case "Idea":
                    retrospective.Ideas ??= new();
                    if (!retrospective.Ideas.Any(i => i.Id == item.Id))
                        retrospective.Ideas.Add(item);
                    break;
                case "Action":
                    retrospective.Actions ??= new();
                    if (!retrospective.Actions.Any(i => i.Id == item.Id))
                        retrospective.Actions.Add(item);
                    break;
            }
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<RetrospectiveItemResponse>("RetroVoteUpdated", (item) =>
        {
            if (retrospective == null) return;
            ReplaceItem(retrospective.GoodItems, item);
            ReplaceItem(retrospective.BadItems, item);
            ReplaceItem(retrospective.Ideas, item);
            ReplaceItem(retrospective.Actions, item);
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<Guid>("RetroItemDeleted", (itemId) =>
        {
            if (retrospective == null) return;
            retrospective.GoodItems?.RemoveAll(i => i.Id == itemId);
            retrospective.BadItems?.RemoveAll(i => i.Id == itemId);
            retrospective.Ideas?.RemoveAll(i => i.Id == itemId);
            retrospective.Actions?.RemoveAll(i => i.Id == itemId);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
            if (_hubConnection.State == HubConnectionState.Connected)
                await _hubConnection.InvokeAsync("SubscribeToRetro", SprintId.ToString());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR retro: {ex.Message}");
        }
    }

    private void ReplaceItem(List<RetrospectiveItemResponse>? list, RetrospectiveItemResponse updated)
    {
        if (list == null) return;
        var idx = list.FindIndex(i => i.Id == updated.Id);
        if (idx >= 0) list[idx] = updated;
    }

    private async Task LoadCurrentUser()
    {
        try { var r = await AuthService.GetCurrentUserAsync(); if (r.Success && r.Data != null) currentUserId = r.Data.Id; } catch { }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var sr = await SprintService.GetSprintByIdAsync(SprintId);
            if (sr.Success && sr.Data != null)
            {
                sprint = sr.Data;
                isEditable = sprint.Status == "Completed";
                var mr = await ProjectService.GetProjectMembersAsync(sprint.ProjectId);
                if (mr.Success && mr.Data != null)
                {
                    var m = mr.Data.FirstOrDefault(x => x.UserId == currentUserId);
                    isViewer = m?.Role == "Viewer";
                }
            }
            var rr = await RetrospectiveService.GetRetrospectiveBoardAsync(SprintId);
            if (rr.Success && rr.Data != null) retrospective = rr.Data;
        }
        catch { }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task AddItem(string label)
    {
        if (isViewer || !isEditable) return;
        var content = GetTextField(label);
        if (string.IsNullOrWhiteSpace(content)) return;

        var apiCategory = label switch { "Liked" => "Good", "Learned" => "Idea", "Lacked" => "Bad", "Actions" => "Action", _ => label };

        var r = await RetrospectiveService.AddRetrospectiveItemAsync(SprintId, new AddRetrospectiveItemRequest { Category = apiCategory, Content = content });
        if (r.Success)
        {
            SetTextField(label, "");
            StateHasChanged();
            await LoadData();
        }
        else await DialogService.AlertAsync(r.Message ?? "Ошибка", "Ошибка", "", "danger");
    }

    private async Task ToggleVote(Guid id, bool add)
    {
        if (isViewer || !isEditable) return;
        var r = add ? await RetrospectiveService.VoteRetrospectiveItemAsync(id) : await RetrospectiveService.RemoveVoteAsync(id);
        if (r.Success) await LoadData();
    }

    private async Task DeleteItem(Guid id)
    {
        if (isViewer || !isEditable) return;
        if (!await DialogService.ConfirmAsync("Удалить элемент?", "Удаление", "Удалить", "danger")) return;
        var r = await RetrospectiveService.DeleteRetrospectiveItemAsync(id);
        if (r.Success) await LoadData();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.InvokeAsync("UnsubscribeFromRetro", SprintId.ToString());
            await _hubConnection.DisposeAsync();
        }
    }

    private async Task ExportRetro()
    {
        var text = $"РЕТРОСПЕКТИВА\nСпринт: {sprint?.Name}\n{sprint?.StartDate:dd.MM.yyyy} — {sprint?.EndDate:dd.MM.yyyy}\n\n" +
                   "=== Что прошло хорошо ===\n" + string.Join("\n", (retrospective?.GoodItems ?? new()).Select(i => $"• {i.Content} ({i.VoteCount}🗳)")) + "\n\n" +
                   "=== Чему научились ===\n" + string.Join("\n", (retrospective?.Ideas ?? new()).Select(i => $"• {i.Content} ({i.VoteCount}🗳)")) + "\n\n" +
                   "=== Чего не хватило ===\n" + string.Join("\n", (retrospective?.BadItems ?? new()).Select(i => $"• {i.Content} ({i.VoteCount}🗳)")) + "\n\n" +
                   "=== Действия ===\n" + string.Join("\n", (retrospective?.Actions ?? new()).Select(i => $"• {i.Content} ({i.VoteCount}🗳)"));
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await DialogService.AlertAsync("Скопировано в буфер обмена", "Экспорт", "", "success");
    }

    private void GoBack() => Navigation.NavigateTo($"/sprints/{SprintId}");
}