@page "/daily-scrum"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISprintService SprintService
@inject IJSRuntime JS

<PageTitle>Daily Scrum</PageTitle>

<div class="container-fluid mt-3">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка данных...</p>
        </div>
    }
    else if (currentUser != null && currentUser.Role != "Developer")
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Ежедневная встреча (Daily Scrum)</h2>
                <p class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</p>
            </div>
            <div>
                <button class="btn btn-outline-primary me-2" @onclick="RefreshData">
                    🔄 Обновить
                </button>
                <button class="btn btn-primary" @onclick="ExportToExcel">
                    📊 Экспорт в Excel
                </button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Выберите проект</label>
                        <select value="@selectedProjectId" class="form-select" @onchange="OnProjectChanged">
                            <option value="">-- Выберите проект --</option>
                            @foreach (var project in myProjects)
                            {
                                <option value="@project.Id">@project.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Активный спринт</label>
                        <input type="text" class="form-control" value="@activeSprintName" disabled />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-info w-100" @onclick="CopyToClipboard" disabled="@(selectedProjectId == Guid.Empty)">
                            📋 Копировать сводку
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (selectedProjectId != Guid.Empty && dailyScrum != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📊 Прогресс спринта</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="text-center">
                                <h5>Выполнено задач</h5>
                                <h3>@dailyScrum.SprintProgress.CompletedTasks / @dailyScrum.SprintProgress.TotalTasks</h3>
                                <div class="progress">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width: @dailyScrum.SprintProgress.CompletionPercentage%">
                                        @((int)dailyScrum.SprintProgress.CompletionPercentage)%
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <h5>В работе</h5>
                                <h3>@dailyScrum.SprintProgress.InProgressTasks</h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <h5>Осталось дней</h5>
                                <h3>@dailyScrum.SprintProgress.DaysRemaining</h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <h5>Спринт</h5>
                                <h6>@dailyScrum.SprintProgress.SprintName</h6>
                                <small>@dailyScrum.SprintProgress.StartDate.ToString("dd.MM") - @dailyScrum.SprintProgress.EndDate.ToString("dd.MM")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (dailyScrum.TeamBlockers != null && dailyScrum.TeamBlockers.Any())
            {
                <div class="card mb-4 border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">⚠️ Командные блокеры (@dailyScrum.TeamBlockers.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var blocker in dailyScrum.TeamBlockers)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="alert alert-danger mb-0">
                                        <strong>@blocker.Description</strong>
                                        <br />
                                        <small>Серьезность: @blocker.Severity | Создан: @blocker.CreatedAt.ToString("dd.MM HH:mm")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">👥 Участники команды</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="dailyScrumTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%">Участник</th>
                                    <th style="width: 28%">Что делал вчера?</th>
                                    <th style="width: 28%">Что будет делать сегодня?</th>
                                    <th style="width: 15%">Блокеры</th>
                                    <th style="width: 14%">Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in dailyScrum.TeamMembers)
                                {
                                    <tr class="@(!member.IsAvailable ? "table-secondary" : "")">
                                        <td>
                                            <strong>@member.User.FullName</strong>
                                            <br />
                                            <small class="text-muted">@member.User.Role</small>
                                        </td>
                                        <td>
                                            @if (member.WorkedYesterday != null && member.WorkedYesterday.Any())
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var task in member.WorkedYesterday)
                                                    {
                                                        <li>@task.Title <small class="text-muted">(@task.ProjectName)</small></li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (member.PlanForToday != null && member.PlanForToday.Any())
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var task in member.PlanForToday)
                                                    {
                                                        <li>@task.Title <small class="text-muted">(@task.ProjectName)</small></li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (member.Blockers != null && member.Blockers.Any())
                                            {
                                                @foreach (var blocker in member.Blockers)
                                                {
                                                    <span class="badge bg-danger mb-1 d-block">@blocker.Description</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Нет</span>
                                            }
                                        </td>
                                        <td>
                                            @if (member.IsAvailable)
                                            {
                                                <span class="badge bg-success">Доступен</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Отсутствует</span>
                                            }
                                            @if (!string.IsNullOrEmpty(member.StatusNote))
                                            {
                                                <br />
                                                <small class="text-muted">@member.StatusNote</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-4">
                <strong>📌 Как использовать страницу для Daily Scrum:</strong>
                <ol class="mb-0 mt-2">
                    <li>Участники команды заранее заполняют свой дашборд <strong>"Мой день"</strong></li>
                    <li>Scrum-мастер открывает эту страницу и выводит на экран</li>
                    <li>
                        Каждый участник по очереди отвечает на три вопроса:
                        <ul>
                            <li>Что сделал вчера?</li>
                            <li>Что планирует сделать сегодня?</li>
                            <li>Есть ли блокеры?</li>
                        </ul>
                    </li>
                    <li>Scrum-мастер фиксирует блокеры и помогает их решить</li>
                    <li>После встречи можно скопировать сводку или экспортировать в Excel</li>
                </ol>
            </div>
        }
        else if (selectedProjectId == Guid.Empty && myProjects.Any())
        {
            <div class="alert alert-info text-center">
                <h5>Выберите проект для просмотра Daily Scrum</h5>
            </div>
        }
        else if (!myProjects.Any())
        {
            <div class="alert alert-warning text-center">
                <h5>У вас нет проектов</h5>
                <p>Создайте проект, чтобы начать работу</p>
                <button class="btn btn-primary" @onclick="GoToProjects">Создать проект</button>
            </div>
        }
    }
    else if (currentUser != null && currentUser.Role == "Developer")
    {
        <div class="alert alert-warning text-center">
            <h5>⛔ Доступ ограничен</h5>
            <p>Эта страница доступна только для Scrum Master и Product Owner</p>
            <button class="btn btn-primary" @onclick="GoToDashboard">Перейти к "Мой день"</button>
        </div>
    }
</div>

<style>
    .table th, .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.3rem 0.6rem;
    }

    .alert ul {
        padding-left: 20px;
    }
</style>

@code {
    private List<ProjectResponse> myProjects = new();
    private DailyScrumResponse? dailyScrum;
    private UserResponse? currentUser;
    private Guid selectedProjectId = Guid.Empty;
    private string activeSprintName = "Нет активного спринта";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        if (currentUser != null && currentUser.Role != "Developer")
        {
            await LoadProjects();
        }
        isLoading = false;
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var result = await AuthService.GetCurrentUserAsync();
            if (result.Success && result.Data != null)
            {
                currentUser = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки пользователя: {ex.Message}");
        }
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        try
        {
            var result = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 50 });
            if (result.Success && result.Data != null)
            {
                myProjects = result.Data.Items;

                if (myProjects.Any())
                {
                    selectedProjectId = myProjects.First().Id;
                    await LoadSprints();
                    await LoadDailyScrum();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки проектов: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSprints()
    {
        try
        {
            var result = await SprintService.GetProjectSprintsAsync(selectedProjectId);
            if (result.Success && result.Data != null)
            {
                var activeSprint = result.Data.FirstOrDefault(s => s.IsActive);
                activeSprintName = activeSprint != null ? activeSprint.Name : "Нет активного спринта";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки спринтов: {ex.Message}");
        }
    }

    private async Task LoadDailyScrum()
    {
        try
        {
            var sprintsResult = await SprintService.GetProjectSprintsAsync(selectedProjectId);
            var activeSprint = sprintsResult.Data?.FirstOrDefault(s => s.IsActive);
            var result = await DashboardService.GetDailyScrumViewAsync(selectedProjectId, activeSprint?.Id);
            if (result.Success && result.Data != null)
            {
                dailyScrum = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки Daily Scrum: {ex.Message}");
        }
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        if (e.Value != null && Guid.TryParse(e.Value.ToString(), out var projectId))
        {
            selectedProjectId = projectId;
            await LoadSprints();
            await LoadDailyScrum();
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadSprints();
        await LoadDailyScrum();
        StateHasChanged();
    }

    private async Task CopyToClipboard()
    {
        try
        {
            // Формируем текст для копирования
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Daily Scrum - {DateTime.Now:dd.MM.yyyy HH:mm}");
            sb.AppendLine($"Проект: {myProjects.FirstOrDefault(p => p.Id == selectedProjectId)?.Name}");
            sb.AppendLine($"Спринт: {activeSprintName}");
            sb.AppendLine();
            sb.AppendLine("=== Прогресс спринта ===");
            sb.AppendLine($"Выполнено задач: {dailyScrum?.SprintProgress.CompletedTasks}/{dailyScrum?.SprintProgress.TotalTasks}");
            sb.AppendLine($"Осталось дней: {dailyScrum?.SprintProgress.DaysRemaining}");
            sb.AppendLine();
            sb.AppendLine("=== Команда ===");

            foreach (var member in dailyScrum?.TeamMembers ?? new List<TeamMemberDailyStatus>())
            {
                sb.AppendLine();
                sb.AppendLine($"👤 {member.User.FullName} ({member.User.Role})");
                sb.AppendLine($"  Вчера: {string.Join(", ", member.WorkedYesterday?.Select(t => t.Title) ?? new List<string>())}");
                sb.AppendLine($"  Сегодня: {string.Join(", ", member.PlanForToday?.Select(t => t.Title) ?? new List<string>())}");
                sb.AppendLine($"  Блокеры: {string.Join(", ", member.Blockers?.Select(b => b.Description) ?? new List<string>())}");
            }

            sb.AppendLine();
            sb.AppendLine("=== Блокеры команды ===");
            foreach (var blocker in dailyScrum?.TeamBlockers ?? new List<BlockerResponse>())
            {
                sb.AppendLine($"- {blocker.Description} ({blocker.Severity})");
            }

            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            await JS.InvokeVoidAsync("alert", "Сводка скопирована в буфер обмена");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка копирования: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Ошибка при копировании");
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            await JS.InvokeVoidAsync("alert", "Экспорт в Excel выполнен");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка экспорта: {ex.Message}");
        }
    }

    private void GoToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private void GoToDashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }
}