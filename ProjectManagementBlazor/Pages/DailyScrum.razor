@page "/projects/{ProjectId:guid}/daily-scrum"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject ISprintService SprintService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Daily Scrum</PageTitle>

<div class="container-fluid mt-3">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка данных...</p>
        </div>
    }
    else if (!isAuthorized)
    {
        <div class="alert alert-warning text-center">
            <h5>⛔ Доступ ограничен</h5>
            <p>Страница Daily Scrum доступна только для Scrum Master и Product Owner.</p>
            <button class="btn btn-primary" @onclick="GoBack">
                ← Вернуться к проекту
            </button>
        </div>
    }
    else if (project == null)
    {
        <div class="alert alert-warning text-center">
            <h5>Проект не найден</h5>
            <button class="btn btn-primary" @onclick="GoBack">
                ← Вернуться назад
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>📅 Ежедневная встреча (Daily Scrum)</h2>
                <p class="text-muted">
                    Проект: <strong>@project.Name</strong> |
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))
                </p>
            </div>
            <div>
                <button class="btn btn-outline-primary me-2" @onclick="RefreshData">
                    🔄 Обновить
                </button>
                <button class="btn btn-outline-info me-2" @onclick="CopyToClipboard"
                        disabled="@(dailyScrum == null)">
                    📋 Копировать сводку
                </button>
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    ← К проекту
                </button>
            </div>
        </div>

        @if (activeSprint == null)
        {
            <div class="alert alert-warning text-center">
                <h5>Нет активного спринта</h5>
                <p>Для просмотра Daily Scrum запустите спринт.</p>
            </div>
        }
        else if (dailyScrum != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📊 Прогресс спринта: @activeSprint.Name</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <h6>Выполнено задач</h6>
                            <h3>@dailyScrum.SprintProgress.CompletedTasks / @dailyScrum.SprintProgress.TotalTasks</h3>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @dailyScrum.SprintProgress.CompletionPercentage%">
                                    @((int)dailyScrum.SprintProgress.CompletionPercentage)%
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <h6>В работе</h6>
                            <h3>@dailyScrum.SprintProgress.InProgressTasks</h3>
                        </div>
                        <div class="col-md-3 mb-3">
                            <h6>Осталось дней</h6>
                            <h3>@dailyScrum.SprintProgress.DaysRemaining</h3>
                        </div>
                        <div class="col-md-3 mb-3">
                            <h6>Даты спринта</h6>
                            <p class="mb-0">
                                @dailyScrum.SprintProgress.StartDate.ToString("dd.MM") -
                                @dailyScrum.SprintProgress.EndDate.ToString("dd.MM")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @if (dailyScrum.TeamBlockers != null && dailyScrum.TeamBlockers.Any())
            {
                <div class="card mb-4 border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">⚠️ Командные блокеры (@dailyScrum.TeamBlockers.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var blocker in dailyScrum.TeamBlockers)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="alert alert-danger mb-0">
                                        <strong>@blocker.Description</strong>
                                        <br />
                                        <small>Серьезность: @blocker.Severity | @blocker.CreatedAt.ToString("dd.MM HH:mm")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Таблица участников -->
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">👥 Участники команды</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%">Участник</th>
                                    <th style="width: 28%">Что делал вчера?</th>
                                    <th style="width: 28%">Что будет делать сегодня?</th>
                                    <th style="width: 15%">Блокеры</th>
                                    <th style="width: 14%">Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in dailyScrum.TeamMembers)
                                {
                                    <tr class="@(member.IsAvailable ? "" : "table-secondary")">
                                        <td>
                                            <strong>@member.User.FullName</strong>
                                            <br />
                                            <small class="text-muted">@member.User.Role</small>
                                        </td>
                                        <td>
                                            @if (member.WorkedYesterday?.Any() == true)
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var task in member.WorkedYesterday)
                                                    {
                                                        <li>@task.Title</li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (member.PlanForToday?.Any() == true)
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var task in member.PlanForToday)
                                                    {
                                                        <li>@task.Title</li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (member.Blockers?.Any() == true)
                                            {
                                                @foreach (var blocker in member.Blockers)
                                                {
                                                    <span class="badge bg-danger mb-1 d-block">@blocker.Description</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Нет</span>
                                            }
                                        </td>
                                        <td>
                                            @if (member.IsAvailable)
                                            {
                                                <span class="badge bg-success">Доступен</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Отсутствует</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Инструкция -->
            <div class="alert alert-info mt-4">
                <strong>📌 Как провести Daily Scrum:</strong>
                <ol class="mb-0 mt-2">
                    <li>Каждый участник заполняет свой дашборд <strong>"Мой день"</strong></li>
                    <li>Выводите эту страницу на общий экран</li>
                    <li>Участники по очереди отвечают на 3 вопроса</li>
                    <li>Фиксируйте блокеры и помогайте их решать</li>
                    <li>Используйте кнопку «📋 Копировать сводку» для отчёта</li>
                </ol>
            </div>
        }
    }
</div>

<style>
    .table th, .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.3rem 0.6rem;
    }

    .progress {
        background-color: #e9ecef;
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private SprintBriefResponse? activeSprint;
    private DailyScrumResponse? dailyScrum;
    private UserResponse? currentUser;
    private bool isLoading = true;
    private bool isAuthorized = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Загружаем проект
            var projectResult = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (projectResult.Success && projectResult.Data != null)
            {
                project = projectResult.Data;
            }
            else
            {
                isLoading = false;
                return;
            }

            // Загружаем текущего пользователя
            var userResult = await AuthService.GetCurrentUserAsync();
            if (userResult.Success && userResult.Data != null)
            {
                currentUser = userResult.Data;

                // Проверяем роль в проекте (ScrumMaster или ProductOwner)
                var membersResult = await ProjectService.GetProjectMembersAsync(ProjectId);
                if (membersResult.Success && membersResult.Data != null)
                {
                    var currentMember = membersResult.Data
                        .FirstOrDefault(m => m.UserId == currentUser.Id);

                    if (currentMember != null)
                    {
                        var role = currentMember.Role ?? "";
                        isAuthorized = role == "ScrumMaster" || role == "ProductOwner";
                    }
                }
            }

            if (isAuthorized)
            {
                // Загружаем активный спринт
                var sprintsResult = await SprintService.GetProjectSprintsAsync(ProjectId);
                if (sprintsResult.Success && sprintsResult.Data != null)
                {
                    activeSprint = sprintsResult.Data.FirstOrDefault(s => s.IsActive);
                }

                // Загружаем данные Daily Scrum
                var dashboardResult = await DashboardService.GetDailyScrumViewAsync(
                    ProjectId,
                    activeSprint?.Id);
                if (dashboardResult.Success && dashboardResult.Data != null)
                {
                    dailyScrum = dashboardResult.Data;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var sprintsResult = await SprintService.GetProjectSprintsAsync(ProjectId);
            if (sprintsResult.Success && sprintsResult.Data != null)
            {
                activeSprint = sprintsResult.Data.FirstOrDefault(s => s.IsActive);
            }

            if (activeSprint != null)
            {
                var result = await DashboardService.GetDailyScrumViewAsync(
                    ProjectId,
                    activeSprint.Id);
                if (result.Success && result.Data != null)
                {
                    dailyScrum = result.Data;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка обновления: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopyToClipboard()
    {
        if (dailyScrum == null) return;

        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Daily Scrum — {DateTime.Now:dd.MM.yyyy HH:mm}");
            sb.AppendLine($"Проект: {project?.Name}");
            sb.AppendLine($"Спринт: {activeSprint?.Name}");
            sb.AppendLine();

            sb.AppendLine("=== Прогресс спринта ===");
            sb.AppendLine($"Выполнено: {dailyScrum.SprintProgress.CompletedTasks}/{dailyScrum.SprintProgress.TotalTasks} задач");
            sb.AppendLine($"В работе: {dailyScrum.SprintProgress.InProgressTasks}");
            sb.AppendLine($"Осталось дней: {dailyScrum.SprintProgress.DaysRemaining}");
            sb.AppendLine();

            sb.AppendLine("=== Команда ===");
            foreach (var member in dailyScrum.TeamMembers)
            {
                sb.AppendLine();
                sb.AppendLine($"👤 {member.User.FullName} ({member.User.Role})");
                sb.AppendLine($"   Вчера: {string.Join(", ", member.WorkedYesterday?.Select(t => t.Title) ?? new[] { "—" })}");
                sb.AppendLine($"   Сегодня: {string.Join(", ", member.PlanForToday?.Select(t => t.Title) ?? new[] { "—" })}");
                sb.AppendLine($"   Блокеры: {string.Join(", ", member.Blockers?.Select(b => b.Description) ?? new[] { "Нет" })}");
            }

            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            await JS.InvokeVoidAsync("alert", "Сводка скопирована в буфер обмена");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка копирования: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}");
    }
}