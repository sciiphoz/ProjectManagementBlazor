@page "/projects/{ProjectId:guid}/daily-scrum"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject ISprintService SprintService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DialogService DialogService

<PageTitle>Daily Scrum</PageTitle>

<div class="daily-scrum-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (!isAuthorized)
    {
        <div class="text-center py-4">
            <i class="bi bi-shield-lock fs-1 text-muted opacity-50"></i>
            <h5 class="mt-3">Доступ ограничен</h5>
            <p class="text-muted small">Страница доступна только для Scrum Master и Product Owner</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i> К проекту
            </button>
        </div>
    }
    else if (project == null)
    {
        <div class="text-center py-4">
            <p class="text-muted">Проект не найден</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">Назад</button>
        </div>
    }
    else
    {
        <div class="dsc-header">
            <div>
                <h2>Daily Scrum</h2>
                <span class="text-muted small">@project.Name · @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshData">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
                <button class="btn btn-outline-info btn-sm" @onclick="CopyToClipboard" disabled="@(dailyScrum == null)">
                    <i class="bi bi-clipboard me-1"></i> Копировать
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i> К проекту
                </button>
            </div>
        </div>

        @if (activeSprint == null)
        {
            <div class="text-center py-4 text-muted small">
                <i class="bi bi-rocket-takeoff fs-1 opacity-25"></i>
                <p class="mt-2">Нет активного спринта</p>
            </div>
        }
        else if (dailyScrum != null)
        {
            <div class="dsc-card">
                <div class="dsc-card-header">
                    <span>Прогресс спринта</span>
                    <span class="text-muted small">@activeSprint.Name</span>
                </div>
                <div class="dsc-metrics">
                    <div class="dsc-metric">
                        <span class="dsc-metric-value">@dailyScrum.SprintProgress.CompletedTasks / @dailyScrum.SprintProgress.TotalTasks</span>
                        <span class="dsc-metric-label">Выполнено задач</span>
                        <div class="progress mt-1" style="height:4px">
                            <div class="progress-bar bg-success" style="width:@dailyScrum.SprintProgress.CompletionPercentage%"></div>
                        </div>
                    </div>
                    <div class="dsc-metric">
                        <span class="dsc-metric-value">@dailyScrum.SprintProgress.InProgressTasks</span>
                        <span class="dsc-metric-label">В работе</span>
                    </div>
                    <div class="dsc-metric">
                        <span class="dsc-metric-value">@dailyScrum.SprintProgress.DaysRemaining</span>
                        <span class="dsc-metric-label">Осталось дней</span>
                    </div>
                    <div class="dsc-metric">
                        <span class="dsc-metric-value">@dailyScrum.SprintProgress.StartDate.ToString("dd.MM") — @dailyScrum.SprintProgress.EndDate.ToString("dd.MM")</span>
                        <span class="dsc-metric-label">Даты</span>
                    </div>
                </div>
            </div>

            @if (dailyScrum.TeamBlockers?.Any() == true)
            {
                <div class="dsc-card border-danger">
                    <div class="dsc-card-header text-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i> Командные блокеры · @dailyScrum.TeamBlockers.Count
                    </div>
                    <div class="dsc-card-body">
                        @foreach (var blocker in dailyScrum.TeamBlockers)
                        {
                            <div class="dsc-blocker">
                                <span>@blocker.Description</span>
                                <span class="badge @GetSeverityBadge(blocker.Severity)">@blocker.Severity</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="dsc-card">
                <div class="dsc-card-header">Участники команды</div>
                <div class="dsc-table">
                    @foreach (var member in dailyScrum.TeamMembers)
                    {
                        <div class="dsc-row @(member.IsAvailable ? "" : "absent")">
                            <div class="dsc-row-user">
                                <strong>@member.User.FullName</strong>
                                <span class="text-muted small">@member.User.Role</span>
                            </div>
                            <div class="dsc-row-col">
                                <span class="dsc-row-label">Вчера</span>
                                @if (member.WorkedYesterday?.Any() == true)
                                {
                                    <ul class="mb-0">
                                        @foreach (var t in member.WorkedYesterday)
                                        {
                                            <li>@t.Title</li>
                                        }
                                    </ul>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </div>
                            <div class="dsc-row-col">
                                <span class="dsc-row-label">Сегодня</span>
                                @if (member.PlanForToday?.Any() == true)
                                {
                                    <ul class="mb-0">
                                        @foreach (var t in member.PlanForToday)
                                        {
                                            <li>@t.Title</li>
                                        }
                                    </ul>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </div>
                            <div class="dsc-row-col">
                                <span class="dsc-row-label">Блокеры</span>
                                @if (member.Blockers?.Any() == true)
                                {
                                    @foreach (var b in member.Blockers)
                                    {
                                        <span class="badge bg-danger d-block mb-1">@b.Description</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-success">Нет</span>
                                }
                            </div>
                            <div class="dsc-row-status">
                                @if (member.IsAvailable)
                                {
                                    <span class="badge bg-success">Доступен</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Отсутствует</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .daily-scrum-page {
        max-width: 800px;
        margin: 0 auto;
    }

    .dsc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .dsc-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .dsc-card {
        border: 1px solid var(--border-color,#E2E8F0);
        border-radius: 0.5rem;
        margin-bottom: 0.75rem;
        overflow: hidden;
    }

        .dsc-card.border-danger {
            border-color: #EF4444;
        }

    .dsc-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0.75rem;
        background: var(--bg-light,#F8F9FB);
        border-bottom: 1px solid var(--border-color,#E2E8F0);
        font-weight: 600;
        font-size: 0.8rem;
    }

    .dsc-card-body {
        padding: 0.5rem 0.75rem;
    }

    .dsc-metrics {
        display: flex;
        gap: 0;
        padding: 0.5rem 0.75rem;
    }

    .dsc-metric {
        flex: 1;
        text-align: center;
    }

    .dsc-metric-value {
        font-size: 1.1rem;
        font-weight: 700;
        display: block;
    }

    .dsc-metric-label {
        font-size: 0.65rem;
        color: var(--text-secondary);
    }

    .dsc-blocker {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.375rem 0;
        border-bottom: 1px solid var(--border-color,#E2E8F0);
        font-size: 0.8rem;
    }

        .dsc-blocker:last-child {
            border-bottom: none;
        }

    .dsc-table {
    }

    .dsc-row {
        display: flex;
        align-items: flex-start;
        gap: 0;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border-color,#E2E8F0);
        font-size: 0.8rem;
    }

        .dsc-row:last-child {
            border-bottom: none;
        }

        .dsc-row.absent {
            opacity: 0.5;
            background: var(--bg-light,#F8F9FB);
        }

    .dsc-row-user {
        width: 15%;
        flex-shrink: 0;
    }

    .dsc-row-col {
        width: 25%;
        padding: 0 0.5rem;
    }

        .dsc-row-col ul {
            padding-left: 1rem;
        }

    .dsc-row-label {
        display: none;
        font-size: 0.6rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        margin-bottom: 0.125rem;
    }

    .dsc-row-status {
        width: 10%;
        text-align: center;
    }

    @@media (max-width: 768px) {
        .dsc-row {
            flex-direction: column;
            gap: 0.25rem;
        }

        .dsc-row-user {
            width: 100%;
        }

        .dsc-row-col {
            width: 100%;
            padding: 0;
        }

        .dsc-row-status {
            width: 100%;
            text-align: left;
        }

        .dsc-row-label {
            display: block;
        }
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private SprintBriefResponse? activeSprint;
    private DailyScrumResponse? dailyScrum;
    private UserResponse? currentUser;
    private bool isLoading = true;
    private bool isAuthorized = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var projectResult = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (projectResult.Success && projectResult.Data != null)
            {
                project = projectResult.Data;
            }
            else
            {
                isLoading = false;
                return;
            }

            var userResult = await AuthService.GetCurrentUserAsync();
            if (userResult.Success && userResult.Data != null)
            {
                currentUser = userResult.Data;
                var membersResult = await ProjectService.GetProjectMembersAsync(ProjectId);
                if (membersResult.Success && membersResult.Data != null)
                {
                    var currentMember = membersResult.Data.FirstOrDefault(m => m.UserId == currentUser.Id);
                    if (currentMember != null)
                    {
                        isAuthorized = currentMember.Role is "ScrumMaster" or "ProductOwner";
                    }
                }
            }

            if (isAuthorized)
            {
                var sprintsResult = await SprintService.GetProjectSprintsAsync(ProjectId);
                if (sprintsResult.Success && sprintsResult.Data != null)
                {
                    activeSprint = sprintsResult.Data.FirstOrDefault(s => s.IsActive);
                }

                var dashboardResult = await DashboardService.GetDailyScrumViewAsync(ProjectId, activeSprint?.Id);
                if (dashboardResult.Success && dashboardResult.Data != null)
                {
                    dailyScrum = dashboardResult.Data;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var sprintsResult = await SprintService.GetProjectSprintsAsync(ProjectId);
            if (sprintsResult.Success && sprintsResult.Data != null)
            {
                activeSprint = sprintsResult.Data.FirstOrDefault(s => s.IsActive);
            }
            if (activeSprint != null)
            {
                var result = await DashboardService.GetDailyScrumViewAsync(ProjectId, activeSprint.Id);
                if (result.Success && result.Data != null)
                {
                    dailyScrum = result.Data;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка обновления: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopyToClipboard()
    {
        if (dailyScrum == null) return;
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Daily Scrum — {DateTime.Now:dd.MM.yyyy HH:mm}");
            sb.AppendLine($"Проект: {project?.Name}");
            sb.AppendLine($"Спринт: {activeSprint?.Name}");
            sb.AppendLine();
            sb.AppendLine($"Прогресс: {dailyScrum.SprintProgress.CompletedTasks}/{dailyScrum.SprintProgress.TotalTasks} задач, {dailyScrum.SprintProgress.InProgressTasks} в работе, {dailyScrum.SprintProgress.DaysRemaining} дн.");
            sb.AppendLine();
            sb.AppendLine("Команда:");
            foreach (var member in dailyScrum.TeamMembers)
            {
                sb.AppendLine();
                sb.AppendLine($"{member.User.FullName} ({member.User.Role})");
                sb.AppendLine($"  Вчера: {string.Join(", ", member.WorkedYesterday?.Select(t => t.Title) ?? new[] { "—" })}");
                sb.AppendLine($"  Сегодня: {string.Join(", ", member.PlanForToday?.Select(t => t.Title) ?? new[] { "—" })}");
                sb.AppendLine($"  Блокеры: {string.Join(", ", member.Blockers?.Select(b => b.Description) ?? new[] { "Нет" })}");
            }

            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            await DialogService.AlertAsync("Сводка скопирована в буфер обмена", "", "bi bi-clipboard-check", "success");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка копирования: {ex.Message}");
        }
    }

    private string GetSeverityBadge(string s)
    {
        return s switch
        {
            "Critical" => "bg-danger",
            "High" => "bg-warning text-dark",
            _ => "bg-info"
        };
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}");
    }
}
