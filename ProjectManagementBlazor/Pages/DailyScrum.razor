@page "/projects/{ProjectId:guid}/daily-scrum"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject ISprintService SprintService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DialogService DialogService

<PageTitle>Daily Scrum</PageTitle>

<div class="daily-scrum-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (!isAuthorized)
    {
        <div class="text-center py-4">
            <i class="bi bi-shield-lock fs-1 text-muted opacity-50"></i>
            <h5 class="mt-3">Доступ ограничен</h5>
            <p class="text-muted small">Страница доступна только для Scrum Master и Product Owner</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i> К проекту
            </button>
        </div>
    }
    else if (project == null)
    {
        <div class="text-center py-4">
            <p class="text-muted">Проект не найден</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">Назад</button>
        </div>
    }
    else
    {
        <div class="dsc-header">
            <div>
                <h2>Daily Scrum</h2>
                <span class="text-muted small">@project.Name · @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshData">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
                <button class="btn btn-outline-info btn-sm" @onclick="CopyToClipboard">
                    <i class="bi bi-clipboard me-1"></i> Копировать
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i> К проекту
                </button>
            </div>
        </div>

        @if (activeSprint == null)
        {
            <div class="text-center py-4 text-muted small">
                <i class="bi bi-rocket-takeoff fs-1 opacity-25"></i>
                <p class="mt-2">Нет активного спринта</p>
            </div>
        }
        else
        {
            <div class="dsc-summary">
                <div class="dsc-summary-item">
                    <span class="dsc-summary-value">@activeSprint.Name</span>
                    <span class="dsc-summary-label">Активный спринт</span>
                </div>
                <div class="dsc-summary-item">
                    <span class="dsc-summary-value">@sprintProgress.completed / @sprintProgress.total</span>
                    <span class="dsc-summary-label">Задач выполнено</span>
                    <div class="progress mt-1" style="height:4px">
                        <div class="progress-bar bg-success" style="width:@sprintProgress.percent%"></div>
                    </div>
                </div>
                <div class="dsc-summary-item">
                    <span class="dsc-summary-value">@sprintProgress.daysLeft дн.</span>
                    <span class="dsc-summary-label">Осталось</span>
                </div>
                <div class="dsc-summary-item">
                    <span class="dsc-summary-value">@developers.Sum(d => d.totalSP) / @sprintProgress.totalSP SP</span>
                    <span class="dsc-summary-label">Story Points</span>
                </div>
            </div>

            @if (teamBlockers.Any())
            {
                <div class="dsc-card border-danger mb-3">
                    <div class="dsc-card-header text-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i> Командные блокеры · @teamBlockers.Count
                    </div>
                    <div class="dsc-card-body">
                        @foreach (var b in teamBlockers)
                        {
                            <div class="dsc-blocker">
                                <span>@b.description</span>
                                <span class="badge @GetSeverityBadge(b.severity)">@b.severity</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="dsc-devs">
                @foreach (var dev in developers)
                {
                    <div class="dsc-dev-card @(dev.isOverloaded ? "overloaded" : "")">
                        <div class="dsc-dev-header">
                            <div class="dsc-dev-avatar">@GetInitials(dev.fullName)</div>
                            <div>
                                <strong>@dev.fullName</strong>
                                <span class="text-muted small d-block">@dev.role</span>
                            </div>
                            @if (dev.isOverloaded)
                            {
                                <span class="badge bg-danger ms-auto" title="Более 2 задач в работе">⚠ Перегруз</span>
                            }
                        </div>

                        <div class="dsc-dev-stats">
                            <div class="dsc-dev-stat">
                                <span class="stat-value">@dev.totalTasks</span>
                                <span class="stat-label">Задач</span>
                            </div>
                            <div class="dsc-dev-stat">
                                <span class="stat-value">@dev.totalSP</span>
                                <span class="stat-label">SP</span>
                            </div>
                            <div class="dsc-dev-stat">
                                <span class="stat-value">@dev.totalHours.ToString("F0") ч.</span>
                                <span class="stat-label">Оценка</span>
                            </div>
                            <div class="dsc-dev-stat">
                                <span class="stat-value">@dev.completedPercent.ToString("F0")%</span>
                                <span class="stat-label">Прогресс</span>
                            </div>
                        </div>

                        <div class="dsc-dev-progress">
                            <div class="progress" style="height:6px">
                                <div class="progress-bar @(dev.completedPercent >= 80 ? "bg-success" : dev.completedPercent >= 40 ? "bg-warning" : "bg-danger")"
                                     style="width:@dev.completedPercent%"></div>
                            </div>
                        </div>

                        @if (dev.tasks.Any())
                        {
                            <div class="dsc-dev-tasks">
                                @foreach (var task in dev.tasks.OrderBy(t => t.status == "InProgress" ? 0 : 1))
                                {
                                    <div class="dsc-task-row @(task.status == "Done" ? "done" : task.status == "InProgress" ? "in-progress" : "")">
                                        <div class="dsc-task-info">
                                            <span class="dsc-task-title">@task.title</span>
                                            <span class="dsc-task-meta">@task.type · @task.sp SP · @task.hours ч.</span>
                                        </div>
                                        <span class="badge @GetTaskStatusBadge(task.status)">@GetTaskStatusText(task.status)</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted small py-2">Нет задач в спринте</div>
                        }

                        @if (dev.blockers.Any())
                        {
                            <div class="dsc-dev-blockers">
                                @foreach (var b in dev.blockers)
                                {
                                    <span class="badge bg-danger d-block mb-1 text-start">⚠ @b.description</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div style="height: 2rem;"></div>
        }
    }
</div>

<style>
    .daily-scrum-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .dsc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .dsc-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .dsc-summary {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .dsc-summary-item {
        flex: 1;
        text-align: center;
        padding: 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        background: var(--bg-card, #fff);
    }

    .dsc-summary-value {
        font-size: 1.1rem;
        font-weight: 700;
        display: block;
    }

    .dsc-summary-label {
        font-size: 0.65rem;
        color: var(--text-secondary);
    }

    .dsc-devs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }

    .dsc-dev-card {
        border: 1px solid var(--border-color);
        border-radius: 0.6rem;
        padding: 0.75rem;
        background: var(--bg-card, #fff);
    }

        .dsc-dev-card.overloaded {
            border-color: #EF4444;
            background: rgba(239,68,68,0.02);
        }

    .dsc-dev-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.5rem;
    }

    .dsc-dev-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-color), #3730A3);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .dsc-dev-stats {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .dsc-dev-stat {
        flex: 1;
        text-align: center;
    }

    .stat-value {
        font-size: 0.85rem;
        font-weight: 700;
        display: block;
    }

    .stat-label {
        font-size: 0.6rem;
        color: var(--text-secondary);
    }

    .dsc-dev-progress {
        margin-bottom: 0.5rem;
    }

    .dsc-dev-tasks {
        margin-top: 0.25rem;
    }

    .dsc-task-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.35rem 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 0.3rem;
        margin-bottom: 0.2rem;
        font-size: 0.75rem;
    }

        .dsc-task-row.done {
            opacity: 0.5;
        }

        .dsc-task-row.in-progress {
            border-left: 3px solid #F59E0B;
        }

    .dsc-task-title {
        font-weight: 500;
    }

    .dsc-task-meta {
        font-size: 0.65rem;
        color: var(--text-secondary);
        display: block;
    }

    .dsc-dev-blockers {
        margin-top: 0.5rem;
    }

    .dsc-card {
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        overflow: hidden;
    }

        .dsc-card.border-danger {
            border-color: #EF4444;
        }

    .dsc-card-header {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0.75rem;
        background: var(--bg-light);
        border-bottom: 1px solid var(--border-color);
        font-weight: 600;
        font-size: 0.8rem;
    }

    .dsc-card-body {
        padding: 0.5rem 0.75rem;
    }

    .dsc-blocker {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.3rem 0;
        border-bottom: 1px solid var(--border-color);
        font-size: 0.8rem;
    }

        .dsc-blocker:last-child {
            border-bottom: none;
        }

    [data-bs-theme="dark"] .dsc-summary-item, [data-bs-theme="dark"] .dsc-dev-card {
        background: #1E293B;
        border-color: #334155;
    }

    [data-bs-theme="dark"] .dsc-task-row {
        background: #0F172A;
        border-color: #334155;
    }

    @@media (max-width: 768px) {
        .dsc-devs {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private SprintBriefResponse? activeSprint;
    private UserResponse? currentUser;

    private bool isLoading = true;
    private bool isAuthorized = false;

    private (int total, int completed, double percent, int daysLeft, decimal totalSP) sprintProgress;
    
    private List<DevSummary> developers = new();
    private List<(string description, string severity)> teamBlockers = new();

    public class DevSummary
    {
        public string userId { get; set; } = "";
        public string fullName { get; set; } = "";
        public string role { get; set; } = "";
        public int totalTasks { get; set; }
        public int completedTasks { get; set; }
        public decimal totalSP { get; set; }
        public decimal totalHours { get; set; }
        public double completedPercent => totalTasks > 0 ? (double)completedTasks / totalTasks * 100 : 0;
        public bool isOverloaded => totalTasks > 2;
        public List<TaskInfo> tasks { get; set; } = new();
        public List<BlockerInfo> blockers { get; set; } = new();
    }

    public class TaskInfo
    {
        public Guid id { get; set; }
        public string title { get; set; } = "";
        public string type { get; set; } = "";
        public string status { get; set; } = "";
        public decimal sp { get; set; }
        public decimal hours { get; set; }
    }

    public class BlockerInfo
    {
        public string description { get; set; } = "";
        public string severity { get; set; } = "";
    }

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        isLoading = true;
        try
        {
            var pr = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (!pr.Success || pr.Data == null) { isLoading = false; return; }
            project = pr.Data;

            var ur = await AuthService.GetCurrentUserAsync();
            if (ur.Success && ur.Data != null) currentUser = ur.Data;

            var mr = await ProjectService.GetProjectMembersAsync(ProjectId);
            if (mr.Success && mr.Data != null)
            {
                var cm = mr.Data.FirstOrDefault(m => m.UserId == currentUser?.Id);
                isAuthorized = cm?.Role is "ScrumMaster" or "ProductOwner" || project.Owner?.Id == currentUser?.Id;
            }

            if (!isAuthorized) { isLoading = false; return; }

            var sr = await SprintService.GetProjectSprintsAsync(ProjectId);
            if (sr.Success && sr.Data != null)
            {
                activeSprint = sr.Data.FirstOrDefault(s => s.IsActive);
            }

            if (activeSprint != null)
            {
                var board = await SprintService.GetSprintBoardAsync(activeSprint.Id);
                if (board.Success && board.Data != null)
                {
                    var tasks = board.Data.Tasks;
                    sprintProgress.total = tasks.Count;
                    sprintProgress.completed = tasks.Count(t => t.Status == "Done");
                    sprintProgress.percent = sprintProgress.total > 0 ? (double)sprintProgress.completed / sprintProgress.total * 100 : 0;
                    sprintProgress.daysLeft = Math.Max(0, (activeSprint.EndDate - DateTime.Now.Date).Days);
                    sprintProgress.totalSP = tasks.Sum(t => t.StoryPoints ?? 0);

                    var devMembers = mr.Data.Where(m => m.Role == "Developer").ToList();
                    foreach (var dev in devMembers)
                    {
                        var devTasks = tasks.Where(t => t.Assignee?.Id == dev.UserId).ToList();
                        var devBlockers = tasks
                            .Where(t => t.Assignee?.Id == dev.UserId)
                            .SelectMany(t => t.ActiveBlockers ?? new())
                            .ToList();

                        developers.Add(new DevSummary
                        {
                            userId = dev.UserId.ToString(),
                            fullName = dev.FullName,
                            role = dev.Role,
                            totalTasks = devTasks.Count,
                            completedTasks = devTasks.Count(t => t.Status == "Done"),
                            totalSP = devTasks.Sum(t => t.StoryPoints ?? 0),
                            totalHours = devTasks.Sum(t => t.EstimatedHours ?? 0),
                            tasks = devTasks.Select(t => new TaskInfo
                            {
                                id = t.Id,
                                title = t.Title,
                                type = t.Type,
                                status = t.Status,
                                sp = t.StoryPoints ?? 0,
                                hours = t.EstimatedHours ?? 0
                            }).ToList(),
                            blockers = devBlockers.Select(b => new BlockerInfo { description = b.Description, severity = b.Severity }).ToList()
                        });
                    }

                    teamBlockers = tasks
                        .Where(t => t.HasBlockers)
                        .SelectMany(t => t.ActiveBlockers ?? new())
                        .GroupBy(b => b.Description)
                        .Select(g => (description: g.Key, severity: g.First().Severity))
                        .ToList();
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private async Task RefreshData() => await LoadAll();

    private async Task CopyToClipboard()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Daily Scrum — {DateTime.Now:dd.MM.yyyy HH:mm}");
        sb.AppendLine($"Проект: {project?.Name}");
        sb.AppendLine($"Спринт: {activeSprint?.Name}");
        sb.AppendLine($"Прогресс: {sprintProgress.completed}/{sprintProgress.total} задач, {sprintProgress.daysLeft} дн. осталось");
        sb.AppendLine();
        foreach (var dev in developers)
        {
            sb.AppendLine($"{dev.fullName} ({dev.role}) — {dev.completedTasks}/{dev.totalTasks} задач, {dev.totalSP} SP, {dev.totalHours:F0} ч., {dev.completedPercent:F0}%");
            foreach (var t in dev.tasks)
                sb.AppendLine($"  [{t.status}] {t.title} ({t.type}, {t.sp} SP, {t.hours} ч.)");
            if (dev.blockers.Any())
                foreach (var b in dev.blockers)
                    sb.AppendLine($"  ⚠ {b.description}");
            sb.AppendLine();
        }
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        await DialogService.AlertAsync("Сводка скопирована", "", "", "success");
    }

    private string GetTaskStatusBadge(string s) => s switch { "Done" => "bg-success", "InProgress" => "bg-warning text-dark", _ => "bg-secondary" };
    private string GetTaskStatusText(string s) => s switch { "Done" => "Готово", "InProgress" => "В работе", _ => "К выполнению" };
    private string GetSeverityBadge(string s) => s switch { "Critical" => "bg-danger", "High" => "bg-warning text-dark", _ => "bg-info" };
    private string GetInitials(string n) => string.IsNullOrEmpty(n) ? "?" : n.Split(' ')[0][..Math.Min(2, n.Split(' ')[0].Length)].ToUpper();
    private void GoBack() => Navigation.NavigateTo($"/projects/{ProjectId}");
}