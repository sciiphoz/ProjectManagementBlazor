@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Восстановление пароля</PageTitle>

<div class="auth-container">
    <div class="auth-split">
        <!-- Левая сторона — форма -->
        <div class="auth-form-side">
            <div class="auth-form-wrapper">
                <h3 class="mb-3">Восстановление пароля</h3>

                @if (step == 1)
                {
                    <p class="text-muted mb-4">Введите email, указанный при регистрации. На него будет отправлен код подтверждения.</p>

                    <EditForm Model="@emailModel" OnValidSubmit="@SendCode">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <InputText type="email" @bind-Value="emailModel.Email" class="form-control" placeholder="Введите email" />
                            </div>
                            <ValidationMessage For="@(() => emailModel.Email)" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Отправить код
                        </button>
                    </EditForm>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 small" style="white-space: pre-line;">@errorMessage</div>
                    }
                }
                else if (step == 2)
                {
                    <p class="text-muted mb-4">Код отправлен на <strong>@emailModel.Email</strong>. Введите его ниже.</p>

                    <EditForm Model="@codeModel" OnValidSubmit="@VerifyCode">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Код подтверждения</label>
                            <InputText @bind-Value="codeModel.Code" class="form-control" placeholder="6-значный код" />
                            <ValidationMessage For="@(() => codeModel.Code)" />
                            <small class="text-muted">Код действителен 15 минут</small>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Подтвердить
                        </button>
                    </EditForm>
                    <button class="btn btn-link btn-sm w-100 mt-2" @onclick="ResendCode">Отправить код повторно</button>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 small">@errorMessage</div>
                    }
                }
                else if (step == 3)
                {
                    <p class="text-muted mb-4">Введите новый пароль для <strong>@emailModel.Email</strong></p>

                    <EditForm Model="@passwordModel" OnValidSubmit="@ResetPassword">
                        <DataAnnotationsValidator />
                        <div class="mb-2">
                            <label class="form-label">Новый пароль</label>
                            <InputText type="password" @bind-Value="passwordModel.NewPassword" class="form-control" placeholder="Минимум 6 символов" />
                            <ValidationMessage For="@(() => passwordModel.NewPassword)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Подтверждение пароля</label>
                            <InputText type="password" @bind-Value="passwordModel.ConfirmNewPassword" class="form-control" placeholder="Повторите пароль" />
                            <ValidationMessage For="@(() => passwordModel.ConfirmNewPassword)" />
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Сбросить пароль
                        </button>
                    </EditForm>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 small">@errorMessage</div>
                    }
                }
                else if (step == 4)
                {
                    <div class="text-center">
                        <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Пароль успешно изменён</h5>
                        <p class="text-muted">Теперь вы можете войти с новым паролем.</p>
                        <button class="btn btn-primary mt-2" @onclick="GoToLogin">Войти</button>
                    </div>
                }

                @if (step != 4)
                {
                    <p class="text-center mt-3 mb-0 small">
                        <a href="/login">Вернуться к авторизации</a>
                    </p>
                }
            </div>
        </div>

        <!-- Правая сторона -->
        <div class="auth-brand-side">
            <div class="auth-brand-content">
                <h2>Project Management</h2>
                <p class="lead">Безопасное восстановление доступа к вашим проектам</p>
                <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-2"><i class="bi bi-shield-lock"></i><span class="small">Двухэтапная проверка</span></div>
                    <div class="d-flex align-items-center gap-2"><i class="bi bi-envelope"></i><span class="small">Код на email</span></div>
                    <div class="d-flex align-items-center gap-2"><i class="bi bi-clock"></i><span class="small">Код действителен 15 минут</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        display: flex;
        margin: -1.1rem;
    }

    .auth-split {
        display: flex;
        width: 100%;
    }

    .auth-form-side {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 3rem;
        background: #fff;
    }

    .auth-form-wrapper {
        width: 100%;
        max-width: 420px;
    }

        .auth-form-wrapper h3 {
            font-weight: 700;
            color: var(--text-primary);
        }

    .auth-brand-side {
        flex: 1;
        background: linear-gradient(135deg, var(--primary-color) 0%, #3730A3 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
    }

    .auth-brand-content {
        max-width: 420px;
    }

        .auth-brand-content h2 {
            color: #fff !important;
            font-weight: 700;
            font-size: 1.75rem;
        }

        .auth-brand-content .lead {
            color: rgba(255,255,255,0.9) !important;
            font-size: 0.95rem;
        }

        .auth-brand-content i {
            font-size: 1.2rem;
            opacity: 0.85;
            width: 1.5rem;
            text-align: center;
        }

    @@media (max-width: 768px) {
        .auth-split {
            flex-direction: column;
        }

        .auth-brand-side {
            display: none;
        }

        .auth-form-side {
            padding: 2rem 1.5rem;
        }

        .auth-container {
            margin: 0;
        }
    }
</style>

@code {
    private int step = 1;

    private EmailModel emailModel = new();
    private CodeModel codeModel = new();
    private PasswordModel passwordModel = new();
    
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private class EmailModel
    {
        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Введите корректный email")]
        public string Email { get; set; } = string.Empty;
    }

    private class CodeModel
    {
        [Required(ErrorMessage = "Введите код")]
        public string Code { get; set; } = string.Empty;
    }

    private class PasswordModel
    {
        [Required(ErrorMessage = "Введите новый пароль")]
        [MinLength(6, ErrorMessage = "Минимум 6 символов")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Подтвердите пароль")]
        [Compare("NewPassword", ErrorMessage = "Пароли не совпадают")]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }

    private async Task SendCode()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            var r = await UserService.ForgotPasswordAsync(emailModel.Email);
            if (r.Success)
            {
                step = 2;
                codeModel.Code = "";
            }
            else
            {
                errorMessage = r.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResendCode()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            var r = await UserService.ForgotPasswordAsync(emailModel.Email);
            if (!r.Success)
            {
                errorMessage = r.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task VerifyCode()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            var r = await UserService.VerifyResetCodeAsync(emailModel.Email, codeModel.Code);
            if (r.Success)
            {
                step = 3;
                passwordModel = new();
            }
            else
            {
                errorMessage = r.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResetPassword()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            var r = await UserService.ResetPasswordWithCodeAsync(emailModel.Email, codeModel.Code, passwordModel.NewPassword, passwordModel.ConfirmNewPassword);
            if (r.Success)
            {
                step = 4;
            }
            else
            {
                errorMessage = r.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");
}