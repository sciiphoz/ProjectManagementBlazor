@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Восстановление пароля</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4>Восстановление пароля</h4>
            </div>
            <div class="card-body">
                @if (step == 1)
                {
                    <p class="text-muted mb-3">
                        Введите email, указанный при регистрации. На него будет отправлен код подтверждения.
                    </p>

                    <EditForm Model="@emailModel" OnValidSubmit="@SendCode">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText type="email" @bind-Value="emailModel.Email" class="form-control" />
                            <ValidationMessage For="@(() => emailModel.Email)" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Отправить код
                        </button>
                    </EditForm>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                }
                else if (step == 2)
                {
                    <p class="text-muted mb-3">
                        Код подтверждения отправлен на email <strong>@emailModel.Email</strong>.
                        Введите его ниже.
                    </p>

                    <EditForm Model="@codeModel" OnValidSubmit="@VerifyCode">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Код подтверждения</label>
                            <InputText @bind-Value="codeModel.Code" class="form-control"
                                       placeholder="Введите 6-значный код" />
                            <ValidationMessage For="@(() => codeModel.Code)" />
                            <small class="text-muted">Код действителен 15 минут</small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Подтвердить
                        </button>
                    </EditForm>

                    <div class="text-center mt-3">
                        <button class="btn btn-link btn-sm" @onclick="ResendCode">
                            Отправить код повторно
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                }
                else if (step == 3)
                {
                    <p class="text-muted mb-3">
                        Введите новый пароль для аккаунта <strong>@emailModel.Email</strong>
                    </p>

                    <EditForm Model="@passwordModel" OnValidSubmit="@ResetPassword">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Новый пароль</label>
                            <InputText type="password" @bind-Value="passwordModel.NewPassword" class="form-control" />
                            <ValidationMessage For="@(() => passwordModel.NewPassword)" />
                            <small class="text-muted">Минимум 6 символов</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Подтверждение пароля</label>
                            <InputText type="password" @bind-Value="passwordModel.ConfirmNewPassword" class="form-control" />
                            <ValidationMessage For="@(() => passwordModel.ConfirmNewPassword)" />
                        </div>

                        <button type="submit" class="btn btn-success w-100" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Сбросить пароль
                        </button>
                    </EditForm>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                }
                else if (step == 4)
                {
                    <div class="text-center">
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill" style="font-size: 48px;"></i>
                            <h5 class="mt-2">Пароль успешно изменен!</h5>
                            <p>Теперь вы можете войти с новым паролем.</p>
                        </div>
                        <button class="btn btn-primary mt-2" @onclick="GoToLogin">
                            Перейти к авторизации
                        </button>
                    </div>
                }

                <hr />

                <div class="text-center">
                    <a href="/login">Вернуться к авторизации</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int step = 1;
    private EmailModel emailModel = new();
    private CodeModel codeModel = new();
    private PasswordModel passwordModel = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string? lastEmail = null;

    private class EmailModel
    {
        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Введите корректный email")]
        public string Email { get; set; } = string.Empty;
    }

    private class CodeModel
    {
        [Required(ErrorMessage = "Введите код подтверждения")]
        [MinLength(6, ErrorMessage = "Код должен содержать 6 цифр")]
        [MaxLength(6, ErrorMessage = "Код должен содержать 6 цифр")]
        public string Code { get; set; } = string.Empty;
    }

    private class PasswordModel
    {
        [Required(ErrorMessage = "Введите новый пароль")]
        [MinLength(6, ErrorMessage = "Пароль должен содержать минимум 6 символов")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Подтвердите пароль")]
        [Compare("NewPassword", ErrorMessage = "Пароли не совпадают")]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }

    private async Task SendCode()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await UserService.ForgotPasswordAsync(emailModel.Email);
            if (result.Success)
            {
                lastEmail = emailModel.Email;
                step = 2;
                codeModel.Code = "";
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResendCode()
    {
        if (string.IsNullOrEmpty(lastEmail)) return;

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await UserService.ForgotPasswordAsync(lastEmail);
            if (!result.Success)
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task VerifyCode()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await UserService.VerifyResetCodeAsync(emailModel.Email, codeModel.Code);
            if (result.Success)
            {
                step = 3;
                passwordModel = new PasswordModel();
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResetPassword()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await UserService.ResetPasswordWithCodeAsync(
                emailModel.Email,
                codeModel.Code,
                passwordModel.NewPassword,
                passwordModel.ConfirmNewPassword);

            if (result.Success)
            {
                step = 4;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}