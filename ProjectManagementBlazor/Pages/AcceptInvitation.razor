@page "/accept-invitation"
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims

<PageTitle>Принятие приглашения</PageTitle>

<div class="container mt-5">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Проверка приглашения...</p>
        </div>
    }
    else if (!isLoggedIn)
    {
        <div class="text-center mt-5">
            <i class="bi bi-box-arrow-in-right text-primary fs-1"></i>
            <h4>Требуется вход</h4>
            <p class="text-muted">Чтобы принять приглашение, необходимо войти в систему.</p>
            <a href="/login?returnUrl=@Uri.EscapeDataString(Navigation.Uri)" class="btn btn-primary me-2">
                Войти в систему
            </a>
            <a href="/register?returnUrl=@Uri.EscapeDataString(Navigation.Uri)" class="btn btn-outline-primary">
                Зарегистрироваться
            </a>
        </div>
    }
    else if (isSuccess)
    {
        <div class="text-center mt-5">
            <i class="bi bi-check-circle text-success fs-1"></i>
            <h4>Приглашение принято!</h4>
            <p class="text-muted">Вы стали участником проекта «@projectName»</p>
            <button class="btn btn-primary" @onclick="GoToProjects">Перейти к проектам</button>
        </div>
    }
    else if (!isValid)
    {
        <div class="text-center mt-5">
            <i class="bi bi-x-circle text-danger fs-1"></i>
            <h4>Приглашение недействительно</h4>
            <p class="text-muted">@errorMessage</p>
            <button class="btn btn-primary" @onclick="GoToProjects">Мои проекты</button>
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <i class="bi bi-envelope-check text-success fs-1"></i>
            <h4>Приглашение в проект</h4>
            <p class="text-muted">Вас пригласили присоединиться к проекту <strong>«@projectName»</strong></p>
            <p class="text-muted">Роль: <strong>@roleName</strong></p>
            @if (isAccepting)
            {
                <button class="btn btn-success btn-lg" disabled>
                    <span class="spinner-border spinner-border-sm me-2"></span> Принятие...
                </button>
            }
            else
            {
                <button class="btn btn-success btn-lg" @onclick="AcceptInvitationAsync">
                    <i class="bi bi-person-check me-2"></i> Принять приглашение
                </button>
            }
            <div class="mt-2">
                <button class="btn btn-link text-muted" @onclick="GoToProjects">Отклонить и перейти к проектам</button>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isValid = false;
    private bool isSuccess = false;
    private bool isLoggedIn = false;
    private bool isAccepting = false;

    private string? projectName;
    private string? roleName;
    private string? token;

    private string errorMessage = "Срок действия ссылки истёк или приглашение уже использовано.";

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        token = query.Get("token");

        if (string.IsNullOrEmpty(token))
        {
            errorMessage = "Не указан токен приглашения.";
            isLoading = false;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isLoggedIn = user.Identity?.IsAuthenticated == true;

        if (isLoggedIn)
        {
            var result = await ProjectService.CheckInvitationAsync(token);
            if (result.Success && result.Data != null)
            {
                var userEmail = user.FindFirst("email")?.Value ?? user.FindFirst(ClaimTypes.Email)?.Value;
                if (!string.IsNullOrEmpty(userEmail) && !string.Equals(userEmail, result.Data.Email, StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("/", true);
                    return;
                }

                isValid = true;
                projectName = result.Data.ProjectName;
                roleName = GetRoleLabel(result.Data.Role);
            }
            else
            {
                errorMessage = result.Message ?? errorMessage;
            }
        }

        isLoading = false;
    }

    private async Task AcceptInvitationAsync()
    {
        if (string.IsNullOrEmpty(token)) return;

        isAccepting = true;
        StateHasChanged();

        var result = await ProjectService.AcceptInvitationAsync(token);

        if (result.Success)
        {
            isSuccess = true;
            isValid = false;
        }
        else
        {
            isAccepting = false;
            await ErrorHandling.TriggerError(result.Message ?? "Не удалось принять приглашение");
        }

        StateHasChanged();
    }

    private void GoToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private string GetRoleLabel(string? role)
    {
        return role switch
        {
            "ProductOwner" => "Product Owner",
            "ScrumMaster" => "Scrum Master",
            "Developer" => "Developer",
            "Viewer" => "Viewer",
            _ => role ?? "Developer"
        };
    }
}