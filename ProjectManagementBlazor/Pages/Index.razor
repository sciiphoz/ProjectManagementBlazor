@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IAuthService AuthService
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling

<PageTitle>Главная</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка данных...</p>
        </div>
    }
    else if (currentUser != null)
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4>Добро пожаловать в систему управления проектами!</h4>
            </div>
            <div class="card-body">
                @if (currentUser != null)
                {
                    <h5>Здравствуйте, @currentUser.FullName!</h5>
                    <p>Вы вошли как: <strong>@currentUser.Username</strong></p>
                    <p>Роль: <strong>@currentUser.Role</strong></p>
                    <p>Email: <strong>@currentUser.Email</strong></p>
                }
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5>Мои проекты</h5>
                    </div>
                    <div class="card-body">
                        <p>Количество проектов: <strong>@(myProjects?.Count ?? 0)</strong></p>
                        <button class="btn btn-primary" @onclick="GoToProjects">
                            Перейти к проектам
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5>Активные спринты</h5>
                    </div>
                    <div class="card-body">
                        <p>Отслеживайте прогресс команды</p>
                        <button class="btn btn-success" @onclick="GoToSprints">
                            К спринтам
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5>Мой день</h5>
                    </div>
                    <div class="card-body">
                        <p>Планируйте свои задачи</p>
                        <button class="btn btn-warning" @onclick="GoToDashboard">
                            Открыть дашборд
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private UserResponse? currentUser;
    private List<ProjectResponse>? myProjects;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var userResult = await AuthService.GetCurrentUserAsync();
            if (userResult.Success && userResult.Data != null)
            {
                currentUser = userResult.Data;
            }
            else
            {
                await ErrorHandling.TriggerError(userResult.Message ?? "Не удалось загрузить данные пользователя");
            }

            var projectsResult = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 10 });
            if (projectsResult.Success && projectsResult.Data != null)
            {
                myProjects = projectsResult.Data.Items;
            }
        }
        catch (Exception ex)
        {
            await ErrorHandling.TriggerError($"Ошибка загрузки данных: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoToProjects() => Navigation.NavigateTo("/projects");
    private void GoToSprints() => Navigation.NavigateTo("/sprints");
    private void GoToDashboard() => Navigation.NavigateTo("/dashboard");
}