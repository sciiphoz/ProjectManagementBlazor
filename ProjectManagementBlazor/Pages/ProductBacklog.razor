@page "/backlog/{ProjectId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IBacklogService BacklogService
@inject IProjectService ProjectService
@inject ISprintService SprintService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling
@inject DialogService DialogService

<PageTitle>Бэклог</PageTitle>

<div class="backlog-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (project != null)
    {
        <!-- Заголовок -->
        <div class="backlog-header">
            <div>
                <h2>Бэклог</h2>
                <span class="text-muted small">@project.Name</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoToProject">
                    <i class="bi bi-arrow-left me-1"></i> К проекту
                </button>
                <button class="btn btn-primary btn-sm" @onclick="ShowCreateModal">
                    <i class="bi bi-plus me-1"></i> Новая задача
                </button>
            </div>
        </div>

        <!-- Фильтры -->
        <div class="backlog-filters">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control-plaintext" value="@searchTerm" @oninput="OnSearchInput" placeholder="Поиск задач..." />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-link btn-sm text-muted p-0" @onclick="ClearSearch"><i class="bi bi-x"></i></button>
                }
            </div>
            <select value="@selectedType" class="form-select form-select-sm" @onchange="OnTypeChanged">
                <option value="all">Все типы</option>
                <option value="UserStory">User Story</option>
                <option value="Bug">Bug</option>
                <option value="TechnicalTask">Техническая</option>
                <option value="Improvement">Улучшение</option>
            </select>
            <select value="@selectedStatus" class="form-select form-select-sm" @onchange="OnStatusChanged">
                <option value="all">Все статусы</option>
                <option value="Backlog">Бэклог</option>
                <option value="ToDo">To Do</option>
                <option value="InProgress">In Progress</option>
                <option value="Done">Done</option>
            </select>
            <select value="@selectedAssigneeId" class="form-select form-select-sm" @onchange="OnAssigneeChanged">
                <option value="">Все исполнители</option>
                @if (projectMembers != null)
                {
                    @foreach (var m in projectMembers)
                    {
                        <option value="@m.UserId">@m.FullName</option>
                    }
                }
            </select>
            <select value="@sortBy" class="form-select form-select-sm" @onchange="OnSortChanged">
                <option value="priority">По приоритету</option>
                <option value="created">По дате</option>
                <option value="title">По названию</option>
                <option value="storyPoints">По SP</option>
            </select>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters" title="Сбросить"><i class="bi bi-arrow-repeat"></i></button>
        </div>

        @if (!string.IsNullOrEmpty(searchTerm) || selectedType != "all" || selectedStatus != "all" || !string.IsNullOrEmpty(selectedAssigneeId))
        {
            <div class="text-muted small mb-2">
                Найдено: <strong>@totalFilteredCount</strong>
                <button class="btn btn-link btn-sm p-0 ms-1" @onclick="ResetFilters">Сбросить</button>
            </div>
        }

        <!-- Таблица -->
        @if (filteredTasks.Any())
        {
            <div class="backlog-table">
                <div class="table-header">
                    <span class="col-title">Задача</span>
                    <span class="col-type">Тип</span>
                    <span class="col-sp">SP</span>
                    <span class="col-hours">Часы</span>
                    <span class="col-status">Статус</span>
                    <span class="col-assignee">Исполнитель</span>
                    <span class="col-actions"></span>
                </div>
                @for (int i = 0; i < filteredTasks.Count; i++)
                {
                    var task = filteredTasks[i];
                    <div class="table-row @(task.Status == "Done" ? "done" : "")">
                        <span class="col-title">
                            <strong>@task.Title</strong>
                            @if (!string.IsNullOrEmpty(task.Description))
                            {
                                <span class="text-muted small d-block">@(task.Description.Length > 60 ? task.Description[..60] + "..." : task.Description)</span>
                            }
                        </span>
                        <span class="col-type"><span class="badge @GetTypeBadgeClass(task.Type)">@GetTypeName(task.Type)</span></span>
                        <span class="col-sp">@task.StoryPoints</span>
                        <span class="col-hours">@(task.EstimatedHours?.ToString() ?? "—")</span>
                        <span class="col-status"><span class="badge @GetStatusBadgeClass(task.Status)">@GetStatusName(task.Status)</span></span>
                        <span class="col-assignee">@(task.Assignee?.FullName ?? "—")</span>
                        <span class="col-actions">
                            <div class="dropdown">
                                <button class="btn btn-link btn-sm text-muted p-0" @onclick="() => ToggleRowMenu(task.Id)">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                @if (openMenuId == task.Id)
                                {
                                    <div class="dropdown-menu dropdown-menu-end show" style="position: absolute; right: 0; top: 100%; z-index: 1060;">
                                        <button class="dropdown-item" @onclick="() => { ToggleRowMenu(task.Id); EditTask(task); }">
                                            <i class="bi bi-pencil me-2"></i> Редактировать
                                        </button>
                                        <button class="dropdown-item text-danger" @onclick="() => { ToggleRowMenu(task.Id); DeleteTask(task.Id); }">
                                            <i class="bi bi-trash me-2"></i> Удалить
                                        </button>
                                        @if (sprints != null && sprints.Any(s => s.Status != "Completed"))
                                        {
                                            <button class="dropdown-item text-success" @onclick="() => { ToggleRowMenu(task.Id); MoveToSprint(task.Id, task.Title); }">
                                                <i class="bi bi-arrow-right-circle me-2"></i> В спринт
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </span>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="backlog-pagination">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)"><i class="bi bi-chevron-left"></i></button>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <button class="btn btn-outline-secondary @(currentPage == i ? "active" : "")" @onclick="() => GoToPage(i)">@i</button>
                        }
                        <button class="btn btn-outline-secondary" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-4 text-muted small">Нет задач</div>
        }
    }

    <!-- Модалка задачи -->
    @if (showModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg"><div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title">@(editingTask == null ? "Новая задача" : "Редактирование")</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@taskForm" OnValidSubmit="SaveTask">
                        <div class="row mb-2">
                            <div class="col-md-6"><label class="form-label small">Название *</label><InputText @bind-Value="taskForm.Title" class="form-control form-control-sm" /></div>
                            <div class="col-md-3"><label class="form-label small">Тип</label>
                                <InputSelect @bind-Value="taskForm.Type" class="form-select form-select-sm">
                                    <option value="0">User Story</option><option value="1">Bug</option><option value="2">Техническая</option><option value="3">Улучшение</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-3"><label class="form-label small">SP</label><InputNumber @bind-Value="taskForm.StoryPoints" class="form-control form-control-sm" /></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-6"><label class="form-label small">Оценка (ч)</label><InputNumber @bind-Value="taskForm.EstimatedHours" class="form-control form-control-sm" /></div>
                            <div class="col-md-6"><label class="form-label small">Исполнитель</label>
                                <InputSelect @bind-Value="taskForm.AssigneeId" class="form-select form-select-sm">
                                    <option value="">Не назначен</option>
                                    @if (projectMembers != null)
                                    {
                                        @foreach (var m in projectMembers) { <option value="@m.UserId">@m.FullName</option> }
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-2"><label class="form-label small">Описание</label><InputTextArea @bind-Value="taskForm.Description" class="form-control form-control-sm" rows="2" /></div>
                        <div class="mb-2"><label class="form-label small">Критерии приёмки</label><InputTextArea @bind-Value="taskForm.AcceptanceCriteria" class="form-control form-control-sm" rows="2" /></div>
                        <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModal">Отмена</button>
                    </EditForm>
                </div>
            </div></div>
        </div>
    }

    <!-- Модалка спринта -->
    @if (showMoveToSprintModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-sm modal-dialog-centered"><div class="modal-content">
                <div class="modal-header bg-success text-white"><h6 class="modal-title">В спринт</h6><button type="button" class="btn-close btn-close-white" @onclick="CloseMoveModal"></button></div>
                <div class="modal-body">
                    <p class="small">Задача: <strong>@selectedTaskTitle</strong></p>
                    <select @bind="selectedSprintId" class="form-select form-select-sm">
                        <option value="">— Выберите —</option>
                        @if (sprints != null)
                        {
                            @foreach (var s in sprints.Where(s => s.Status != "Completed"))
                            {
                                <option value="@s.Id">@s.Name · @s.StartDate.ToString("dd.MM")–@s.EndDate.ToString("dd.MM")</option>
                            }
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseMoveModal">Отмена</button>
                    <button class="btn btn-success btn-sm" @onclick="ConfirmMoveToSprint" disabled="@(selectedSprintId == Guid.Empty)">Переместить</button>
                </div>
            </div></div>
        </div>
    }
</div>

<style>
    .backlog-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .backlog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .backlog-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .backlog-filters {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .search-box {
        display: flex;
        align-items: center;
        flex: 1;
        min-width: 180px;
        background: var(--bg-light, #F8F9FB);
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.5rem;
        padding: 0.25rem 0.5rem;
    }

        .search-box i {
            color: var(--text-secondary);
            font-size: 0.8rem;
        }

        .search-box input {
            flex: 1;
            border: none;
            outline: none;
            font-size: 0.8rem;
            background: transparent;
            padding: 0.125rem 0.375rem;
            color: var(--text-primary);
        }

    .backlog-table {
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .table-header {
        display: flex;
        align-items: center;
        padding: 0.5rem 0.75rem;
        background: var(--bg-light, #F8F9FB);
        border-bottom: 1px solid var(--border-color, #E2E8F0);
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
    }

    .table-row {
        display: flex;
        align-items: center;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border-color, #E2E8F0);
        font-size: 0.8rem;
        transition: background 0.1s;
    }

        .table-row:last-child {
            border-bottom: none;
        }

        .table-row:hover {
            background: rgba(0,0,0,0.01);
        }

        .table-row.done {
            opacity: 0.5;
        }

    .col-title {
        flex: 2;
        min-width: 0;
        padding-right: 0.5rem;
    }

    .col-type {
        flex: 1;
    }

    .col-sp {
        flex: 0.5;
        text-align: center;
    }

    .col-hours {
        flex: 0.5;
        text-align: center;
    }

    .col-status {
        flex: 1;
        text-align: center;
    }

    .col-assignee {
        flex: 1.5;
    }

    .col-actions {
        flex: 0.5;
        text-align: right;
        position: relative;
    }

    .backlog-pagination {
        margin-top: 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        justify-content: center;
    }

        .backlog-pagination .btn-group {
            gap: 0.25rem;
        }

    .dropdown-menu {
        z-index: 1060;
    }

    [data-bs-theme="dark"] .backlog-table, [data-bs-theme="dark"] .table-header, [data-bs-theme="dark"] .table-row {
        background: #1E293B;
        border-color: #334155;
    }

    [data-bs-theme="dark"] .search-box {
        background: #1E293B;
        border-color: #334155;
    }

    [data-bs-theme="dark"] .table-row:hover {
        background: rgba(255,255,255,0.02);
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private List<BacklogItemResponse>? allTasks;
    private List<BacklogItemResponse> filteredTasks = new();
    private List<ProjectMemberResponse>? projectMembers;
    private List<SprintBriefResponse>? sprints;

    private string searchTerm = "";
    private string selectedType = "all";
    private string selectedStatus = "all";
    private string sortBy = "priority";
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages = 1;
    private bool isLoading = true;
    private int totalFilteredCount = 0;
    private string selectedAssigneeId = "";
    private Guid openMenuId = Guid.Empty;

    private bool showModal = false;
    private bool showMoveToSprintModal = false;
    private CreateBacklogItemRequest taskForm = new();
    private BacklogItemResponse? editingTask;
    private Guid selectedTaskId;
    private string selectedTaskTitle = "";
    private Guid selectedSprintId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var pr = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (pr.Success && pr.Data != null)
            {
                project = pr.Data;
            }
            else
            {
                Navigation.NavigateTo("/projects");
                return;
            }

            var m = await ProjectService.GetProjectMembersAsync(ProjectId);
            if (m.Success && m.Data != null)
            {
                projectMembers = m.Data;
            }

            var s = await SprintService.GetProjectSprintsAsync(ProjectId);
            if (s.Success && s.Data != null)
            {
                sprints = s.Data;
            }

            await LoadBacklog();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadBacklog()
    {
        try
        {
            var r = await BacklogService.GetProjectBacklogAsync(ProjectId, new PagedRequest { PageNumber = 1, PageSize = 100 });
            if (r.Success && r.Data != null)
            {
                allTasks = r.Data.Items.OrderBy(t => t.Priority).ToList();
                ApplyFilters();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки бэклога: {ex.Message}");
        }
    }

    private void ApplyFilters()
    {
        var query = allTasks?.AsQueryable() ?? new List<BacklogItemResponse>().AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(t =>
                (!string.IsNullOrEmpty(t.Title) && t.Title.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(t.Description) && t.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (selectedType != "all")
        {
            query = query.Where(t => t.Type == selectedType);
        }

        if (selectedStatus != "all")
        {
            query = query.Where(t => t.Status == selectedStatus);
        }

        if (!string.IsNullOrEmpty(selectedAssigneeId) && Guid.TryParse(selectedAssigneeId, out var aid))
        {
            query = query.Where(t => t.Assignee != null && t.Assignee.Id == aid);
        }

        filteredTasks = sortBy switch
        {
            "created" => query.OrderByDescending(t => t.CreatedAt).ToList(),
            "storyPoints" => query.OrderByDescending(t => t.StoryPoints).ToList(),
            "title" => query.OrderBy(t => t.Title).ToList(),
            _ => query.OrderBy(t => t.Priority).ToList()
        };

        totalFilteredCount = filteredTasks.Count;
        totalPages = (int)Math.Ceiling(filteredTasks.Count / (double)pageSize);
        filteredTasks = filteredTasks.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void ToggleRowMenu(Guid id)
    {
        openMenuId = openMenuId == id ? Guid.Empty : id;
        StateHasChanged();
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        selectedType = "all";
        selectedStatus = "all";
        selectedAssigneeId = "";
        sortBy = "priority";
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
        ApplyFilters();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        selectedType = e.Value?.ToString() ?? "all";
        currentPage = 1;
        ApplyFilters();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "all";
        currentPage = 1;
        ApplyFilters();
    }

    private async Task OnAssigneeChanged(ChangeEventArgs e)
    {
        selectedAssigneeId = e.Value?.ToString() ?? "";
        currentPage = 1;
        ApplyFilters();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "priority";
        currentPage = 1;
        ApplyFilters();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            ApplyFilters();
        }
    }

    private void ShowCreateModal()
    {
        editingTask = null;
        taskForm = new CreateBacklogItemRequest
        {
            ProjectId = ProjectId,
            Type = BacklogItemType.UserStory
        };
        showModal = true;
    }

    private void EditTask(BacklogItemResponse task)
    {
        editingTask = task;
        taskForm = new CreateBacklogItemRequest
        {
            ProjectId = ProjectId,
            Type = Enum.Parse<BacklogItemType>(task.Type),
            Title = task.Title,
            Description = task.Description,
            AcceptanceCriteria = task.AcceptanceCriteria,
            StoryPoints = task.StoryPoints,
            EstimatedHours = task.EstimatedHours,
            AssigneeId = task.Assignee?.Id
        };
        showModal = true;
    }

    private async Task SaveTask()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (!currentUser.Success || currentUser.Data == null)
            {
                return;
            }

            ApiResponse<BacklogItemResponse> result;
            if (editingTask == null)
            {
                taskForm.CreatedById = currentUser.Data.Id;
                result = await BacklogService.CreateBacklogItemAsync(taskForm);
            }
            else
            {
                var updateRequest = new UpdateBacklogItemRequest
                {
                    Title = taskForm.Title,
                    Description = taskForm.Description,
                    AcceptanceCriteria = taskForm.AcceptanceCriteria,
                    Type = taskForm.Type,
                    StoryPoints = taskForm.StoryPoints,
                    EstimatedHours = taskForm.EstimatedHours,
                    AssigneeId = taskForm.AssigneeId,
                    UserId = currentUser.Data.Id
                };
                result = await BacklogService.UpdateBacklogItemAsync(editingTask.Id, updateRequest);
            }

            if (result.Success)
            {
                CloseModal();
                await LoadBacklog();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка сохранения: {ex.Message}");
        }
    }

    private async Task DeleteTask(Guid taskId)
    {
        var ok = await DialogService.ConfirmAsync("Удалить задачу?", "Удаление", "Удалить", "danger");
        if (!ok)
        {
            return;
        }
        var r = await BacklogService.DeleteBacklogItemAsync(taskId);
        if (r.Success)
        {
            await LoadBacklog();
        }
    }

    private void GoToProject()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}");
    }

    private void MoveToSprint(Guid taskId, string taskTitle)
    {
        selectedTaskId = taskId;
        selectedTaskTitle = taskTitle;
        selectedSprintId = Guid.Empty;
        showMoveToSprintModal = true;
    }

    private void CloseMoveModal()
    {
        showMoveToSprintModal = false;
        selectedTaskId = Guid.Empty;
        selectedSprintId = Guid.Empty;
    }

    private async Task ConfirmMoveToSprint()
    {
        if (selectedSprintId == Guid.Empty)
        {
            await ErrorHandling.TriggerError("Выберите спринт");
            return;
        }

        var r = await SprintService.MoveToSprintAsync(new MoveToSprintRequest
        {
            BacklogItemIds = new List<Guid> { selectedTaskId },
            SprintId = selectedSprintId
        });

        if (r.Success)
        {
            CloseMoveModal();
            await LoadBacklog();
            await DialogService.AlertAsync("Задача перемещена в спринт", "", "bi bi-arrow-right-circle", "success");
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message);
        }
    }

    private void CloseModal()
    {
        showModal = false;
        editingTask = null;
        taskForm = new CreateBacklogItemRequest();
    }

    private string GetTypeBadgeClass(string type)
    {
        return type switch
        {
            "UserStory" => "bg-primary",
            "Bug" => "bg-danger",
            "TechnicalTask" => "bg-secondary",
            "Improvement" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetTypeName(string type)
    {
        return type switch
        {
            "UserStory" => "Story",
            "Bug" => "Bug",
            "TechnicalTask" => "Task",
            "Improvement" => "Impr",
            _ => type
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Backlog" => "bg-secondary",
            "ToDo" => "bg-info",
            "InProgress" => "bg-warning",
            "Done" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetStatusName(string status)
    {
        return status switch
        {
            "Backlog" => "Бэклог",
            "ToDo" => "To Do",
            "InProgress" => "In Progress",
            "Done" => "Done",
            _ => status
        };
    }
}