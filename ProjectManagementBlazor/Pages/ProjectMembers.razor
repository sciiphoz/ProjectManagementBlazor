@page "/projects/{ProjectId:guid}/members"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling
@inject DialogService DialogService

<PageTitle>Участники</PageTitle>

<div class="members-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50" role="status"></div>
        </div>
    }
    else if (project != null)
    {
        <div class="members-header">
            <div>
                <h2>Участники</h2>
                <span class="text-muted small">@project.Name · @(members?.Count ?? 0) человек</span>
            </div>
            <div class="d-flex gap-2">
                @if (canAddMembers && !isViewer)
                {
                    <button class="btn btn-primary btn-sm" @onclick="ShowAddMemberModal">
                        <i class="bi bi-person-plus me-1"></i> Добавить
                    </button>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i> Назад
                </button>
            </div>
        </div>

        <div class="members-roles">
            <div class="role-chip @(roleFilter == "" ? "active" : "")" @onclick="ShowAllRoles">Все · @(members?.Count ?? 0)</div>
            <div class="role-chip @(roleFilter == "ProductOwner" ? "active" : "")" @onclick="ShowProductOwner">Product Owner · @GetRoleCount("ProductOwner")</div>
            <div class="role-chip @(roleFilter == "ScrumMaster" ? "active" : "")" @onclick="ShowScrumMaster">Scrum Master · @GetRoleCount("ScrumMaster")</div>
            <div class="role-chip @(roleFilter == "Developer" ? "active" : "")" @onclick="ShowDeveloper">Developer · @GetRoleCount("Developer")</div>
            <div class="role-chip @(roleFilter == "Viewer" ? "active" : "")" @onclick="ShowViewer">Viewer · @GetRoleCount("Viewer")</div>
        </div>

        <div class="members-list">
            @foreach (var member in filteredMembers)
            {
                <div class="member-row">
                    <div class="member-avatar">@GetInitials(member.FullName)</div>
                    <div class="member-info">
                        <div class="fw-medium">@member.FullName</div>
                        <div class="text-muted small">@member.Email</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (member.IsOwner)
                        {
                            <span class="badge bg-primary">Владелец</span>
                        }
                        else if (canChangeRoles && member.Role != "ScrumMaster")
                        {
                            <select class="form-select form-select-sm" style="width: auto;"
                                    value="@member.Role"
                                    @onchange="(ChangeEventArgs e) => ChangeRole(member.UserId, e.Value?.ToString())">
                                @foreach (var role in editableRoles)
                                {
                                    <option value="@role.Value" selected="@(member.Role == role.Value)">@role.Label</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@GetRoleLabel(member.Role)</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <p class="text-muted">Проект не найден</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">Назад</button>
        </div>
    }

    @if (showAddModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 700px;">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h6 class="modal-title">Добавить участника</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div class="row g-0" style="min-height: 380px;">
                            <!-- Левая колонка — ручной ввод email -->
                            <div class="col-5 border-end p-3 d-flex flex-column">
                                <label class="form-label small fw-medium">Пригласить по email</label>
                                <div class="mb-2">
                                    <select @bind="inviteRole" class="form-select form-select-sm mb-2">
                                        @foreach (var role in availableRoles)
                                        {
                                            <option value="@role.Value">@role.Label</option>
                                        }
                                    </select>
                                    <input type="email" class="form-control form-control-sm mb-2" @bind="inviteEmail" placeholder="user@example.com" />
                                    <button class="btn btn-primary btn-sm w-100" @onclick="AddMember"
                                            disabled="@(string.IsNullOrWhiteSpace(inviteEmail) || isSaving || inviteCount >= 10)">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        <i class="bi bi-send me-1"></i> Отправить приглашение
                                    </button>
                                </div>
                                @if (inviteCount >= 10)
                                {
                                    <div class="text-danger small">Лимит: 10 приглашений за 10 минут.</div>
                                }
                                <div class="text-muted smallest mt-auto pt-2">
                                    <i class="bi bi-info-circle me-1"></i> Приглашение придёт на почту. Пользователь примет его по ссылке.
                                </div>
                            </div>
                            <!-- Правая колонка — предложенные -->
                            <div class="col-7 p-3">
                                <label class="form-label small fw-medium">Предложенные участники</label>
                                @if (isLoadingSuggestions)
                                {
                                    <div class="text-center py-5">
                                        <div class="spinner-border spinner-border-sm text-primary"></div>
                                        <p class="text-muted small mt-2 mb-0">Загрузка...</p>
                                    </div>
                                }
                                else if (suggestedMembers.Any())
                                {
                                    <div class="suggested-list">
                                        @foreach (var sug in suggestedMembers)
                                        {
                                            <div class="suggested-item">
                                                <div class="suggested-info">
                                                    <div class="suggested-name">@sug.FullName</div>
                                                    <div class="suggested-meta">
                                                        <span>@sug.Email</span>
                                                        <span class="text-muted">· @sug.CommonProjectName</span>
                                                    </div>
                                                </div>
                                                <button class="btn btn-outline-primary btn-sm flex-shrink-0"
                                                        @onclick="() => InviteSuggested(sug.Email, sug.FullName)"
                                                        disabled="@(inviteCount >= 10)"
                                                        title="Пригласить">
                                                    <i class="bi bi-person-plus"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center text-muted small py-5">
                                        <i class="bi bi-people fs-2 opacity-25 d-block mb-2"></i>
                                        Нет доступных кандидатов
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer py-2">
                        <button class="btn btn-secondary btn-sm" @onclick="CloseAddModal">Закрыть</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .members-page {
        max-width: 600px;
        margin: 0 auto;
    }

    .members-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .members-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .members-roles {
        display: flex;
        gap: 0.375rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .role-chip {
        padding: 0.25rem 0.625rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        cursor: pointer;
        border: 1px solid var(--border-color, #E2E8F0);
        color: var(--text-secondary);
        transition: all 0.1s;
    }

        .role-chip:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .role-chip.active {
            background: var(--primary-color);
            color: #fff;
            border-color: var(--primary-color);
        }

    .members-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .member-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.5rem;
    }

    .member-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-color), #3730A3);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .member-info {
        flex: 1;
        min-width: 0;
    }

    .suggested-list {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        max-height: 280px;
        overflow-y: auto;
    }

    .suggested-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        gap: 0.5rem;
    }

        .suggested-item:hover {
            background: var(--bg-light, #F8F9FB);
        }

    .suggested-info {
        min-width: 0;
        flex: 1;
    }

    .suggested-name {
        font-size: 0.78rem;
        font-weight: 500;
    }

    .suggested-meta {
        font-size: 0.68rem;
        color: var(--text-secondary);
    }

    [data-bs-theme="dark"] .suggested-item:hover {
        background: #334155;
    }

    [data-bs-theme="dark"] .member-row {
        background: #1E293B;
        border-color: #334155;
    }

    [data-bs-theme="dark"] .role-chip {
        background: #1E293B;
        border-color: #334155;
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private List<ProjectMemberResponse>? members;
    private bool isLoading = true;
    private bool showAddModal = false;
    private string inviteEmail = "";
    private string inviteRole = "Developer";
    private bool isSaving = false;
    private string currentUserRole = "";
    private string roleFilter = "";
    private bool isViewer = false;
    private bool isOwner = false;
    private List<SuggestedMemberResponse> suggestedMembers = new();
    private bool isLoadingSuggestions = false;
    private int inviteCount = 0;
    private DateTime inviteWindowStart = DateTime.MinValue;
    private bool canAddMembers => IsScrumMaster || isOwner;
    private bool canChangeRoles => IsScrumMaster;
    private bool canRemoveMembers => IsScrumMaster || isOwner;
    private bool IsScrumMaster => currentUserRole == "ScrumMaster";
    private bool IsDeveloper => currentUserRole == "Developer";

    private List<ProjectMemberResponse> filteredMembers
    {
        get
        {
            if (string.IsNullOrEmpty(roleFilter))
                return members ?? new();
            return (members ?? new()).Where(m => m.Role == roleFilter && !m.IsOwner).ToList();
        }
    }

    // Доступные роли для добавления: Владелец → ScrumMaster, ScrumMaster → Developer/Viewer
    private List<(string Value, string Label)> availableRoles
    {
        get
        {
            if (isOwner)
                return new() { ("ScrumMaster", "Scrum Master") };
            if (IsScrumMaster)
                return new() { ("Developer", "Developer"), ("Viewer", "Viewer") };
            return new();
        }
    }

    // Роли, доступные для изменения
    private List<(string Value, string Label)> editableRoles
    {
        get
        {
            if (IsScrumMaster)
                return new() { ("Developer", "Developer"), ("Viewer", "Viewer") };
            return new();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await CheckPermissions();
    }

    private async Task LoadSuggestions()
    {
        isLoadingSuggestions = true;
        StateHasChanged();
        try
        {
            var r = await ProjectService.GetSuggestedMembersAsync(ProjectId);
            if (r.Success && r.Data != null)
                suggestedMembers = r.Data;
            else
                Console.WriteLine($"Suggestions failed: {r.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadSuggestions error: {ex.Message}");
        }
        finally
        {
            isLoadingSuggestions = false;
            StateHasChanged();
        }
    }

    private async Task InviteSuggested(string email, string fullName)
    {
        if (inviteCount >= 10) return;
        inviteEmail = email;
        await AddMember();
    }

    private async Task CheckPermissions()
    {
        try
        {
            var u = await AuthService.GetCurrentUserAsync();
            if (u.Success && u.Data != null)
            {
                isOwner = project?.Owner?.Id == u.Data.Id;
                var m = await ProjectService.GetProjectMembersAsync(ProjectId);
                if (m.Success && m.Data != null)
                {
                    var cm = m.Data.FirstOrDefault(x => x.UserId == u.Data.Id);
                    if (cm != null)
                    {
                        currentUserRole = cm.Role;
                        isViewer = cm.Role == "Viewer";
                    }
                    else if (isOwner)
                    {
                        currentUserRole = "ProductOwner";
                    }
                }
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var p = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (p.Success && p.Data != null) project = p.Data;
            else { Navigation.NavigateTo("/projects"); return; }
            var m = await ProjectService.GetProjectMembersAsync(ProjectId);
            if (m.Success && m.Data != null) members = m.Data;
        }
        catch { await ErrorHandling.TriggerError("Ошибка загрузки"); }
        finally { isLoading = false; }
    }

    // Изменение роли — только ScrumMaster, только на Dev/Viewer
    private async Task ChangeRole(Guid userId, string? newRole)
    {
        if (!canChangeRoles || string.IsNullOrEmpty(newRole)) return;
        if (!editableRoles.Any(r => r.Value == newRole)) return;

        try
        {
            var r = await ProjectService.UpdateMemberRoleAsync(ProjectId, new UpdateMemberRoleRequest { UserId = userId, NewRole = newRole });
            if (r.Success) await LoadData();
            else await ErrorHandling.TriggerError(r.Message);
        }
        catch { await ErrorHandling.TriggerError("Ошибка"); }
    }

    private async Task RemoveMember(Guid userId, string userName)
    {
        if (!canRemoveMembers) return;
        var ok = await DialogService.ConfirmAsync($"Удалить участника «{userName}»?", "Удаление", "Удалить", "danger");
        if (!ok) return;
        try
        {
            var r = await ProjectService.RemoveMemberAsync(ProjectId, new RemoveMemberRequest { UserId = userId });
            if (r.Success) await LoadData();
            else await ErrorHandling.TriggerError(r.Message);
        }
        catch { await ErrorHandling.TriggerError("Ошибка"); }
    }

    private void ShowAddMemberModal()
    {
        if (!canAddMembers) { ErrorHandling.TriggerError("Нет прав"); return; }
        inviteEmail = "";
        inviteRole = availableRoles.First().Value;
        suggestedMembers.Clear();
        showAddModal = true;
        _ = LoadSuggestions();
    }

    private void CloseAddModal() => showAddModal = false;

    private async Task AddMember()
    {
        if (string.IsNullOrWhiteSpace(inviteEmail)) { await ErrorHandling.TriggerError("Введите email"); return; }

        if (DateTime.UtcNow - inviteWindowStart > TimeSpan.FromMinutes(10))
        {
            inviteCount = 0;
            inviteWindowStart = DateTime.UtcNow;
        }
        if (inviteCount >= 10)
        {
            await ErrorHandling.TriggerError("Достигнут лимит: 10 приглашений за 10 минут.");
            return;
        }

        isSaving = true;
        try
        {
            var r = await ProjectService.AddMemberAsync(ProjectId, new AddProjectMemberRequest { Email = inviteEmail, Role = inviteRole, UserId = null });
            if (r.Success)
            {
                inviteCount++;
                suggestedMembers.RemoveAll(s => s.Email.Equals(inviteEmail, StringComparison.OrdinalIgnoreCase));
                await DialogService.AlertAsync($"Приглашение отправлено на {inviteEmail}.", "Приглашение отправлено", "", "success");
                inviteEmail = "";
                await LoadSuggestions();
            }
            else await ErrorHandling.TriggerError(r.Message ?? "Ошибка");
        }
        catch (Exception ex) { await ErrorHandling.TriggerError($"Ошибка: {ex.Message}"); }
        finally { isSaving = false; }
    }

    private void ShowAllRoles() { roleFilter = ""; StateHasChanged(); }
    private void ShowProductOwner() { roleFilter = "ProductOwner"; StateHasChanged(); }
    private void ShowScrumMaster() { roleFilter = "ScrumMaster"; StateHasChanged(); }
    private void ShowDeveloper() { roleFilter = "Developer"; StateHasChanged(); }
    private void ShowViewer() { roleFilter = "Viewer"; StateHasChanged(); }
    private int GetRoleCount(string role) => members?.Count(m => m.Role == role && !m.IsOwner) ?? 0;
    private string GetInitials(string n) => string.IsNullOrEmpty(n) ? "?" : n.Split(' ')[0][..Math.Min(2, n.Split(' ')[0].Length)].ToUpper();
    private string GetRoleLabel(string r) => r switch { "ProductOwner" => "PO", "ScrumMaster" => "SM", "Developer" => "Dev", "Viewer" => "View", _ => r };
    private void GoBack() => Navigation.NavigateTo($"/projects/{ProjectId}");
}