@page "/projects/{ProjectId:guid}/members"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling
@inject DialogService DialogService

<PageTitle>Участники</PageTitle>

<div class="members-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50" role="status"></div>
        </div>
    }
    else if (project != null)
    {
        <div class="members-header">
            <div>
                <h2>Участники</h2>
                <span class="text-muted small">@project.Name · @(members?.Count ?? 0) человек</span>
            </div>
            <div class="d-flex gap-2">
                @if (canAddMembers && !isViewer)
                {
                    <button class="btn btn-primary btn-sm" @onclick="ShowAddMemberModal">
                        <i class="bi bi-person-plus me-1"></i> Добавить
                    </button>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i> Назад
                </button>
            </div>
        </div>

        <div class="members-roles">
            <div class="role-chip @(roleFilter == "" ? "active" : "")" @onclick="ShowAllRoles">Все · @(members?.Count ?? 0)</div>
            <div class="role-chip @(roleFilter == "ProductOwner" ? "active" : "")" @onclick="ShowProductOwner">Product Owner · @GetRoleCount("ProductOwner")</div>
            <div class="role-chip @(roleFilter == "ScrumMaster" ? "active" : "")" @onclick="ShowScrumMaster">Scrum Master · @GetRoleCount("ScrumMaster")</div>
            <div class="role-chip @(roleFilter == "Developer" ? "active" : "")" @onclick="ShowDeveloper">Developer · @GetRoleCount("Developer")</div>
            <div class="role-chip @(roleFilter == "Viewer" ? "active" : "")" @onclick="ShowViewer">Viewer · @GetRoleCount("Viewer")</div>
        </div>

        <div class="members-list">
            @foreach (var member in filteredMembers)
            {
                <div class="member-row">
                    <div class="member-avatar">@GetInitials(member.FullName)</div>
                    <div class="member-info">
                        <div class="fw-medium">@member.FullName</div>
                        <div class="text-muted small">@member.Email</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (member.IsOwner)
                        {
                            <span class="badge bg-primary">Владелец</span>
                        }
                        else if (canAddMembers && !isViewer)
                        {
                            <select class="form-select form-select-sm" style="width: auto;"
                                    value="@member.Role"
                                    @onchange="(ChangeEventArgs e) => ChangeRole(member.UserId, e.Value?.ToString())">
                                <option value="ProductOwner">Product Owner</option>
                                <option value="ScrumMaster">Scrum Master</option>
                                <option value="Developer">Developer</option>
                                <option value="Viewer">Viewer</option>
                            </select>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@GetRoleLabel(member.Role)</span>
                        }
                        @if (!member.IsOwner && canAddMembers && !isViewer)
                        {
                            <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => RemoveMember(member.UserId, member.FullName)">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <p class="text-muted">Проект не найден</p>
            <button class="btn btn-primary btn-sm" @onclick="GoBack">Назад</button>
        </div>
    }

    <!-- Модалка добавления -->
    @if (showAddModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h6 class="modal-title">Добавить участника</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label small">Email</label>
                            <input type="email" class="form-control form-control-sm" @bind="inviteEmail" placeholder="user@example.com" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Роль</label>
                            <select @bind="inviteRole" class="form-select form-select-sm">
                                <option value="ProductOwner">Product Owner</option>
                                <option value="ScrumMaster">Scrum Master</option>
                                <option value="Developer">Developer</option>
                                <option value="Viewer">Viewer</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary btn-sm" @onclick="CloseAddModal">Отмена</button>
                        <button class="btn btn-primary btn-sm" @onclick="AddMember" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Добавить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .members-page {
        max-width: 600px;
        margin: 0 auto;
    }

    .members-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .members-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .members-roles {
        display: flex;
        gap: 0.375rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .role-chip {
        padding: 0.25rem 0.625rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        cursor: pointer;
        border: 1px solid var(--border-color, #E2E8F0);
        color: var(--text-secondary);
        transition: all 0.1s;
    }

        .role-chip:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .role-chip.active {
            background: var(--primary-color);
            color: #fff;
            border-color: var(--primary-color);
        }

    .members-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .member-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.5rem;
    }

    .member-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-color), #3730A3);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .member-info {
        flex: 1;
        min-width: 0;
    }

    [data-bs-theme="dark"] .member-row {
        background: #1E293B;
        border-color: #334155;
    }

    [data-bs-theme="dark"] .role-chip {
        background: #1E293B;
        border-color: #334155;
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private List<ProjectMemberResponse>? members;
    private bool isLoading = true;
    private bool showAddModal = false;
    private string inviteEmail = "";
    private string inviteRole = "Developer";
    private bool isSaving = false;
    private bool canAddMembers = false;
    private string currentUserRole = "";
    private string roleFilter = "";
    private bool isViewer = false;

    private List<ProjectMemberResponse> filteredMembers
    {
        get
        {
            if (string.IsNullOrEmpty(roleFilter))
            {
                return members ?? new();
            }
            return (members ?? new()).Where(m => m.Role == roleFilter && !m.IsOwner).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await CheckPermissions();
    }

    private async Task CheckPermissions()
    {
        try
        {
            var u = await AuthService.GetCurrentUserAsync();
            if (u.Success && u.Data != null)
            {
                var m = await ProjectService.GetProjectMembersAsync(ProjectId);
                if (m.Success && m.Data != null)
                {
                    var cm = m.Data.FirstOrDefault(x => x.UserId == u.Data.Id);
                    if (cm != null)
                    {
                        currentUserRole = cm.Role;
                        isViewer = cm.Role == "Viewer";
                        canAddMembers = cm.Role is "ProductOwner" or "ScrumMaster";
                    }
                    else if (project?.Owner?.Id == u.Data.Id)
                    {
                        canAddMembers = true;
                        currentUserRole = "ProductOwner";
                    }
                }
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var p = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (p.Success && p.Data != null)
            {
                project = p.Data;
            }
            else
            {
                Navigation.NavigateTo("/projects");
                return;
            }
            var m = await ProjectService.GetProjectMembersAsync(ProjectId);
            if (m.Success && m.Data != null)
            {
                members = m.Data;
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка загрузки");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeRole(Guid userId, string? newRole)
    {
        if (string.IsNullOrEmpty(newRole) || !canAddMembers || isViewer)
        {
            return;
        }
        try
        {
            var r = await ProjectService.UpdateMemberRoleAsync(ProjectId, new UpdateMemberRoleRequest { UserId = userId, NewRole = newRole });
            if (r.Success)
            {
                await LoadData();
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private async Task RemoveMember(Guid userId, string userName)
    {
        if (!canAddMembers || isViewer)
        {
            return;
        }
        var ok = await DialogService.ConfirmAsync($"Удалить участника «{userName}»?", "Удаление", "Удалить", "danger");
        if (!ok)
        {
            return;
        }
        try
        {
            var r = await ProjectService.RemoveMemberAsync(ProjectId, new RemoveMemberRequest { UserId = userId });
            if (r.Success)
            {
                await LoadData();
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private void ShowAddMemberModal()
    {
        if (!canAddMembers || isViewer)
        {
            ErrorHandling.TriggerError("Нет прав");
            return;
        }
        inviteEmail = "";
        inviteRole = "Developer";
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task AddMember()
    {
        if (string.IsNullOrWhiteSpace(inviteEmail))
        {
            await ErrorHandling.TriggerError("Введите email");
            return;
        }
        isSaving = true;
        try
        {
            var r = await ProjectService.AddMemberAsync(ProjectId, new AddProjectMemberRequest { Email = inviteEmail, Role = inviteRole });
            if (r.Success)
            {
                CloseAddModal();
                await LoadData();
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowAllRoles()
    {
        SetRoleFilter("");
    }

    private void ShowProductOwner()
    {
        SetRoleFilter("ProductOwner");
    }

    private void ShowScrumMaster()
    {
        SetRoleFilter("ScrumMaster");
    }

    private void ShowDeveloper()
    {
        SetRoleFilter("Developer");
    }

    private void ShowViewer()
    {
        SetRoleFilter("Viewer");
    }

    private int GetRoleCount(string role)
    {
        return members?.Count(m => m.Role == role && !m.IsOwner) ?? 0;
    }

    private void SetRoleFilter(string role)
    {
        roleFilter = role;
        StateHasChanged();
    }

    private string GetInitials(string n)
    {
        if (string.IsNullOrEmpty(n))
        {
            return "?";
        }
        return n.Split(' ')[0][..Math.Min(2, n.Split(' ')[0].Length)].ToUpper();
    }

    private string GetRoleLabel(string r)
    {
        return r switch
        {
            "ProductOwner" => "PO",
            "ScrumMaster" => "SM",
            "Developer" => "Dev",
            "Viewer" => "View",
            _ => r
        };
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}");
    }
}