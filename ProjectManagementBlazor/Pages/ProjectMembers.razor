@page "/projects/{ProjectId:guid}/members"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IUserService UserService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IErrorHandlingService ErrorHandling

<PageTitle>Участники проекта</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка участников...</p>
        </div>
    }
    else if (project != null)
    {
        <!-- Проверка прав на добавление участников -->
        @if (!canAddMembers)
        {
            <div class="alert alert-warning mb-3">
                ⚠️ У вас нет прав для добавления или изменения участников. Только Product Owner и Scrum Master могут управлять участниками.
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Участники проекта</h2>
                <p class="text-muted">@project.Name</p>
            </div>
            <div>
                @if (canAddMembers)
                {
                    <button class="btn btn-primary" @onclick="ShowAddMemberModal">
                        + Добавить участника
                    </button>
                }
                <button class="btn btn-outline-secondary ms-2" @onclick="GoBack">
                    ← Назад к проекту
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">👥 Все участники (@(members?.Count ?? 0))</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Участник</th>
                                <th>Email</th>
                                <th>Роль</th>
                                <th>Дата</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in members ?? new List<ProjectMemberResponse>())
                            {
                                var memberId = member.UserId;
                                var memberRole = member.Role;
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="ms-2">
                                                <strong>@member.FullName</strong>
                                                <br />
                                                <small class="text-muted">@@@member.Username</small>
                                            </div>
                                        </div>
                                    </td
                                    <td>@member.Email</td
                                    <td>
                                        @if (member.IsOwner)
                                        {
                                            <span class="badge bg-primary">Владелец</span>
                                        }
                                        else if (canAddMembers)
                                        {
                                            <select class="form-select form-select-sm" style="width: auto;"
                                                    value="@memberRole"
                                                    @onchange="(ChangeEventArgs e) => ChangeRole(memberId, e.Value?.ToString())">
                                                <option value="ProductOwner">Product Owner</option>
                                                <option value="ScrumMaster">Scrum Master</option>
                                                <option value="Developer">Developer</option>
                                                <option value="Viewer">Viewer</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@member.Role</span>
                                        }
                                    </td
                                    <td>@member.JoinedAt.ToString("dd.MM.yyyy")</td
                                    <td>
                                        @if (!member.IsOwner && canAddMembers)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => RemoveMember(member.UserId, member.FullName)">
                                                🗑️ Удалить
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h4>@GetRoleCount("ProductOwner")</h4>
                        <span>Product Owner</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h4>@GetRoleCount("ScrumMaster")</h4>
                        <span>Scrum Master</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h4>@GetRoleCount("Developer")</h4>
                        <span>Разработчики</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h4>@GetRoleCount("Viewer")</h4>
                        <span>Наблюдатели</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            <h5>Проект не найден</h5>
            <button class="btn btn-primary mt-2" @onclick="GoBack">Вернуться назад</button>
        </div>
    }

    @if (showAddModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Добавление участника</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Email пользователя *</label>
                            <input type="email" class="form-control" @bind="inviteEmail"
                                   placeholder="user@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Роль</label>
                            <select @bind="inviteRole" class="form-select">
                                <option value="ProductOwner">Product Owner</option>
                                <option value="ScrumMaster">Scrum Master</option>
                                <option value="Developer">Developer</option>
                                <option value="Viewer">Viewer</option>
                            </select>
                        </div>
                        <div class="alert alert-info small">
                            <strong>Примечание:</strong> Пользователь должен быть зарегистрирован в системе.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseAddModal">Отмена</button>
                        <button class="btn btn-primary" @onclick="AddMember" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Добавить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
    }

    .form-select-sm {
        min-width: 140px;
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private List<ProjectMemberResponse>? members;
    private bool isLoading = true;
    private bool showAddModal = false;
    private string inviteEmail = "";
    private string inviteRole = "Developer";
    private bool isSaving = false;
    private bool canAddMembers = false;
    private string currentUserRole = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await CheckPermissions();
    }

    private async Task CheckPermissions()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser.Success && currentUser.Data != null)
            {
                var membersResult = await ProjectService.GetProjectMembersAsync(ProjectId);
                if (membersResult.Success && membersResult.Data != null)
                {
                    var currentMember = membersResult.Data.FirstOrDefault(m => m.UserId == currentUser.Data.Id);
                    if (currentMember != null)
                    {
                        currentUserRole = currentMember.Role;
                        canAddMembers = currentUserRole == "ProductOwner" || currentUserRole == "ScrumMaster";
                        Console.WriteLine($"Текущий пользователь: {currentUser.Data.FullName}, Роль: {currentUserRole}, Может добавлять: {canAddMembers}");
                    }
                    else if (project?.Owner?.Id == currentUser.Data.Id)
                    {
                        canAddMembers = true;
                        currentUserRole = "ProductOwner";
                        Console.WriteLine($"Текущий пользователь: {currentUser.Data.FullName} (владелец), Может добавлять: true");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка проверки прав: {ex.Message}");
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var projectResult = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (projectResult.Success && projectResult.Data != null)
            {
                project = projectResult.Data;
            }
            else
            {
                Navigation.NavigateTo("/projects");
                return;
            }

            var membersResult = await ProjectService.GetProjectMembersAsync(ProjectId);
            if (membersResult.Success && membersResult.Data != null)
            {
                members = membersResult.Data;
                foreach (var m in members)
                {
                    Console.WriteLine($"Участник: {m.FullName}, Роль: {m.Role}, IsOwner: {m.IsOwner}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            await ErrorHandling.TriggerError($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeRole(Guid userId, string? newRole)
    {
        if (string.IsNullOrEmpty(newRole)) return;
        if (!canAddMembers)
        {
            await ErrorHandling.TriggerError("У вас нет прав для изменения ролей");
            return;
        }

        try
        {
            var request = new UpdateMemberRoleRequest
            {
                UserId = userId,
                NewRole = newRole
            };
            var result = await ProjectService.UpdateMemberRoleAsync(ProjectId, request);
            if (result.Success)
            {
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Роль изменена");
            }
            else
            {
                await ErrorHandling.TriggerError($"Ошибка: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка изменения роли: {ex.Message}");
            await ErrorHandling.TriggerError("Произошла ошибка");
        }
    }

    private async Task RemoveMember(Guid userId, string userName)
    {
        if (!canAddMembers)
        {
            await ErrorHandling.TriggerError("У вас нет прав для удаления участников");
            return;
        }
        
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить участника '{userName}' из проекта?")) return;

        try
        {
            var request = new RemoveMemberRequest { UserId = userId };
            var result = await ProjectService.RemoveMemberAsync(ProjectId, request);
            if (result.Success)
            {
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Участник удален");
            }
            else
            {
                await ErrorHandling.TriggerError($"Ошибка: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка удаления: {ex.Message}");
            await ErrorHandling.TriggerError("Произошла ошибка");
        }
    }

    private void ShowAddMemberModal()
    {
        if (!canAddMembers)
        {
            ErrorHandling.TriggerError("У вас нет прав для добавления участников");
            return;
        }
        inviteEmail = "";
        inviteRole = "Developer";
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task AddMember()
{
    if (string.IsNullOrWhiteSpace(inviteEmail))
    {
        await ErrorHandling.TriggerError("Введите email пользователя");
        return;
    }

    if (!canAddMembers)
    {
        await ErrorHandling.TriggerError("У вас нет прав для добавления участников");
        return;
    }

    isSaving = true;
    try
    {
        // Создаём запрос с email (без UserId)
        var request = new AddProjectMemberRequest
        {
            Email = inviteEmail,  // Отправляем email вместо UserId
            Role = inviteRole
        };
        
        var result = await ProjectService.AddMemberAsync(ProjectId, request);
        
        if (result.Success)
        {
            CloseAddModal();
            await LoadData();
            await JS.InvokeVoidAsync("alert", "Участник добавлен");
        }
        else
        {
            await ErrorHandling.TriggerError($"Ошибка: {result.Message}");
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Ошибка добавления: {ex.Message}");
        await ErrorHandling.TriggerError("Произошла ошибка");
    }
    finally
    {
        isSaving = false;
    }
}

    private int GetRoleCount(string role)
    {
        if (members == null) return 0;
        
        return members.Count(m => m.Role == role && !m.IsOwner);
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}");
    }
}