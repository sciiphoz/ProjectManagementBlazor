@page "/login"
@using System.ComponentModel.DataAnnotations
@using ProjectManagementBlazor.DTO.Requests
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Вход в систему</PageTitle>

<div class="auth-container">
    <div class="auth-split">
        <div class="auth-form-side">
            <div class="auth-form-wrapper">
                <h3 class="mb-3">Вход в систему</h3>
                <p class="text-muted mb-4">Войдите в свою учётную запись</p>

                <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Логин или Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <InputText @bind-Value="loginModel.UsernameOrEmail" class="form-control" placeholder="Введите логин или email" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.UsernameOrEmail)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пароль</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <InputText type="@(showPassword ? "text" : "password")"
                                       @bind-Value="loginModel.Password"
                                       class="form-control" placeholder="Введите пароль" />
                            <button class="btn btn-outline-secondary" type="button"
                                    @onclick="TogglePasswordVisibility"
                                    title="@(showPassword ? "Скрыть пароль" : "Показать пароль")">
                                <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="loginModel.RememberMe" class="form-check-input" />
                            <label class="form-check-label small">Запомнить меня</label>
                        </div>
                        <a href="/forgot-password" class="text-decoration-none small">Забыли пароль?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Войти
                    </button>
                </EditForm>

                @if (hasError)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3 small" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span style="white-space: pre-line;">@errorMessage</span>
                        <button type="button" class="btn-close" @onclick="ClearError" aria-label="Close"></button>
                    </div>
                }

                <p class="text-center mt-3 mb-0 small">
                    Нет аккаунта? <a href="/register@(returnUrl != null ? $"?returnUrl={Uri.EscapeDataString(returnUrl)}" : "")" class="fw-bold">Зарегистрироваться</a>
                </p>
            </div>
        </div>

        <div class="auth-brand-side">
            <div class="auth-brand-content">
                <p class="lead">Система управления проектами по методологии SCRUM</p>
                <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-2"><i class="bi bi-kanban"></i><span class="small">Scrum-доски с перетаскиванием</span></div>
                    <div class="d-flex align-items-center gap-2"><i class="bi bi-graph-up"></i><span class="small">Графики сгорания задач и отчёты</span></div>
                    <div class="d-flex align-items-center gap-2"><i class="bi bi-people"></i><span class="small">Командная работа</span></div>
                    <div class="d-flex align-items-center gap-2"><i class="bi bi-chat-dots"></i><span class="small">Комментарии и обсуждения задач</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        display: flex;
        margin: -1.1rem;
    }

    .auth-split {
        display: flex;
        width: 100%;
    }

    .auth-form-side {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 3rem;
        background: #fff;
    }

    .auth-form-wrapper {
        width: 100%;
        max-width: 420px;
    }

        .auth-form-wrapper h3 {
            font-weight: 700;
            color: var(--text-primary);
        }

    .auth-brand-side {
        flex: 1;
        background: linear-gradient(135deg, var(--primary-color) 0%, #3730A3 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem;
    }

    .auth-brand-content {
        max-width: 420px;
    }

        .auth-brand-content h2 {
            color: #fff !important;
            font-weight: 700;
            font-size: 1.75rem;
        }

        .auth-brand-content .lead {
            color: rgba(255,255,255,0.9) !important;
            font-size: 0.95rem;
        }

        .auth-brand-content i {
            font-size: 1.2rem;
            opacity: 0.85;
            width: 1.5rem;
            text-align: center;
        }

    .input-group {
        border-radius: 0.375rem;
        overflow: hidden;
        box-shadow: none;
        border: 1px solid var(--border-color, #E2E8F0);
    }

        .input-group:focus-within {
            border-color: var(--primary-color, #4F46E5);
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
        }

    .input-group-text {
        background: var(--bg-light, #F8F9FB);
        border: none;
        font-size: 0.85rem;
        padding: 0.375rem 0.625rem;
    }

    .input-group .form-control,
    .input-group input[type="text"],
    .input-group input[type="email"],
    .input-group input[type="password"] {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        outline: none !important;
    }

    .input-group .btn-outline-secondary {
        border: none;
        background: var(--bg-light, #F8F9FB);
        border-radius: 0 !important;
    }

        .input-group .btn-outline-secondary:hover {
            background: #E2E8F0;
        }

    .input-group input:focus,
    .input-group .form-control:focus {
        box-shadow: none !important;
        border: none !important;
        outline: none !important;
    }

    .form-control-plain {
        border-radius: 0.375rem !important;
        border: 1px solid var(--border-color, #E2E8F0) !important;
    }

        .form-control-plain:focus {
            border-color: var(--primary-color, #4F46E5) !important;
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15) !important;
        }

    .form-label {
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 0.25rem;
    }

    .form-control, .input-group-text {
        font-size: 0.85rem;
    }

        .form-control::placeholder {
            color: #94A3B8;
            font-size: 0.8rem;
        }

    [data-bs-theme="dark"] .auth-form-side {
        background: #1E293B;
    }

    [data-bs-theme="dark"] .auth-form-wrapper h3 {
        color: #F1F5F9;
    }

    [data-bs-theme="dark"] .auth-form-wrapper .text-muted {
        color: #94A3B8 !important;
    }

    [data-bs-theme="dark"] .form-control {
        background: #334155;
        border-color: #475569;
        color: #F1F5F9;
    }

    [data-bs-theme="dark"] .input-group-text {
        background: #475569;
        border-color: #475569;
        color: #CBD5E1;
    }

    [data-bs-theme="dark"] .btn-outline-secondary {
        color: #CBD5E1;
        border-color: #475569;
    }

        [data-bs-theme="dark"] .btn-outline-secondary:hover {
            background: #475569;
            color: #F1F5F9;
        }

    [data-bs-theme="dark"] a {
        color: #818CF8;
    }

    [data-bs-theme="dark"] .input-group .btn-outline-secondary {
        background: #475569;
    }

    @@media (max-width: 768px) {
        .auth-split {
            flex-direction: column;
        }

        .auth-brand-side {
            display: none;
        }

        .auth-form-side {
            padding: 2rem 1.5rem;
        }
    }
</style>

@code {
    private LoginRequest loginModel = new();

    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private bool hasError = false;

    private bool showPassword = false;
    private string? returnUrl;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        returnUrl = query.Get("returnUrl");
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty; hasError = false;
        if (string.IsNullOrWhiteSpace(loginModel.UsernameOrEmail)) { errorMessage = "Введите логин или email"; hasError = true; return; }
        if (string.IsNullOrWhiteSpace(loginModel.Password)) { errorMessage = "Введите пароль"; hasError = true; return; }

        isLoading = true; StateHasChanged();
        try
        {
            var result = await AuthService.LoginAsync(loginModel);
            if (result == null) { errorMessage = "Не удалось выполнить вход: сервер не ответил"; hasError = true; return; }
            if (result.Success) { Navigation.NavigateTo(returnUrl ?? "/", true); return; }
            errorMessage = string.IsNullOrEmpty(result.Message) ? "Неверный логин или пароль" : result.Message;
            if (result.Errors?.Any() == true) errorMessage += "\n" + string.Join("\n", result.Errors.Select(e => $"• {e}"));
            hasError = true;
        }
        catch (Exception ex) { errorMessage = $"Ошибка соединения: {ex.Message}"; hasError = true; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private void TogglePasswordVisibility() => showPassword = !showPassword;
    private void ClearError() { errorMessage = string.Empty; hasError = false; }
}