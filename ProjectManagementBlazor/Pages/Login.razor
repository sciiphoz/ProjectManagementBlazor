@page "/login"
@using System.ComponentModel.DataAnnotations
@using ProjectManagementBlazor.DTO.Requests
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Вход в систему</PageTitle>

<div class="auth-container">
    <div class="auth-split">
        <div class="auth-form-side">
            <div class="auth-form-wrapper">
                <h3 class="mb-3">Вход в систему</h3>
                <p class="text-muted mb-4">Войдите в свою учётную запись</p>

                <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Логин или Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <InputText @bind-Value="loginModel.UsernameOrEmail" class="form-control" placeholder="Введите логин или email" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.UsernameOrEmail)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пароль</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <InputText type="@(showPassword ? "text" : "password")"
                                       @bind-Value="loginModel.Password"
                                       class="form-control" placeholder="Введите пароль" />
                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    @onclick="TogglePasswordVisibility"
                                    title="@(showPassword ? "Скрыть пароль" : "Показать пароль")">
                                <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="loginModel.RememberMe" class="form-check-input" />
                            <label class="form-check-label small">Запомнить меня</label>
                        </div>
                        <a href="/forgot-password" class="text-decoration-none small">Забыли пароль?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Войти
                    </button>
                </EditForm>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3 small" style="white-space: pre-line;">@errorMessage</div>
                }

                <p class="text-center mt-3 mb-0 small">
                    Нет аккаунта? <a href="/register@(returnUrl != null ? $"?returnUrl={Uri.EscapeDataString(returnUrl)}" : "")" class="fw-bold">Зарегистрироваться</a>
                </p>
            </div>
        </div>

        <div class="auth-brand-side">
            <div class="auth-brand-content">
                <h2>Project Management</h2>
                <p class="lead">Система управления проектами по методологии SCRUM</p>
                <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-kanban"></i>
                        <span class="small">Канбан-доски с drag-and-drop</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-graph-up"></i>
                        <span class="small">Burndown-графики и отчёты</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-people"></i>
                        <span class="small">Командная работа и Daily Scrum</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-dots"></i>
                        <span class="small">Комментарии и обсуждения задач</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        display: flex;
        margin: -1.1rem;
    }

    .auth-split {
        display: flex;
        width: 100%;
    }

    .auth-form-side {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 3rem;
        background: #fff;
    }

    .auth-form-wrapper {
        width: 100%;
        max-width: 420px;
    }

        .auth-form-wrapper h3 {
            font-weight: 700;
            color: var(--text-primary);
        }

    .auth-brand-side {
        flex: 1;
        background: linear-gradient(135deg, var(--primary-color) 0%, #3730A3 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
    }

    .auth-brand-content {
        max-width: 420px;
    }

        .auth-brand-content h2 {
            color: #fff !important;
            font-weight: 700;
            font-size: 1.75rem;
        }

        .auth-brand-content .lead {
            color: rgba(255,255,255,0.9) !important;
            font-size: 0.95rem;
        }

        .auth-brand-content i {
            font-size: 1.2rem;
            opacity: 0.85;
            width: 1.5rem;
            text-align: center;
        }

    [data-bs-theme="dark"] .auth-form-side {
        background: #1E293B;
    }

    [data-bs-theme="dark"] .auth-form-wrapper h3 {
        color: #F1F5F9;
    }

    [data-bs-theme="dark"] .auth-form-wrapper .text-muted {
        color: #94A3B8 !important;
    }

    [data-bs-theme="dark"] .form-control {
        background: #334155;
        border-color: #475569;
        color: #F1F5F9;
    }

    [data-bs-theme="dark"] .input-group-text {
        background: #475569;
        border-color: #475569;
        color: #CBD5E1;
    }

    [data-bs-theme="dark"] .btn-outline-secondary {
        color: #CBD5E1;
        border-color: #475569;
    }

        [data-bs-theme="dark"] .btn-outline-secondary:hover {
            background: #475569;
            color: #F1F5F9;
        }

    [data-bs-theme="dark"] a {
        color: #818CF8;
    }

    @@media (max-width: 768px) {
        .auth-split {
            flex-direction: column;
        }

        .auth-brand-side {
            display: none;
        }

        .auth-form-side {
            padding: 2rem 1.5rem;
        }

        .auth-container {
            margin: 0;
        }
    }
</style>

@code {
    private LoginRequest loginModel = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private bool showPassword = false;
    private string? returnUrl;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        returnUrl = query.Get("returnUrl");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (result.Success)
            {
                Navigation.NavigateTo(returnUrl ?? "/", true);
            }
            else
            {
                errorMessage = result.Message;

                if (result.Errors != null && result.Errors.Any())
                {
                    errorMessage += "\n\n" + string.Join("\n", result.Errors.Select(e => $"• {e}"));
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }
}