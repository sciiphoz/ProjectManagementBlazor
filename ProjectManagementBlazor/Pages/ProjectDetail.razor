@page "/projects/{ProjectId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IProjectService ProjectService
@inject ISprintService SprintService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling
@inject DialogService DialogService

<PageTitle>@(project?.Name ?? "Проект")</PageTitle>

<div class="project-detail-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50" role="status"></div>
        </div>
    }
    else if (project != null)
    {
        <div class="detail-header">
            <div class="d-flex align-items-center gap-3 mb-3">
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoToProjects">
                    <i class="bi bi-arrow-left me-1"></i>
                </button>
                <div class="project-avatar @(project.IsArchived ? "bg-secondary" : "bg-primary")">
                    @project.Name[..Math.Min(2, project.Name.Length)].ToUpper()
                </div>
                <div>
                    <h2 class="mb-0">@project.Name</h2>
                    @if (!string.IsNullOrEmpty(project.Description))
                    {
                        <p class="text-muted mb-0 small">@project.Description</p>
                    }
                </div>
                @if (project.IsArchived)
                {
                    <span class="badge bg-warning text-dark ms-2">Архив</span>
                }
            </div>

            <div class="detail-metrics">
                <div class="metric">
                    <span class="metric-value">@project.MembersCount</span>
                    <span class="metric-label">Участников</span>
                </div>
                <div class="metric">
                    <span class="metric-value">@project.TotalTasksCount</span>
                    <span class="metric-label">Всего задач</span>
                </div>
                <div class="metric">
                    <span class="metric-value">@project.CompletedTasksCount</span>
                    <span class="metric-label">Выполнено</span>
                </div>
                <div class="metric">
                    <span class="metric-value">@project.ActiveSprintsCount</span>
                    <span class="metric-label">Активных спринтов</span>
                </div>
            </div>

            <div class="detail-actions">
                @if (!isViewer && (IsProductOwner || IsScrumMaster))
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="GoToBacklog">
                        <i class="bi bi-list-task"></i> Бэклог
                    </button>
                }
                @if (!isViewer && (IsScrumMaster))
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="GoToReports">
                        <i class="bi bi-graph-up"></i> Отчёты
                    </button>
                }
                @if (!isViewer && (IsProductOwner || IsScrumMaster))
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="GoToActivityLogs">
                         <i class="bi bi-clock-history"></i> Логи
                    </button>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoToMembers">
                    <i class="bi bi-people"></i> Участники
                </button>
                @if (!isViewer && IsScrumMaster)
                {
                    <button class="btn btn-outline-info btn-sm" @onclick="OpenDailyScrum">
                        <i class="bi bi-calendar-event"></i> Daily Scrum
                    </button>
                }
                @if (!isViewer && IsProductOwner)
                {
                    <div class="ms-auto d-flex gap-2">
                        <button class="btn btn-outline-warning btn-sm" @onclick="ShowEditModal">
                            <i class="bi bi-pencil"></i>
                        </button>
                        @if (!project.IsArchived)
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ArchiveProject">
                                <i class="bi bi-archive"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-success btn-sm" @onclick="RestoreProject">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        }
                        <button class="btn btn-outline-danger btn-sm" @onclick="DeleteProject">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="detail-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Спринты</h5>
                @if (!project.IsArchived && !isViewer && IsScrumMaster)
                {
                    <button class="btn btn-primary btn-sm" @onclick="ShowCreateSprintModal">
                        <i class="bi bi-plus me-1"></i> Новый спринт
                    </button>
                }
            </div>

            @if (sprints != null && sprints.Any())
            {
                <div class="sprints-grid">
                    @foreach (var sprint in sprints)
                    {
                        var progress = GetSprintProgress(sprint.Id);
                        <div class="sprint-card @(sprint.IsActive ? "active" : "")" @onclick="() => OpenSprint(sprint.Id)">
                            <div class="sprint-card-header">
                                <span class="sprint-name">@sprint.Name</span>
                                <span class="badge @GetSprintStatusBadge(sprint.Status, sprint.IsActive)">
                                    @GetSprintStatusText(sprint.Status, sprint.IsActive)
                                </span>
                            </div>
                            <div class="sprint-dates">
                                <i class="bi bi-calendar-range me-1"></i>
                                @sprint.StartDate.ToString("dd.MM") — @sprint.EndDate.ToString("dd.MM")
                            </div>
                            <div class="sprint-progress mt-2">
                                <div class="progress" style="height: 4px;">
                                    <div class="progress-bar @(progress >= 80 ? "bg-success" : progress >= 40 ? "bg-warning" : "bg-danger")"
                                         style="width: @((int)progress)%"></div>
                                </div>
                                <span class="small text-muted mt-1">@((int)progress)%</span>
                            </div>
                            @if (!isViewer && !project.IsArchived && IsScrumMaster && (sprint.Status == "Planned" || sprint.Status == "Cancelled"))
                            {
                                <button class="btn btn-link btn-sm text-danger p-0 mt-2" @onclick:stopPropagation="true"
                                        @onclick="() => DeleteSprint(sprint.Id, sprint.Name)">
                                    Удалить
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">Нет спринтов</div>
            }
        </div>
    }

    @if (showEditModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h6 class="modal-title">Редактировать проект</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseEditModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@editProject" OnValidSubmit="@UpdateProject">
                            <div class="mb-3">
                                <label class="form-label small fw-medium">Название</label>
                                <InputText @bind-Value="editProject.Name" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-medium">Описание</label>
                                <InputTextArea @bind-Value="editProject.Description" class="form-control" rows="3" />
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Сохранить</button>
                                <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Отмена</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showCreateSprintModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h6 class="modal-title">Новый спринт</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateSprintModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@newSprint" OnValidSubmit="@CreateSprint">
                            <div class="mb-3">
                                <label class="form-label small fw-medium">Название *</label>
                                <InputText @bind-Value="newSprint.Name" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-medium">Цель</label>
                                <InputTextArea @bind-Value="newSprint.Goal" class="form-control" rows="2" />
                            </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-medium">Начало</label>
                                    <InputDate @bind-Value="newSprint.StartDate" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-medium">Конец</label>
                                    <InputDate @bind-Value="newSprint.EndDate" class="form-control" />
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success">Создать</button>
                                <button type="button" class="btn btn-secondary" @onclick="CloseCreateSprintModal">Отмена</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .project-detail-page {
        max-width: 800px;
        margin: 0 auto;
    }

    .detail-header {
        margin-bottom: 1.5rem;
    }

    .project-avatar {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .detail-metrics {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 1rem;
    }

    .metric {
        text-align: center;
    }

    .metric-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        display: block;
    }

    .metric-label {
        font-size: 0.7rem;
        color: var(--text-secondary);
    }

    .detail-actions {
        display: flex;
        gap: 0.375rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .detail-section {
        margin-top: 1.5rem;
    }

    .sprints-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.5rem;
    }

    .sprint-card {
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        padding: 0.75rem;
        cursor: pointer;
        transition: box-shadow 0.15s;
    }

        .sprint-card:hover {
            box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        }

        .sprint-card.active {
            border-left: 3px solid var(--success-color, #10B981);
        }

    .sprint-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.25rem;
    }

    .sprint-name {
        font-weight: 600;
        font-size: 0.85rem;
    }

    .sprint-dates {
        font-size: 0.7rem;
        color: var(--text-secondary);
    }

    [data-bs-theme="dark"] .sprint-card {
        background: #1E293B;
        border-color: #334155;
    }

        [data-bs-theme="dark"] .sprint-card:hover {
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private List<SprintBriefResponse>? sprints;
    private Dictionary<Guid, double> sprintProgress = new();
    private bool isLoading = true;
    private bool showEditModal = false;
    private bool showCreateSprintModal = false;
    private UpdateProjectRequest editProject = new();
    private CreateSprintRequest newSprint = new();
    private Guid currentUserId;
    private string currentUserRole = "";
    private bool isViewer = false;

    private bool IsProductOwner
    {
        get
        {
            return project?.Owner?.Id == currentUserId || currentUserRole == "ProductOwner";
        }
    }

    private bool IsScrumMaster
    {
        get
        {
            return currentUserRole == "ScrumMaster";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var u = await AuthService.GetCurrentUserAsync();
            if (u.Success && u.Data != null)
            {
                currentUserId = u.Data.Id;
            }

            var pr = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (pr.Success && pr.Data != null)
            {
                project = pr.Data;
            }

            var sp = await SprintService.GetProjectSprintsAsync(ProjectId);
            if (sp.Success && sp.Data != null)
            {
                sprints = sp.Data;
                foreach (var s in sprints)
                {
                    await LoadSprintProgress(s.Id);
                }
            }

            await LoadCurrentUserRole();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
            await ErrorHandling.TriggerError("Ошибка загрузки");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCurrentUserRole()
    {
        try
        {
            var m = await ProjectService.GetProjectMembersAsync(ProjectId);
            if (m.Success && m.Data != null)
            {
                var member = m.Data.FirstOrDefault(x => x.UserId == currentUserId);
                if (member != null)
                {
                    currentUserRole = member.Role ?? "";
                    isViewer = member.Role == "Viewer";
                }
            }
        }
        catch
        {
            currentUserRole = "";
        }
    }

    private async Task LoadSprintProgress(Guid id)
    {
        try
        {
            var r = await SprintService.GetSprintBoardAsync(id);
            if (r.Success && r.Data != null)
            {
                sprintProgress[id] = r.Data.TotalTasksCount > 0
                    ? (double)r.Data.CompletedTasksCount / r.Data.TotalTasksCount * 100
                    : 0;
            }
        }
        catch
        {
            sprintProgress[id] = 0;
        }
    }

    private double GetSprintProgress(Guid id)
    {
        return sprintProgress.GetValueOrDefault(id);
    }

    private string GetSprintStatusBadge(string status, bool active)
    {
        if (active)
        {
            return "bg-success";
        }
        return status switch
        {
            "Completed" => "bg-secondary",
            "Cancelled" => "bg-danger",
            _ => "bg-info"
        };
    }

    private string GetSprintStatusText(string status, bool active)
    {
        if (active)
        {
            return "Активен";
        }
        return status switch
        {
            "Completed" => "Завершён",
            "Cancelled" => "Отменён",
            _ => "План"
        };
    }

    private void ShowEditModal()
    {
        editProject = new UpdateProjectRequest
        {
            Name = project?.Name,
            Description = project?.Description
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task UpdateProject()
    {
        try
        {
            var r = await ProjectService.UpdateProjectAsync(ProjectId, editProject);
            if (r.Success)
            {
                CloseEditModal();
                await LoadData();
                await DialogService.AlertAsync("Проект обновлён", "", "", "success");
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private async Task ArchiveProject()
    {
        var ok = await DialogService.ConfirmAsync("Переместить проект в архив?", "Архивирование", "Архивировать", "warning");
        if (!ok)
        {
            return;
        }
        try
        {
            var r = await ProjectService.ArchiveProjectAsync(ProjectId);
            if (r.Success)
            {
                await LoadData();
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private async Task RestoreProject()
    {
        var ok = await DialogService.ConfirmAsync("Восстановить проект?", "Восстановление", "Восстановить", "info");
        if (!ok)
        {
            return;
        }
        try
        {
            var r = await ProjectService.RestoreProjectAsync(ProjectId);
            if (r.Success)
            {
                await LoadData();
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private async Task DeleteProject()
    {
        var ok = await DialogService.ConfirmAsync("Удалить проект навсегда?", "Удаление", "Удалить", "danger");
        if (!ok)
        {
            return;
        }
        try
        {
            var r = await ProjectService.DeleteProjectAsync(ProjectId);
            if (r.Success)
            {
                Navigation.NavigateTo("/projects");
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private void ShowCreateSprintModal()
    {
        newSprint = new CreateSprintRequest
        {
            ProjectId = ProjectId,
            StartDate = DateTime.Now,
            EndDate = DateTime.Now.AddDays(14)
        };
        showCreateSprintModal = true;
    }

    private void CloseCreateSprintModal()
    {
        showCreateSprintModal = false;
    }

    private async Task CreateSprint()
    {
        try
        {
            var r = await SprintService.CreateSprintAsync(newSprint);
            if (r.Success)
            {
                CloseCreateSprintModal();
                await LoadData();
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private async Task DeleteSprint(Guid id, string name)
    {
        var ok = await DialogService.ConfirmAsync($"Удалить спринт «{name}»?", "Удаление", "Удалить", "danger");
        if (!ok)
        {
            return;
        }
        try
        {
            var r = await SprintService.DeleteSprintAsync(id);
            if (r.Success)
            {
                await LoadData();
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message);
            }
        }
        catch
        {
            await ErrorHandling.TriggerError("Ошибка");
        }
    }

    private void OpenSprint(Guid id)
    {
        Navigation.NavigateTo($"/sprints/{id}");
    }

    private void GoToBacklog()
    {
        Navigation.NavigateTo($"/backlog/{ProjectId}");
    }

    private void GoToMembers()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/members");
    }

    private void GoToReports()
    {
        Navigation.NavigateTo($"/reports/{ProjectId}");
    }

    private void GoToActivityLogs()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/logs");
    }

    private void GoToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private void OpenDailyScrum()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/daily-scrum");
    }
}