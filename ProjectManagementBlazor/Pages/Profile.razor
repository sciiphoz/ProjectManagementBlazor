@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject IAuthService AuthService
@inject IUserService UserService
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IErrorHandlingService ErrorHandling
@inject DialogService DialogService

<PageTitle>Личный кабинет</PageTitle>

<div class="profile-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50" role="status"></div>
        </div>
    }
    else if (currentUser != null)
    {
        <!-- Профиль -->
        <div class="profile-header">
            <div class="avatar-circle-lg">@GetInitials(currentUser.FullName)</div>
            <div>
                <h2 class="mb-1">@currentUser.FullName</h2>
                <p class="text-muted mb-0">@currentUser.Email · @currentUser.Role</p>
            </div>
            <button class="btn btn-outline-danger btn-sm ms-auto" @onclick="Logout">
                <i class="bi bi-box-arrow-right me-1"></i> Выйти
            </button>
        </div>

        <!-- Вкладки -->
        <div class="profile-tabs">
            <button class="tab-btn @(activeTab == "profile" ? "active" : "")" @onclick="ShowProfileTab">Профиль</button>
            <button class="tab-btn @(activeTab == "password" ? "active" : "")" @onclick="ShowPasswordTab">Пароль</button>
            <button class="tab-btn @(activeTab == "activity" ? "active" : "")" @onclick="ShowActivityTab">Активность</button>
        </div>

        @if (activeTab == "profile")
        {
            <div class="profile-card">
                <EditForm Model="@profileRequest" OnValidSubmit="UpdateProfile">
                    <div class="mb-3">
                        <label class="form-label small">Имя пользователя</label>
                        <input type="text" class="form-control form-control-sm" value="@currentUser.Username" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Email</label>
                        <InputText type="email" @bind-Value="profileRequest.Email" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Полное имя</label>
                        <InputText @bind-Value="profileRequest.FullName" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Сохранить
                    </button>
                </EditForm>
            </div>
        }
        else if (activeTab == "password")
        {
            <div class="profile-card">
                <EditForm Model="@passwordRequest" OnValidSubmit="ChangePassword">
                    <div class="mb-3">
                        <label class="form-label small">Текущий пароль</label>
                        <InputText type="password" @bind-Value="passwordRequest.CurrentPassword" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Новый пароль</label>
                        <InputText type="password" @bind-Value="passwordRequest.NewPassword" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Подтверждение</label>
                        <InputText type="password" @bind-Value="passwordRequest.ConfirmNewPassword" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-warning btn-sm" disabled="@isSavingPassword">
                        @if (isSavingPassword) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Сменить пароль
                    </button>
                </EditForm>
            </div>
        }
        else if (activeTab == "activity")
        {
            <div class="activity-metrics">
                <div class="activity-card">
                    <span class="activity-value">@totalTasksAssigned</span>
                    <span class="activity-label">Назначено</span>
                </div>
                <div class="activity-card">
                    <span class="activity-value text-warning">@inProgressTasksCount</span>
                    <span class="activity-label">В работе</span>
                </div>
                <div class="activity-card">
                    <span class="activity-value text-success">@completedTasksCount</span>
                    <span class="activity-label">Выполнено</span>
                </div>
            </div>

            <div class="profile-card mt-3">
                <h6 class="mb-2">Мои проекты</h6>
                @if (myProjects.Any())
                {
                    @foreach (var project in myProjects)
                    {
                        <div class="project-chip-row" @onclick="() => GoToProject(project.Id)">
                            <div class="project-chip-icon bg-primary">@project.Name[..Math.Min(1, project.Name.Length)].ToUpper()</div>
                            <span>@project.Name</span>
                            <span class="text-muted small">@GetUserRoleInProject(project.Id)</span>
                            <i class="bi bi-chevron-right text-muted ms-auto"></i>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small">Нет проектов</p>
                }
            </div>
        }
    }
</div>

<style>
    .profile-page { max-width: 500px; margin: 0 auto; }
    .profile-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .avatar-circle-lg { width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-color), #3730A3); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; flex-shrink: 0; }
    .profile-tabs { display: flex; gap: 0.25rem; margin-bottom: 1rem; border-bottom: 2px solid var(--border-color, #E2E8F0); }
    .tab-btn { padding: 0.5rem 0.75rem; border: none; background: none; font-size: 0.85rem; color: var(--text-secondary); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all 0.1s; font-weight: 500; }
    .tab-btn:hover { color: var(--primary-color); }
    .tab-btn.active { color: var(--primary-color); border-bottom-color: var(--primary-color); }
    .profile-card { border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem; }
    .activity-metrics { display: flex; gap: 0.5rem; }
    .activity-card { flex: 1; text-align: center; padding: 1rem; border: 1px solid var(--border-color); border-radius: 0.5rem; }
    .activity-value { font-size: 1.5rem; font-weight: 700; display: block; }
    .activity-label { font-size: 0.7rem; color: var(--text-secondary); }
    .project-chip-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0; cursor: pointer; font-size: 0.85rem; }
    .project-chip-row:hover { color: var(--primary-color); }
    .project-chip-icon { width: 24px; height: 24px; border-radius: 50%; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 700; flex-shrink: 0; }
    [data-bs-theme="dark"] .profile-card, [data-bs-theme="dark"] .activity-card { background: #1E293B; border-color: #334155; }
</style>

@code {
    private UserResponse? currentUser;
    private List<ProjectResponse> myProjects = new();
    private Dictionary<Guid, string> userRoles = new();
    private UpdateProfileRequest profileRequest = new();
    private ChangePasswordRequest passwordRequest = new();
    private string activeTab = "profile";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSavingPassword = false;
    private int totalTasksAssigned = 0, completedTasksCount = 0, inProgressTasksCount = 0;

    protected override async Task OnInitializedAsync() { await LoadUserData(); await LoadProjects(); await LoadStatistics(); isLoading = false; }

    private async Task LoadUserData()
    {
        try { var r = await AuthService.GetCurrentUserAsync(); if (r.Success && r.Data != null) { currentUser = r.Data; profileRequest = new UpdateProfileRequest { Email = currentUser.Email, FullName = currentUser.FullName }; } }
        catch { }
    }

    private async Task LoadProjects()
    {
        try
        {
            var r = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 100 });
            if (r.Success && r.Data != null)
            {
                myProjects = r.Data.Items;
                foreach (var p in myProjects) { var m = await ProjectService.GetProjectMembersAsync(p.Id); if (m.Success && m.Data != null) { var cm = m.Data.FirstOrDefault(x => x.UserId == currentUser?.Id); if (cm != null) userRoles[p.Id] = cm.Role; } }
            }
        }
        catch { }
    }

    private string GetUserRoleInProject(Guid id) => userRoles.GetValueOrDefault(id, "Участник");

    private async Task LoadStatistics()
    {
        try { foreach (var p in myProjects) { var s = await ProjectService.GetProjectStatisticsAsync(p.Id); if (s.Success && s.Data != null) { totalTasksAssigned += s.Data.TotalTasks; completedTasksCount += s.Data.CompletedTasks; inProgressTasksCount += s.Data.InProgressTasks; } } }
        catch { }
    }

    private async Task UpdateProfile()
    {
        isSaving = true;
        try { var r = await UserService.UpdateProfileAsync(profileRequest); if (r.Success) { await LoadUserData(); await DialogService.AlertAsync("Профиль обновлён", "", "bi bi-check-circle", "success"); } else await ErrorHandling.TriggerError(r.Message); }
        catch { await ErrorHandling.TriggerError("Ошибка"); }
        finally { isSaving = false; }
    }

    private async Task ChangePassword()
    {
        isSavingPassword = true;
        try { var r = await UserService.ChangePasswordAsync(passwordRequest); if (r.Success) { passwordRequest = new(); await DialogService.AlertAsync("Пароль изменён", "", "bi bi-shield-check", "success"); } else await ErrorHandling.TriggerError(r.Message); }
        catch { await ErrorHandling.TriggerError("Ошибка"); }
        finally { isSavingPassword = false; }
    }

    private async Task Logout()
    {
        var ok = await DialogService.ConfirmAsync("Выйти из системы?", "Выход", "Выйти", "info");
        if (!ok) return;
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    private void ShowProfileTab() => SetTab("profile");
    private void ShowPasswordTab() => SetTab("password");
    private void ShowActivityTab() => SetTab("activity");

    private void SetTab(string tab) { activeTab = tab; StateHasChanged(); }
    private void GoToProject(Guid id) => Navigation.NavigateTo($"/projects/{id}");
    private string GetInitials(string n) => string.IsNullOrEmpty(n) ? "?" : n.Split(' ')[0][..Math.Min(2, n.Split(' ')[0].Length)].ToUpper();
}