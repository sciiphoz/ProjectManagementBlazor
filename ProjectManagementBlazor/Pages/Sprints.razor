@page "/sprints"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ISprintService SprintService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Спринты</PageTitle>

<div class="sprints-page">
    <div class="sprints-header">
        <div>
            <h2>Спринты</h2>
            <span class="text-muted small">@totalSprintsCount спринтов</span>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="GoToProjects">
            <i class="bi bi-folder2 me-1"></i> Проекты
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50" role="status"></div>
        </div>
    }
    else if (projects != null && projects.Any())
    {
        @foreach (var project in projects)
        {
            @if (projectSprints.ContainsKey(project.Id) && projectSprints[project.Id].Any())
            {
                <div class="project-group">
                    <div class="project-group-header">
                        <div class="project-dot bg-primary"></div>
                        <span class="fw-medium">@project.Name</span>
                        <span class="text-muted small">@projectSprints[project.Id].Count спринтов</span>
                    </div>
                    <div class="sprint-list">
                        @foreach (var sprint in projectSprints[project.Id].OrderByDescending(s => s.StartDate))
                        {
                            <div class="sprint-row @(sprint.IsActive ? "active" : "")" @onclick="() => OpenSprint(sprint.Id)">
                                <div class="sprint-row-left">
                                    <span class="sprint-name">@sprint.Name</span>
                                    <span class="sprint-dates">
                                        <i class="bi bi-calendar-range me-1"></i>
                                        @sprint.StartDate.ToString("dd.MM") — @sprint.EndDate.ToString("dd.MM")
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @GetStatusBadge(sprint.Status, sprint.IsActive)">
                                        @GetStatusText(sprint.Status, sprint.IsActive)
                                    </span>
                                    <i class="bi bi-chevron-right text-muted"></i>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-rocket-takeoff"></i></div>
            <h5>Нет проектов</h5>
            <p class="text-muted">Создайте проект, чтобы начать планировать спринты</p>
            <button class="btn btn-primary btn-sm" @onclick="GoToProjects">
                <i class="bi bi-folder2 me-1"></i> Перейти к проектам
            </button>
        </div>
    }
</div>

<style>
    .sprints-page { max-width: 600px; margin: 0 auto; }
    .sprints-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .sprints-header h2 { font-size: 1.25rem; margin: 0; }
    .project-group { margin-bottom: 1.25rem; }
    .project-group-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.85rem; }
    .project-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .sprint-list { display: flex; flex-direction: column; gap: 0.25rem; }
    .sprint-row { display: flex; align-items: center; justify-content: space-between; padding: 0.625rem 0.75rem; border: 1px solid var(--border-color, #E2E8F0); border-radius: 0.5rem; cursor: pointer; transition: box-shadow 0.1s; }
    .sprint-row:hover { box-shadow: 0 2px 6px rgba(0,0,0,0.04); }
    .sprint-row.active { border-left: 3px solid var(--success-color, #10B981); }
    .sprint-name { font-weight: 500; font-size: 0.85rem; display: block; }
    .sprint-dates { font-size: 0.75rem; color: var(--text-secondary); }
    .empty-state { text-align: center; padding: 3rem 0; }
    .empty-icon { font-size: 3rem; color: var(--text-secondary); opacity: 0.5; margin-bottom: 0.75rem; }

    [data-bs-theme="dark"] .sprint-row { background: #1E293B; border-color: #334155; }
</style>

@code {
    private List<ProjectResponse>? projects;
    private Dictionary<Guid, List<SprintBriefResponse>> projectSprints = new();
    private bool isLoading = true;
    private int totalSprintsCount => projectSprints.Values.Sum(v => v.Count);

    protected override async Task OnInitializedAsync() { await LoadData(); }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var r = await ProjectService.GetUserProjectsAsync(new PagedRequest { PageNumber = 1, PageSize = 50 });
            if (r.Success && r.Data != null)
            {
                projects = r.Data.Items;
                foreach (var p in projects)
                {
                    var s = await SprintService.GetProjectSprintsAsync(p.Id);
                    if (s.Success && s.Data != null) projectSprints[p.Id] = s.Data;
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private string GetStatusBadge(string status, bool active)
    {
        if (active) return "bg-success";
        return status switch { "Completed" => "bg-secondary", "Cancelled" => "bg-danger", _ => "bg-info" };
    }

    private string GetStatusText(string status, bool active)
    {
        if (active) return "Активен";
        return status switch { "Completed" => "Завершён", "Cancelled" => "Отменён", _ => "План" };
    }

    private void OpenSprint(Guid id) => Navigation.NavigateTo($"/sprints/{id}");
    private void GoToProjects() => Navigation.NavigateTo("/projects");
}