@page "/notifications"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Уведомления</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Уведомления</h2>
            <p class="text-muted">История событий и оповещений</p>
        </div>
        <div>
            <button class="btn btn-outline-primary me-2" @onclick="MarkAllAsRead" disabled="@(unreadCount == 0)">
                📖 Отметить все как прочитанные
            </button>
            <button class="btn btn-outline-secondary" @onclick="RefreshData">
                🔄 Обновить
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка уведомлений...</p>
        </div>
    }
    else if (notifications != null && notifications.Items.Any())
    {
        <!-- Статистика -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3>@totalCount</h3>
                        <span>Всего уведомлений</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3 class="text-primary">@unreadCount</h3>
                        <span>Непрочитанных</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h3 class="text-success">@readCount</h3>
                        <span>Прочитанных</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Список уведомлений -->
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">📬 Список уведомлений</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var notification in notifications.Items)
                    {
                        <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-primary")">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2">@GetTypeIcon(notification.Type)</span>
                                        <strong>@notification.Title</strong>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary ms-2">Новое</span>
                                        }
                                    </div>
                                    <p class="mb-1">@notification.Message</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <small class="text-muted">
                                            📅 @notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                        <div>
                                            @if (!notification.IsRead)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-2"
                                                        @onclick="() => MarkAsRead(notification.Id)">
                                                    Отметить прочитанным
                                                </button>
                                            }
                                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        @onclick="() => GoToLink(notification.ActionUrl)">
                                                    Перейти
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Пагинация -->
        @if (totalPages > 1)
        {
            <div class="mt-3 d-flex justify-content-center">
                <nav>
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Назад</button>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Вперед</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <div style="font-size: 64px;">📭</div>
                <h5 class="mt-3">Нет уведомлений</h5>
                <p class="text-muted">Когда появятся новые уведомления, они отобразятся здесь</p>
            </div>
        </div>
    }
</div>

<style>
    .list-group-item-primary {
        background-color: #e7f1ff;
        border-left: 4px solid #0d6efd;
    }

    .list-group-item {
        transition: background-color 0.2s;
    }

        .list-group-item:hover {
            background-color: #f8f9fa;
        }
</style>

@code {
    private PagedResult<NotificationResponse>? notifications;
    private int unreadCount = 0;
    private int readCount = 0;
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadUnreadCount();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var request = new PagedRequest
            {
                PageNumber = currentPage,
                PageSize = pageSize
            };
            var result = await NotificationService.GetUserNotificationsAsync(request);
            if (result.Success && result.Data != null)
            {
                notifications = result.Data;
                totalCount = notifications.TotalCount;
                totalPages = notifications.TotalPages;
                readCount = notifications.Items.Count(n => n.IsRead);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки уведомлений: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Ошибка загрузки уведомлений");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            var result = await NotificationService.GetUnreadCountAsync();
            if (result.Success)
            {
                unreadCount = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки количества: {ex.Message}");
        }
    }

    private async Task MarkAsRead(Guid notificationId)
    {
        try
        {
            var result = await NotificationService.MarkAsReadAsync(notificationId);
            if (result.Success)
            {
                await LoadData();
                await LoadUnreadCount();

                // Уведомляем NavMenu об обновлении счетчика
                await JS.InvokeVoidAsync("updateUnreadCount", unreadCount);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Ошибка при отметке уведомления");
        }
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            var result = await NotificationService.MarkAllAsReadAsync();
            if (result.Success)
            {
                await LoadData();
                await LoadUnreadCount();

                // Уведомляем NavMenu об обновлении счетчика
                await JS.InvokeVoidAsync("updateUnreadCount", unreadCount);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Ошибка при отметке всех уведомлений");
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        await LoadUnreadCount();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadData();
        }
    }

    private void GoToLink(string url)
    {
        Navigation.NavigateTo(url);
    }

    private string GetTypeIcon(string type)
    {
        return type switch
        {
            "Info" => "ℹ️",
            "Success" => "✅",
            "Warning" => "⚠️",
            "Error" => "❌",
            _ => "📌"
        };
    }
}