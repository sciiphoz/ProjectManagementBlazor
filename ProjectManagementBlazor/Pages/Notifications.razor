@page "/notifications"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject INotificationCounterService CounterService

<PageTitle>Уведомления</PageTitle>

<div class="notifications-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (notifications != null && notifications.Items.Any())
    {
        <div class="notif-header">
            <div>
                <h2>Уведомления</h2>
                <span class="text-muted small">@totalCount всего · @unreadCount непрочитанных</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="MarkAllAsRead" disabled="@(unreadCount == 0)">
                    <i class="bi bi-check-all me-1"></i> Прочитать все
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshData">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            </div>
        </div>

        <div class="notif-list">
            @foreach (var n in notifications.Items)
            {
                <div class="notif-item @(n.IsRead ? "" : "unread")" @onclick="() => HandleNotificationClick(n)">
                    <div class="notif-icon @GetIconClass(n.Type)">
                        <i class="bi @GetIcon(n.Type)"></i>
                    </div>
                    <div class="notif-body">
                        <div class="notif-title">
                            <strong>@n.Title</strong>
                            @if (!n.IsRead)
                            {
                                <span class="notif-dot"></span>
                            }
                        </div>
                        <p class="notif-text">@n.Message</p>
                        <span class="notif-time">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    @if (!n.IsRead)
                    {
                        <button class="btn btn-link btn-sm text-muted p-0 notif-mark" @onclick:stopPropagation="true" @onclick="() => MarkAsRead(n.Id)" title="Прочитано">
                            <i class="bi bi-check"></i>
                        </button>
                    }
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-center mt-3">
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <button class="btn btn-outline-secondary @(currentPage == i ? "active" : "")" @onclick="() => GoToPage(i)">@i</button>
                    }
                    <button class="btn btn-outline-secondary" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-bell-slash fs-1 text-muted opacity-50"></i>
            <h5 class="mt-3">Нет уведомлений</h5>
            <p class="text-muted small">Когда появятся новые уведомления, они отобразятся здесь</p>
        </div>
    }
</div>

<style>
    .notifications-page {
        max-width: 600px;
        margin: 0 auto;
    }

    .notif-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .notif-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .notif-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.625rem 0.75rem;
        border: 1px solid var(--border-color, #E2E8F0);
        border-radius: 0.5rem;
        cursor: pointer;
        transition: box-shadow 0.1s;
    }

        .notif-item:hover {
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .notif-item.unread {
            background: rgba(79, 70, 229, 0.03);
            border-left: 3px solid var(--primary-color);
        }

    .notif-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.85rem;
    }

        .notif-icon.info {
            background: rgba(59, 130, 246, 0.1);
            color: #3B82F6;
        }

        .notif-icon.success {
            background: rgba(16, 185, 129, 0.1);
            color: #10B981;
        }

        .notif-icon.warning {
            background: rgba(245, 158, 11, 0.1);
            color: #F59E0B;
        }

        .notif-icon.error {
            background: rgba(239, 68, 68, 0.1);
            color: #EF4444;
        }

    .notif-body {
        flex: 1;
        min-width: 0;
    }

    .notif-title {
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .notif-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--primary-color);
        flex-shrink: 0;
    }

    .notif-text {
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin: 0.125rem 0;
    }

    .notif-time {
        font-size: 0.65rem;
        color: var(--text-secondary);
    }

    .notif-mark {
        opacity: 0;
        transition: opacity 0.1s;
    }

    .notif-item:hover .notif-mark {
        opacity: 1;
    }

    [data-bs-theme="dark"] .notif-item {
        background: #1E293B;
        border-color: #334155;
    }

        [data-bs-theme="dark"] .notif-item.unread {
            background: rgba(129, 140, 248, 0.08);
        }
</style>

@code {
    private PagedResult<NotificationResponse>? notifications;

    private int unreadCount = 0;
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadUnreadCount();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var r = await NotificationService.GetUserNotificationsAsync(new PagedRequest { PageNumber = currentPage, PageSize = pageSize });
            if (r.Success && r.Data != null)
            {
                notifications = r.Data;
                totalCount = notifications.TotalCount;
                totalPages = notifications.TotalPages;
            }
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            var r = await NotificationService.GetUnreadCountAsync();
            if (r.Success) unreadCount = r.Data;
        }
        catch { }
    }

    private async Task HandleNotificationClick(NotificationResponse n)
    {
        if (!n.IsRead)
        {
            await MarkAsRead(n.Id);
        }
        if (!string.IsNullOrEmpty(n.ActionUrl))
        {
            Navigation.NavigateTo(n.ActionUrl);
        }
        else if (n.RelatedEntityId.HasValue && !string.IsNullOrEmpty(n.RelatedEntityType))
        {
            var url = n.RelatedEntityType switch
            {
                "BacklogItem" => $"/sprints/backlog/{n.RelatedEntityId.Value}",
                "Sprint" => $"/sprints/{n.RelatedEntityId.Value}",
                "Project" => $"/projects/{n.RelatedEntityId.Value}",
                _ => null
            };
            if (!string.IsNullOrEmpty(url))
                Navigation.NavigateTo(url);
        }
    }

    private async Task MarkAsRead(Guid id)
    {
        var r = await NotificationService.MarkAsReadAsync(id);
        if (r.Success)
        {
            await LoadData();
            await LoadUnreadCount();
            await CounterService.UpdateUnreadCount(unreadCount);
        }
    }

    private async Task MarkAllAsRead()
    {
        var r = await NotificationService.MarkAllAsReadAsync();
        if (r.Success)
        {
            await LoadData();
            await LoadUnreadCount();
            await CounterService.UpdateUnreadCount(unreadCount);
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        await LoadUnreadCount();
    }

    private async Task GoToPage(int p)
    {
        if (p >= 1 && p <= totalPages)
        {
            currentPage = p;
            await LoadData();
        }
    }

    private string GetIconClass(string type)
    {
        return type switch
        {
            "Success" => "success",
            "Warning" => "warning",
            "Error" => "error",
            _ => "info"
        };
    }

    private string GetIcon(string type)
    {
        return type switch
        {
            "Success" => "bi-check-circle",
            "Warning" => "bi-exclamation-triangle",
            "Error" => "bi-x-circle",
            _ => "bi-info-circle"
        };
    }
}
