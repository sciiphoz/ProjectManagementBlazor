@page "/reports/{ProjectId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IReportService ReportService
@inject IProjectService ProjectService
@inject ISprintService SprintService
@inject IBacklogService BacklogService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Отчёты</PageTitle>

<div class="reports-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (project != null)
    {
        <!-- Заголовок -->
        <div class="reports-header">
            <div>
                <h2>Отчёты</h2>
                <span class="text-muted small">@project.Name</span>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i> К проекту
            </button>
        </div>

        <!-- Табы -->
        <div class="reports-tabs">
            <button class="report-tab @(activeTab == "velocity" ? "active" : "")" @onclick="ShowVelocity">
                <i class="bi bi-graph-up me-1"></i> Velocity
            </button>
            <button class="report-tab @(activeTab == "burndown" ? "active" : "")" @onclick="ShowBurndownTrend">
                <i class="bi bi-graph-down me-1"></i> Burndown
            </button>
            <button class="report-tab @(activeTab == "cycleTime" ? "active" : "")" @onclick="ShowCycleTime">
                <i class="bi bi-clock me-1"></i> Cycle Time
            </button>
        </div>

        <!-- Velocity -->
        @if (activeTab == "velocity")
        {
            @if (isVelocityLoading)
            {
                <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-info"></div></div>
            }
            else if (velocityReport?.SprintHistory?.Any() == true)
            {
                <div class="chart-card">
                    <div style="position: relative; height: 350px;"><canvas id="velocityChart"></canvas></div>
                </div>
                <div class="report-metrics">
                    <div class="report-metric">
                        <span class="metric-value text-primary">@velocityReport.AverageVelocity.ToString("F1")</span>
                        <span class="metric-label">Средняя</span>
                    </div>
                    <div class="report-metric">
                        <span class="metric-value text-success">@velocityReport.MaxVelocity</span>
                        <span class="metric-label">Максимум</span>
                    </div>
                    <div class="report-metric">
                        <span class="metric-value text-danger">@velocityReport.MinVelocity</span>
                        <span class="metric-label">Минимум</span>
                    </div>
                    <div class="report-metric">
                        <span class="metric-value @(velocityReport.VelocityTrend >= 0 ? "text-success" : "text-danger")">
                            @(velocityReport.VelocityTrend >= 0 ? "+" : "")@velocityReport.VelocityTrend.ToString("F1")%
                        </span>
                        <span class="metric-label">Тренд</span>
                    </div>
                </div>
                <div class="table-mini">
                    @foreach (var s in velocityReport.SprintHistory)
                    {
                        <div class="table-mini-row">
                            <span>@s.SprintName</span>
                            <span class="text-muted small">@s.EndDate.ToString("dd.MM.yy")</span>
                            <span>@s.CompletedStoryPoints / @s.TotalStoryPoints SP</span>
                            <span class="fw-medium">@s.Velocity</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">Нет данных. Завершите хотя бы один спринт.</div>
            }
        }

        <!-- Burndown -->
        @if (activeTab == "burndown")
        {
            @if (isBurndownTrendLoading)
            {
                <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-info"></div></div>
            }
            else if (sprintBurndownComparison?.Any() == true)
            {
                <div class="chart-card">
                    <div style="position: relative; height: 350px;"><canvas id="burndownTrendChart"></canvas></div>
                </div>
                <div class="table-mini">
                    @foreach (var s in sprintBurndownComparison)
                    {
                        var dev = s.CompletionPercentage - s.IdealCompletionPercentage;
                        <div class="table-mini-row">
                            <span>@s.SprintName</span>
                            <span class="text-muted small">@s.StartDate.ToString("dd.MM")–@s.EndDate.ToString("dd.MM")</span>
                            <div class="progress" style="width:80px;height:6px"><div class="progress-bar @(s.CompletionPercentage >= 80 ? "bg-success" : s.CompletionPercentage >= 50 ? "bg-warning" : "bg-danger")" style="width:@s.CompletionPercentage%"></div></div>
                            <span>@s.CompletionPercentage.ToString("F0")%</span>
                            <span class="@(dev >= 0 ? "text-success" : "text-danger")">@(dev >= 0 ? "+" : "")@dev.ToString("F0")%</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">Нет данных.</div>
            }
        }

        <!-- Cycle Time -->
        @if (activeTab == "cycleTime")
        {
            @if (isCycleTimeLoading)
            {
                <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-info"></div></div>
            }
            else if (cycleTimeData?.Any() == true)
            {
                <div class="report-metrics">
                    <div class="report-metric">
                        <span class="metric-value text-primary">@cycleTimeData.Average(t => t.CycleDays).ToString("F1") дн.</span>
                        <span class="metric-label">Среднее</span>
                    </div>
                    <div class="report-metric">
                        <span class="metric-value">@GetMedian(cycleTimeData.Select(t => t.CycleDays)).ToString("F1") дн.</span>
                        <span class="metric-label">Медиана</span>
                    </div>
                    <div class="report-metric">
                        <span class="metric-value text-success">@cycleTimeData.Count</span>
                        <span class="metric-label">Задач</span>
                    </div>
                </div>
                <div class="table-mini">
                    @foreach (var t in cycleTimeData.OrderByDescending(t => t.CycleDays))
                    {
                        <div class="table-mini-row">
                            <span>@t.Title</span>
                            <span class="badge @GetTypeBadgeClass(t.Type)">@GetTypeName(t.Type)</span>
                            <span class="text-muted small">@t.StartedAt.ToString("dd.MM")–@t.CompletedAt.ToString("dd.MM")</span>
                            <span class="fw-medium @(t.CycleDays <= 2 ? "text-success" : t.CycleDays <= 5 ? "text-warning" : "text-danger")">@t.CycleDays дн.</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">Нет завершённых задач.</div>
            }
        }
    }
    else
    {
        <div class="text-center py-4 text-muted">Проект не найден</div>
    }
</div>

<style>
    .reports-page {
        max-width: 800px;
        margin: 0 auto;
    }

    .reports-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .reports-header h2 {
            font-size: 1.25rem;
            margin: 0;
        }

    .reports-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid var(--border-color,#E2E8F0);
        margin-bottom: 1rem;
    }

    .report-tab {
        padding: 0.5rem 0.75rem;
        border: none;
        background: none;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-secondary);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
    }

        .report-tab:hover {
            color: var(--primary-color);
        }

        .report-tab.active {
            color: var(--primary-color);
            border-bottom-color: var(--primary-color);
        }

    .chart-card {
        background: #fff;
        border: 1px solid var(--border-color,#E2E8F0);
        border-radius: 0.5rem;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .report-metrics {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .report-metric {
        flex: 1;
        text-align: center;
        padding: 0.5rem;
        border: 1px solid var(--border-color,#E2E8F0);
        border-radius: 0.375rem;
    }

    .metric-value {
        font-size: 1.25rem;
        font-weight: 700;
        display: block;
    }

    .metric-label {
        font-size: 0.65rem;
        color: var(--text-secondary);
    }

    .table-mini {
        border: 1px solid var(--border-color,#E2E8F0);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .table-mini-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border-color,#E2E8F0);
        font-size: 0.8rem;
    }

        .table-mini-row:last-child {
            border-bottom: none;
        }

    [data-bs-theme="dark"] .chart-card, [data-bs-theme="dark"] .report-metric, [data-bs-theme="dark"] .table-mini {
        background: #1E293B;
        border-color: #334155;
    }

    [data-bs-theme="dark"] .table-mini-row {
        border-color: #334155;
    }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectResponse? project;
    private string activeTab = "velocity";
    private bool isLoading = true;
    private bool velocityChartDrawn = false;

    private VelocityReportResponse? velocityReport;
    private bool isVelocityLoading = false;

    private List<SprintBurndownComparison>? sprintBurndownComparison;
    private bool isBurndownTrendLoading = false;
    private bool burndownTrendChartDrawn = false;

    private List<CycleTimeItem>? cycleTimeData;
    private bool isCycleTimeLoading = false;

    protected override async Task OnInitializedAsync() { await LoadData(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activeTab == "velocity" && velocityReport?.SprintHistory?.Any() == true && !velocityChartDrawn)
        {
            velocityChartDrawn = true;
            await Task.Delay(200);
            await JS.InvokeVoidAsync("drawVelocityChart", velocityReport.SprintHistory);
        }
        if (activeTab == "burndown" && sprintBurndownComparison?.Any() == true && !burndownTrendChartDrawn)
        {
            burndownTrendChartDrawn = true;
            await Task.Delay(200);
            await JS.InvokeVoidAsync("drawBurndownTrendChart", sprintBurndownComparison);
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var pr = await ProjectService.GetProjectByIdAsync(ProjectId);
            if (pr.Success && pr.Data != null) project = pr.Data;
            else { Navigation.NavigateTo("/projects"); return; }
            await LoadVelocityReport();
        }
        catch { }
        finally { isLoading = false; }
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "velocity") velocityChartDrawn = false;
        else if (tab == "burndown") burndownTrendChartDrawn = false;
        StateHasChanged();
        if (tab == "velocity" && velocityReport == null) _ = LoadVelocityReport();
        else if (tab == "burndown" && sprintBurndownComparison == null) _ = LoadBurndownTrend();
        else if (tab == "cycleTime" && cycleTimeData == null) _ = LoadCycleTimeReport();
    }

    private async Task LoadVelocityReport()
    {
        isVelocityLoading = true; StateHasChanged();
        var r = await ReportService.GenerateVelocityReportAsync(ProjectId);
        if (r.Success && r.Data?.SprintHistory?.Any() == true) { velocityReport = r.Data; velocityChartDrawn = false; }
        isVelocityLoading = false; StateHasChanged();
    }

    private async Task LoadBurndownTrend()
    {
        isBurndownTrendLoading = true; StateHasChanged();
        var sr = await SprintService.GetProjectSprintsAsync(ProjectId);
        if (sr.Success && sr.Data != null)
        {
            var completed = sr.Data.Where(s => s.Status == "Completed").OrderByDescending(s => s.EndDate).Take(5).ToList();
            sprintBurndownComparison = new();
            foreach (var s in completed)
            {
                var d = await SprintService.GetSprintBoardAsync(s.Id);
                if (d.Success && d.Data != null)
                {
                    var td = (s.EndDate - s.StartDate).Days;
                    sprintBurndownComparison.Add(new SprintBurndownComparison
                    {
                        SprintName = s.Name,
                        StartDate = s.StartDate,
                        EndDate = s.EndDate,
                        TotalSP = d.Data.TotalStoryPoints ?? 0,
                        CompletedSP = d.Data.CompletedStoryPoints ?? 0,
                        TotalTasks = d.Data.TotalTasksCount,
                        CompletedTasks = d.Data.CompletedTasksCount,
                        CompletionPercentage = d.Data.CompletionPercentage,
                        IdealCompletionPercentage = td > 0 ? Math.Min(100, (double)Math.Min(td, (DateTime.Now - s.StartDate).Days) / td * 100) : 100
                    });
                }
            }
            burndownTrendChartDrawn = false;
        }
        isBurndownTrendLoading = false; StateHasChanged();
    }

    private async Task LoadCycleTimeReport()
    {
        isCycleTimeLoading = true; StateHasChanged();
        var sr = await SprintService.GetProjectSprintsAsync(ProjectId);
        if (sr.Success && sr.Data != null)
        {
            cycleTimeData = new();
            foreach (var s in sr.Data.Where(s => s.Status is "Completed" or "Active").OrderByDescending(s => s.EndDate).Take(5))
            {
                var sd = await SprintService.GetSprintBoardAsync(s.Id);
                if (sd.Success && sd.Data != null)
                {
                    foreach (var t in sd.Data.Tasks.Where(t => t.Status == "Done"))
                    {
                        var d = await BacklogService.GetBacklogItemDetailAsync(t.Id);
                        if (d.Success && d.Data != null)
                        {
                            var start = d.Data.SubTasks?.Where(st => st.Status == "Done" && st.StartedAt.HasValue).MinBy(st => st.StartedAt)?.StartedAt ?? d.Data.UpdatedAt ?? d.Data.CreatedAt;
                            var end = d.Data.SubTasks?.Where(st => st.Status == "Done" && st.CompletedAt.HasValue).MaxBy(st => st.CompletedAt)?.CompletedAt ?? d.Data.UpdatedAt ?? DateTime.UtcNow;
                            cycleTimeData.Add(new CycleTimeItem { Id = t.Id, Title = t.Title, Type = t.Type, SprintName = s.Name, AssigneeName = t.Assignee?.FullName, StartedAt = start, CompletedAt = end, CycleDays = Math.Round((end - start).TotalDays, 1) });
                        }
                    }
                }
            }
        }
        isCycleTimeLoading = false; StateHasChanged();
    }

    private double GetMedian(IEnumerable<double> v) { var s = v.OrderBy(x => x).ToList(); return s.Any() ? (s.Count % 2 == 0 ? (s[s.Count / 2 - 1] + s[s.Count / 2]) / 2.0 : s[s.Count / 2]) : 0; }
    private string GetTypeBadgeClass(string t) => t switch { "UserStory" => "bg-primary", "Bug" => "bg-danger", "TechnicalTask" => "bg-warning text-dark", "Improvement" => "bg-success", _ => "bg-secondary" };
    private string GetTypeName(string t) => t switch { "UserStory" => "Story", "Bug" => "Bug", "TechnicalTask" => "Task", "Improvement" => "Impr", _ => t };

    private void ShowVelocity() => SwitchTab("velocity");
    private void ShowBurndownTrend() => SwitchTab("burndown");
    private void ShowCycleTime() => SwitchTab("cycleTime");
    private void GoBack() => Navigation.NavigateTo($"/projects/{ProjectId}");

    public class SprintBurndownComparison
    {
        public string SprintName { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public decimal TotalSP { get; set; }
        public decimal CompletedSP { get; set; }
        public int TotalTasks { get; set; }
        public int CompletedTasks { get; set; }
        public double CompletionPercentage { get; set; }
        public double IdealCompletionPercentage { get; set; }
    }

    public class CycleTimeItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string Type { get; set; } = "";
        public string SprintName { get; set; } = "";
        public string? AssigneeName { get; set; }
        public DateTime StartedAt { get; set; }
        public DateTime CompletedAt { get; set; }
        public double CycleDays { get; set; }
    }
}