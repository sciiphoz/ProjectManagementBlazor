    private async Task DrawGanttChart()
    {
        if (sprint?.Tasks == null)
        {
            return;
        }
        isGanttLoading = true;
        StateHasChanged();
        var tasks = sprint.Tasks
            .Where(t => t.Status != "Backlog")
            .OrderBy(t => t.Status == "Done" ? 2 : t.Status == "InProgress" ? 1 : 0)
            .ThenBy(t => t.Title)
            .Select(t => new
            {
                id = t.Id.ToString(),
                title = t.Title.Length > 50 ? t.Title[..47] + "..." : t.Title,
                fullTitle = t.Title,
                status = t.Status,
                storyPoints = t.StoryPoints,
                estimatedHours = t.EstimatedHours,
                assignee = t.Assignee?.FullName ?? "Не назначен",
                startDate = GetTaskStartDate(t),
                endDate = GetTaskEndDate(t)
            }).ToList();
        await JS.InvokeVoidAsync("drawGanttChart", tasks, sprint.StartDate.ToString("yyyy-MM-dd"), sprint.EndDate.ToString("yyyy-MM-dd"));
        isGanttLoading = false;
        StateHasChanged();
    }

    private DateTime GetTaskStartDate(BacklogItemBoardResponse t)
    {
        var d = (sprint!.EndDate - sprint.StartDate).Days;
        return t.Status switch
        {
            "Done" => sprint.StartDate.AddDays(d * 0.1),
            "InProgress" => sprint.StartDate.AddDays(d * 0.2),
            "ToDo" => sprint.StartDate.AddDays(d * 0.5),
            _ => sprint.StartDate
        };
    }

    private DateTime GetTaskEndDate(BacklogItemBoardResponse t)
    {
        var d = (sprint!.EndDate - sprint.StartDate).Days;
        return t.Status switch
        {
            "Done" => sprint.EndDate.AddDays(-d * 0.1),
            "InProgress" => sprint.EndDate.AddDays(-d * 0.05),
            "ToDo" => sprint.EndDate.AddDays(-d * 0.1),
            _ => sprint.EndDate
        };
    }

