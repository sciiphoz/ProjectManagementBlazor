            await SubscribeToTask(id);

        if (_hubConnection?.State == HubConnectionState.Connected)
        {
            await _hubConnection.InvokeAsync("SubscribeToSprint", SprintId.ToString());
            await _hubConnection.InvokeAsync("SubscribeToTask", id.ToString());
        }

        if (!forceReload && taskDetail?.Id == id)
        {
            selectedTask = sprint?.Tasks.FirstOrDefault(t => t.Id == id);
            selectedStatus = selectedTask?.Status ?? "ToDo";
            StateHasChanged();
            return;
        }

        isTaskDetailLoading = true;
        StateHasChanged();

        taskDetail = null;

        var r = await BacklogService.GetBacklogItemDetailAsync(id);
        if (r.Success && r.Data != null)
        {
            taskDetail = r.Data;
            selectedTask = sprint?.Tasks.FirstOrDefault(t => t.Id == id);
            selectedStatus = selectedTask?.Status ?? "ToDo";
        }

        isTaskDetailLoading = false;
        StateHasChanged();
    }

