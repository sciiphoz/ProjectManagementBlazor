@code {
    [Parameter] public Guid SprintId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private Guid? currentUserId;
    private string taskDetailTab = "info";
    private string activeView = "board";
    private Guid? editingCommentId;
    private string editCommentText = "";
    private string newCommentText = "";
    private string newSubTaskTitle = "";
    private double? newSubTaskHours = null;
    private string newBlockerDescription = "";
    private string newBlockerSeverity = "Medium";
    private bool isAddingComment = false;
    private List<BurndownPoint>? burndownData;
    private bool isBurndownLoading = false;
    private bool isGanttLoading = false;
    private SprintBoardResponse? sprint;
    private BacklogItemDetailResponse? taskDetail;
    private BacklogItemBoardResponse? selectedTask;
    private BacklogItemBoardResponse? draggedTask;
    private string selectedStatus = "ToDo";
    private bool isLoading = true;
    private bool showCompleteModal = false;
    private bool isViewer = false;
    private bool isScrumMaster = false;
    private bool isProductOwner = false;
    private string currentUserRole = "";
    private CompleteSprintRequest completeRequest = new();
    private bool isTaskDetailLoading = false;
    private bool isUpdating = false;
    private IBrowserFile? selectedFile = null;
    private bool isUploading = false;
    private bool IsDeveloper => currentUserRole == "Developer";
    private string selectedDeveloperId = "";
    private List<DeveloperInfo> availableDevelopers = new();
    private HubConnection? _hubConnection;
    private bool hasOtherActiveSprint = false;

    private string GetPriorityClass(int? p)
    {
        if (p == null)
        {
            return "";
        }
        return p switch
        {
            <= 3 => "priority-high",
            <= 6 => "priority-medium",
            _ => "priority-low"
        };
    }

    private string GetTypeBadge(string t)
    {
        return t switch
        {
            "UserStory" => "bg-primary",
            "Bug" => "bg-danger",
            "TechnicalTask" => "bg-warning text-dark",
            "Improvement" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetBlockerSeverityBadge(string s)
    {
        return s switch
        {
            "Critical" => "bg-danger",
            "High" => "bg-warning text-dark",
            "Medium" => "bg-info",
            _ => "bg-secondary"
        };
    }

    private void ShowInfoTab()
    {
        taskDetailTab = "info";
        StateHasChanged();
    }

    private void ShowSubtasksTab()
    {
        taskDetailTab = "subtasks";
        StateHasChanged();
    }

    private void ShowCommentsTab()
    {
        taskDetailTab = "comments";
        StateHasChanged();
    }

    private void ShowBlockersTab()
    {
        taskDetailTab = "blockers";
        StateHasChanged();
    }

    private async void ShowBoardTab()
    {
        activeView = "board";
        StateHasChanged();

        if (_hubConnection?.State == HubConnectionState.Connected)
        {
            await _hubConnection.InvokeAsync("SubscribeToSprint", SprintId.ToString());
        }
    }

    private void ShowBurndownTab()
    {
        activeView = "burndown";
        StateHasChanged();
        ShowBurndown();
    }

    private void ShowGanttTab()
    {
        activeView = "gantt";
        StateHasChanged();
        ShowGantt();
    }

    private bool CanModifyTask(BacklogItemBoardResponse t)
    {
        if (isViewer) return false;
        if (t == null || currentUserId == null) return false;

        if (IsDeveloper && t.Assignee?.Id == currentUserId) return true;

        if (IsScrumMaster && t.Status == "Review") return true;

        return false;
    }

    private bool IsProductOwner
    {
        get
        {
            return sprint?.ProjectOwnerId == currentUserId || currentUserRole == "ProductOwner";
        }
    }

    private void ShowAttachmentsTab()
    {
        taskDetailTab = "attachments";
        StateHasChanged();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null || selectedTask == null) return;
        isUploading = true;
        try
        {
            var buffer = new byte[selectedFile.Size];
            await selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);
            var r = await BacklogService.UploadAttachmentAsync(selectedTask.Id, new UploadAttachmentRequest
            {
                FileContent = buffer,
                FileName = selectedFile.Name,
                MimeType = selectedFile.ContentType
            });
            if (r.Success)
            {
                selectedFile = null;
                await OpenTaskDetail(selectedTask.Id, forceReload: true);
            }
            else
            {
                await ErrorHandling.TriggerError(r.Message ?? "Ошибка загрузки файла");
            }
        }
        catch (Exception ex)
        {
            await ErrorHandling.TriggerError($"Ошибка: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DownloadAttachment(Guid attachmentId)
    {
        try
        {
            var attachment = taskDetail?.Attachments?.FirstOrDefault(a => a.Id == attachmentId);
            var fileName = attachment?.FileName ?? $"attachment_{attachmentId}";

            var data = await BacklogService.DownloadAttachmentAsync(attachmentId);
            if (data != null && data.Length > 0)
            {
                var base64 = Convert.ToBase64String(data);
                var mimeType = attachment?.MimeType ?? "application/octet-stream";
                await JS.InvokeVoidAsync("triggerDownload", fileName, base64, mimeType);
            }
            else
            {
                await ErrorHandling.TriggerError("Файл не найден на сервере");
            }
        }
        catch (Exception ex)
        {
            await ErrorHandling.TriggerError($"Ошибка скачивания: {ex.Message}");
        }
    }

    private async Task DeleteAttachment(Guid attachmentId)
    {
        var ok = await DialogService.ConfirmAsync("Удалить вложение?", "Удаление", "Удалить", "danger");
        if (!ok) return;
        var r = await BacklogService.DeleteAttachmentAsync(attachmentId);
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message ?? "Ошибка удаления");
        }
    }

    private string GetAttachmentIcon(string mimeType)
    {
        if (string.IsNullOrEmpty(mimeType)) return "bi-file";
        if (mimeType.StartsWith("image/")) return "bi-file-image";
        if (mimeType.Contains("pdf")) return "bi-file-pdf";
        if (mimeType.Contains("word") || mimeType.Contains("document")) return "bi-file-word";
        if (mimeType.Contains("sheet") || mimeType.Contains("excel")) return "bi-file-excel";
        if (mimeType.StartsWith("text/")) return "bi-file-text";
        if (mimeType.StartsWith("zip") || mimeType.Contains("compressed")) return "bi-file-zip";
        return "bi-file";
    }

    private bool IsScrumMaster
    {
        get
        {
            return currentUserRole == "ScrumMaster";
        }
    }

    private void OnDragStart(BacklogItemBoardResponse t)
    {
        if (isViewer)
        {
            return;
        }
        draggedTask = t;
    }

    private void OnDragEnd()
    {
        draggedTask = null;
    }

    private void OnDragOver()
    {
    }

    private bool CanDragToStatus(string currentStatus, string targetStatus)
    {
        if (IsDeveloper)
        {
            if (targetStatus == "Done") return false;
            if (targetStatus == "Review" && draggedTask != null)
            {
                var hasBlockers = draggedTask.HasBlockers;
                var incompleteSubtasks = draggedTask.SubTasksCount > draggedTask.CompletedSubTasksCount;
                return !hasBlockers && !incompleteSubtasks;
            }
            return true;
        }

        if (IsScrumMaster)
            return currentStatus == "Review" && targetStatus == "Done";

        return false;
    }

    private async Task OnDropTo(string status)
    {
        if (isViewer || isUpdating) return;
        if (draggedTask == null || draggedTask.Status == status)
        {
            draggedTask = null;
            return;
        }

        if (!CanDragToStatus(draggedTask.Status, status))
        {
            draggedTask = null;
            return;
        }

        if (IsDeveloper && status == "Review")
        {
            if (draggedTask.HasBlockers)
            {
                await DialogService.AlertAsync(
                    "Нельзя отправить на проверку задачу с активными блокерами. Сначала разрешите блокеры.",
                    "Действие запрещено", "", "warning");
                draggedTask = null;
                return;
            }
            if (draggedTask.SubTasksCount > draggedTask.CompletedSubTasksCount)
            {
                await DialogService.AlertAsync(
                    "Нельзя отправить на проверку задачу с незавершёнными подзадачами. Сначала завершите все подзадачи.",
                    "Действие запрещено", "", "warning");
                draggedTask = null;
                return;
            }
        }

        isUpdating = true;
        var taskId = draggedTask.Id;
        draggedTask = null;

        try
        {
            var r = await SprintService.UpdateTaskStatusAsync(taskId, status);
            if (r.Success) await LoadSprint();
            else await InvokeAsync(async () =>
            {
                await DialogService.AlertAsync(r.Message ?? "Не удалось изменить статус", "Ошибка", "", "danger");
            });
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task NotifyScrumMaster(Guid scrumMasterId, Guid taskId)
    {
        try
        {
            var task = sprint?.Tasks.FirstOrDefault(t => t.Id == taskId);
            if (task == null) return;

            var developerName = "Разработчик";
            if (currentUserId != null)
            {
                var members = await ProjectService.GetProjectMembersAsync(sprint!.ProjectId);
                if (members.Success && members.Data != null)
                {
                    var dev = members.Data.FirstOrDefault(m => m.UserId == currentUserId.Value);
                    if (dev != null) developerName = dev.FullName;
                }
            }

            await BacklogService.AddCommentAsync(taskId, new AddCommentRequest
            {
                Content = $"🔔 Задача «{task.Title}» перемещена в статус «На проверке» исполнителем {developerName}."
            });
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadSprint();
        await CheckViewerRole();
        await InitializeSignalR();

        if (_hubConnection?.State == HubConnectionState.Connected)
        {
            await _hubConnection.InvokeAsync("SubscribeToSprint", SprintId.ToString());
        }
    }

    private async Task InitializeSignalR()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl("https://localhost:7254/hubs/comments")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<CommentResponse>("CommentAdded", (comment) =>
        {
            if (taskDetail != null && comment.BacklogItemId == taskDetail.Id)
            {
                taskDetail.Comments ??= new();
                if (!taskDetail.Comments.Any(c => c.Id == comment.Id))
                {
                    taskDetail.Comments.Add(comment);
                    InvokeAsync(StateHasChanged);
                }
            }
        });

        _hubConnection.On<BacklogItemBoardResponse>("TaskStatusUpdated", (updatedTask) =>
        {
            if (sprint?.Tasks == null) return;

            var idx = sprint.Tasks.FindIndex(t => t.Id == updatedTask.Id);
            if (idx >= 0)
            {
                sprint.Tasks[idx] = updatedTask;
            }
            else
            {
                sprint.Tasks.Add(updatedTask);
            }

            sprint.TotalTasksCount = sprint.Tasks.Count;
            sprint.CompletedTasksCount = sprint.Tasks.Count(t => t.Status == "Done");
            var totalSP = sprint.Tasks.Sum(t => t.StoryPoints) ?? 0;
            var completedSP = sprint.Tasks.Where(t => t.Status == "Done").Sum(t => t.StoryPoints) ?? 0;
            sprint.TotalStoryPoints = totalSP;
            sprint.CompletedStoryPoints = completedSP;
            sprint.CompletionPercentage = sprint.TotalTasksCount > 0
                ? (double)sprint.CompletedTasksCount / sprint.TotalTasksCount * 100
                : 0;

            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR не подключён: {ex.Message}");
        }
    }

