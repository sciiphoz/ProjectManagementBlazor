@page "/sprints/{SprintId:guid}"
@page "/sprints/{SprintId:guid}/{TaskId:guid}"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject ISprintService SprintService
@inject IBacklogService BacklogService
@inject ISubTaskService SubTaskService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IErrorHandlingService ErrorHandling
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>@(sprint?.Name ?? "Доска")</PageTitle>

<div class="sprint-page">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary opacity-50"></div>
        </div>
    }
    else if (sprint != null)
    {
        <div class="sprint-topbar">
            <div class="d-flex align-items-center gap-3">
                <a @onclick="GoToProject" class="text-muted small cursor-pointer" title="К проекту">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h5 class="mb-0">@sprint.Name</h5>
                    <div class="small text-muted">@sprint.StartDate.ToString("dd.MM") — @sprint.EndDate.ToString("dd.MM") · @sprint.DaysRemaining дн.</div>
                </div>
                @if (sprint.IsActive)
                {
                    <span class="badge bg-success">Активен</span>
                }
                else if (sprint.Status == "Completed")
                {
                    <span class="badge bg-secondary">Завершён</span>
                }
                else
                {
                    <span class="badge bg-info">План</span>
                }
            </div>
            <div class="d-flex gap-1">
                @if (!isViewer)
                {
                    if (!sprint.IsActive && sprint.Status != "Completed" && (IsScrumMaster || IsProductOwner))
                    {
                        <button class="btn btn-success btn-sm" @onclick="StartSprint" disabled="@hasOtherActiveSprint">
                            <i class="bi bi-play-fill me-1"></i> Запустить
                        </button>
                    }
                    if (sprint.IsActive && (IsScrumMaster || IsProductOwner))
                    {
                        <button class="btn btn-warning btn-sm" @onclick="ShowCompleteModal">
                            <i class="bi bi-check2 me-1"></i> Завершить
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="CancelSprint">
                            <i class="bi bi-x me-1"></i> Отменить
                        </button>
                    }
                    @if (sprint.Status == "Completed")
                    {
                        <button class="btn btn-outline-info btn-sm" @onclick="GoToRetrospective">
                            <i class="bi bi-people me-1"></i> Ретроспектива
                        </button>
                    }
                }
            </div>
        </div>

        <div class="sprint-tabs">
            <button class="sprint-tab @(activeView == "board" ? "active" : "")" @onclick="ShowBoardTab">
                <i class="bi bi-kanban me-1"></i> Доска
            </button>
            <button class="sprint-tab @(activeView == "burndown" ? "active" : "")" @onclick="ShowBurndownTab">
                <i class="bi bi-graph-up me-1"></i> Сгорание задач
            </button>
            <button class="sprint-tab @(activeView == "gantt" ? "active" : "")" @onclick="ShowGanttTab">
                <i class="bi bi-bar-chart-steps me-1"></i> Диаграмма Ганта
            </button>
            <div class="ms-auto small text-muted d-flex align-items-center gap-3">
                <span>@sprint.CompletedStoryPoints / @sprint.TotalStoryPoints SP</span>
                <span>@sprint.CompletedTasksCount / @sprint.TotalTasksCount задач</span>
                <div class="progress" style="width:80px;height:6px">
                    <div class="progress-bar bg-success" style="width:@((int)sprint.CompletionPercentage)%"></div>
                </div>
                <span>@((int)sprint.CompletionPercentage)%</span>
            </div>
        </div>

        @if (activeView == "board")
        {
            <div class="board-container">
                @foreach (var col in new[] { ("Backlog", "Бэклог", "bg-secondary"), ("ToDo", "К работе", "bg-info"), ("InProgress", "В работе", "bg-warning text-dark"), ("Review", "На проверке", "bg-purple text-white"), ("Done", "Сделано", "bg-success") })
                {
                    var (status, title, badge) = col;
                    var isDropZone = !(IsDeveloper && status == "Done") && !IsProductOwner;
                    <div class="board-col">
                        <div class="board-col-header">
                            <span>@title</span>
                            <span class="board-col-count">@sprint.Tasks.Count(t => t.Status == status)</span>
                        </div>
                        <div class="board-col-body @(isDropZone ? "drop-zone" : "")"
                             @ondragover="OnDragOver"
                             @ondrop="() => OnDropTo(status)">
                            @foreach (var task in sprint.Tasks.Where(t => t.Status == status))
                            {
                                <div class="task-card @GetPriorityClass(task.Priority)"
                                     draggable="@(CanModifyTask(task) && !(IsDeveloper && task.Status == "Done") ? "true" : "false")"
                                     @ondragstart="() => OnDragStart(task)" @ondragend="OnDragEnd"
                                     @onclick="() => OpenTaskDetail(task.Id)">
                                    <div class="task-card-body">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="badge @badge small">@GetTypeName(task.Type)</span>
                                            <span class="text-muted small">@task.StoryPoints</span>
                                        </div>
                                        <div class="fw-medium small mb-1">@task.Title</div>
                                        @if (task.Assignee != null)
                                        {
                                            <div class="text-muted smallest">@task.Assignee.FullName</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeView == "burndown")
        {
            <div class="chart-panel">
                @if (isBurndownLoading)
                {
                    <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-info"></div></div>
                }
                else if (burndownData?.Any() == true)
                {
                    <div style="position:relative;height:400px"><canvas id="burndownChart"></canvas></div>
                }
                else
                {
                    <div class="text-center py-5 text-muted"><i class="bi bi-graph-up fs-1 opacity-25"></i><p class="mt-2">Нет данных</p></div>
                }
            </div>
        }
        else if (activeView == "gantt")
        {
            <div class="chart-panel">
                @if (isGanttLoading)
                {
                    <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-info"></div></div>
                }
                else if (sprint?.Tasks?.Any(t => t.Status != "Backlog") == true)
                {
                    <div style="position:relative;height:400px"><canvas id="ganttChart"></canvas></div>
                }
                else
                {
                    <div class="text-center py-5 text-muted"><i class="bi bi-bar-chart-steps fs-1 opacity-25"></i><p class="mt-2">Нет задач</p></div>
                }
            </div>
        }
    }

    @if (showCompleteModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-warning"><h6 class="modal-title">Завершение спринта</h6><button type="button" class="btn-close" @onclick="CloseCompleteModal"></button></div>
                    <div class="modal-body">
                        <p>Завершить «<strong>@sprint?.Name</strong>»?</p>
                        <div class="mb-2"><label class="form-label small">Заметки обзора</label><textarea @bind="completeRequest.ReviewNotes" class="form-control form-control-sm" rows="2"></textarea></div>
                        <div class="mb-2"><label class="form-label small">Заметки ретроспективы</label><textarea @bind="completeRequest.RetrospectiveNotes" class="form-control form-control-sm" rows="2"></textarea></div>
                    </div>
                    <div class="modal-footer"><button class="btn btn-secondary btn-sm" @onclick="CloseCompleteModal">Отмена</button><button class="btn btn-warning btn-sm" @onclick="CompleteSprint">Завершить</button></div>
                </div>
            </div>
        </div>
    }

    @if (selectedTask != null && taskDetail != null)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <div><h5 class="modal-title">@selectedTask.Title</h5><div class="d-flex gap-2 mt-1"><span class="badge @GetTypeBadge(selectedTask.Type)">@GetTypeName(selectedTask.Type)</span><span class="badge bg-light text-dark">@selectedTask.StoryPoints SP</span></div></div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseTaskDetail"></button>
                    </div>
                    <div class="modal-body p-0">
                        <ul class="nav nav-tabs px-3 pt-2 flex-nowrap task-tabs">
                            <li class="nav-item">
                                <button class="nav-link @(taskDetailTab == "info" ? "active" : "")" @onclick="ShowInfoTab">
                                    <i class="bi bi-info-circle me-1"></i>Описание
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(taskDetailTab == "subtasks" ? "active" : "")" @onclick="ShowSubtasksTab">
                                    <i class="bi bi-list-check me-1"></i>Подзадачи
                                    @if (taskDetail?.SubTasks?.Any() == true)
                                    {
                                        <span class="tab-badge">@taskDetail.SubTasks.Count</span>
                                    }
                                </button>
                            </li>
                            @if (!isViewer)
                            {
                                <li class="nav-item">
                                    <button class="nav-link @(taskDetailTab == "comments" ? "active" : "")" @onclick="ShowCommentsTab">
                                        <i class="bi bi-chat me-1"></i>Комментарии
                                        @if (taskDetail?.Comments?.Any() == true)
                                        {
                                            <span class="tab-badge">@taskDetail.Comments.Count</span>
                                        }
                                    </button>
                                </li>
                            }
                            <li class="nav-item">
                                <button class="nav-link @(taskDetailTab == "blockers" ? "active" : "")" @onclick="ShowBlockersTab">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Блокеры
                                    @if (taskDetail?.ActiveBlockers?.Any() == true)
                                    {
                                        <span class="tab-badge">@taskDetail.ActiveBlockers.Count</span>
                                    }
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(taskDetailTab == "attachments" ? "active" : "")" @onclick="ShowAttachmentsTab">
                                    <i class="bi bi-paperclip me-1"></i>Вложения
                                    @if (taskDetail?.Attachments?.Any() == true)
                                    {
                                        <span class="tab-badge">@taskDetail.Attachments.Count</span>
                                    }
                                </button>
                            </li>
                        </ul>
                        <div class="p-3">
                            @if (taskDetailTab == "info")
                            {
                                <div class="row">
                                    <div class="col-md-8">
                                        <h6 class="text-muted text-uppercase small">Описание</h6>
                                        <p>@(taskDetail.Description ?? "Нет описания")</p>
                                        @if (!string.IsNullOrEmpty(taskDetail.AcceptanceCriteria))
                                        {
                                            <h6 class="text-muted text-uppercase small mt-3">Критерии приёмки</h6>
                                            <div class="p-2 bg-light rounded">@taskDetail.AcceptanceCriteria</div>
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card bg-light border-0">
                                            <div class="card-body">
                                                <div class="mb-2"><small class="text-muted">Тип</small><div><strong>@GetTypeName(selectedTask.Type)</strong></div></div>
                                                <div class="mb-2"><small class="text-muted">SP</small><div><strong>@selectedTask.StoryPoints</strong></div></div>
                                                <div class="mb-2"><small class="text-muted">Оценка</small><div><strong>@(selectedTask.EstimatedHours?.ToString() ?? "—") ч.</strong></div></div>
                                                <div class="mb-3"><small class="text-muted">Исполнитель</small><div><strong>@(selectedTask.Assignee?.FullName ?? "Не назначен")</strong></div></div>
                                                @if (!isViewer && (IsDeveloper))
                                                {
                                                    if (selectedTask.Assignee == null)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success w-100" @onclick="AssignToMe">
                                                            <i class="bi bi-person-check me-1"></i> Назначить себе
                                                        </button>
                                                    }
                                                    else if (selectedTask.Assignee.Id == currentUserId)
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger w-100 mt-1" @onclick="UnassignFromMe">
                                                            <i class="bi bi-person-x me-1"></i> Снять
                                                        </button>
                                                    }
                                                }
                                                @if (!isViewer && IsScrumMaster)
                                                {
                                                    <div class="mt-2 pt-2 border-top">
                                                        <label class="form-label small text-muted">Назначить разработчика</label>
                                                        <select class="form-select form-select-sm" @bind="selectedDeveloperId">
                                                            <option value="">— Выберите —</option>
                                                            @foreach (var dev in availableDevelopers)
                                                            {
                                                                <option value="@dev.UserId" disabled="@(!dev.CanAssign)">
                                                                    @dev.FullName (@dev.CurrentTasks задач)
                                                                </option>
                                                            }
                                                        </select>
                                                        <button class="btn btn-sm btn-outline-primary w-100 mt-1"
                                                                @onclick="() => AssignDeveloper(selectedTask.Id)"
                                                                disabled="@(string.IsNullOrEmpty(selectedDeveloperId))">
                                                            <i class="bi bi-person-check me-1"></i> Назначить
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (taskDetailTab == "subtasks")
                            {
                                @if (taskDetail.SubTasks?.Any() == true)
                                {
                                    var doneCount = taskDetail.SubTasks.Count(st => st.Status == "Done");
                                    var totalCount = taskDetail.SubTasks.Count;
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small text-muted mb-1">
                                            <span>Прогресс</span><span>@doneCount из @totalCount</span>
                                        </div>
                                        <div class="progress" style="height:4px">
                                            <div class="progress-bar bg-success" style="width:@(totalCount > 0 ? (int)((double)doneCount / totalCount * 100) : 0)%"></div>
                                        </div>
                                    </div>
                                    @foreach (var st in taskDetail.SubTasks)
                                    {
                                        <div class="subtask-row @(st.Status == "Done" ? "done" : "")">
                                            <div>
                                                <span class="@GetSubTaskClass(st)">@st.Title</span>
                                                <div class="d-flex gap-3 text-muted smallest mt-0">
                                                    <span><i class="bi bi-clock me-1"></i>@(st.EstimatedHours?.ToString() ?? "—") ч.</span>
                                                    @if (st.Assignee != null)
                                                    {
                                                        <span><i class="bi bi-person me-1"></i>@st.Assignee.FullName</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                @if (!isViewer && CanModifyTask(selectedTask))
                                                {
                                                    @if (st.Status == "ToDo")
                                                    {
                                                        <button class="btn btn-outline-info btn-sm" @onclick="() => StartSubTask(st)" title="Начать">
                                                            <i class="bi bi-play-fill"></i>
                                                        </button>
                                                    }
                                                    else if (st.Status == "InProgress")
                                                    {
                                                        <button class="btn btn-outline-success btn-sm" @onclick="() => CompleteSubTask(st)" title="Завершить">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    }
                                                    else if (st.Status == "Done")
                                                    {
                                                        <button class="btn btn-outline-warning btn-sm" @onclick="() => ReopenSubTask(st)" title="Переоткрыть">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => DeleteSubTask(st.Id)" title="Удалить">
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-3 text-muted small">Нет подзадач</div>
                                }
                                @if (!isViewer && CanModifyTask(selectedTask))
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <label class="form-label small">Новая подзадача</label>
                                        <div class="d-flex gap-2">
                                            <input type="text" class="form-control form-control-sm" @bind="newSubTaskTitle" placeholder="Название..." />
                                            <input type="number" class="form-control form-control-sm" @bind="newSubTaskHours" placeholder="Часы" style="width: 80px;" step="0.5" min="0" />
                                            <button class="btn btn-primary btn-sm" @onclick="AddSubTask" disabled="@(string.IsNullOrWhiteSpace(newSubTaskTitle))">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                            else if (taskDetailTab == "comments" && !isViewer)
                            {
                                @if (taskDetail.Comments?.Any() == true)
                                {
                                    <div style="max-height:350px;overflow-y:auto" class="mb-3">
                                        @foreach (var c in taskDetail.Comments.OrderBy(c => c.CreatedAt))
                                        {
                                            <div class="d-flex mb-2 @(c.User?.Id == currentUserId ? "justify-content-end" : "")">
                                                <div class="@(c.User?.Id == currentUserId ? "bg-primary text-white" : "bg-light") rounded-3 p-2" style="max-width:80%">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <strong class="small">@(c.User?.FullName ?? "Пользователь")</strong>
                                                        @if (c.User?.Id == currentUserId)
                                                        {
                                                            <div class="btn-group btn-group-sm ms-2">
                                                                <button class="btn btn-sm btn-link text-white p-0" @onclick="() => StartEditComment(c)"><i class="bi bi-pencil"></i></button>
                                                                <button class="btn btn-sm btn-link text-white p-0 ms-1" @onclick="() => DeleteComment(c.Id)"><i class="bi bi-trash"></i></button>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (editingCommentId == c.Id)
                                                    {
                                                        <textarea @bind="editCommentText" class="form-control form-control-sm mb-1" rows="2"></textarea>
                                                        <div><button class="btn btn-sm btn-light" @onclick="SaveEditedComment">Сохранить</button><button class="btn btn-sm btn-link text-white ms-1" @onclick="CancelEditComment">Отмена</button></div>
                                                    }
                                                    else
                                                    {
                                                        <p class="mb-0 small">@c.Content</p>
                                                    }
                                                    <small class="@(c.User?.Id == currentUserId ? "text-white-50" : "text-muted")" style="font-size:0.65rem">@c.CreatedAt.ToString("dd.MM HH:mm") @(c.IsEdited ? "(изм.)" : "")</small>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">Нет комментариев</div>
                                }
                                <textarea @bind="newCommentText" class="form-control form-control-sm" rows="2" placeholder="Комментарий..."></textarea>
                                <button class="btn btn-sm btn-primary mt-2" @onclick="AddComment" disabled="@(string.IsNullOrWhiteSpace(newCommentText) || isAddingComment)">
                                    @if (isAddingComment)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Отправить
                                </button>
                            }
                            else if (taskDetailTab == "blockers")
                            {
                                @if (taskDetail.ActiveBlockers?.Any() == true)
                                {
                                    <div class="blockers-list mb-3">
                                        @foreach (var b in taskDetail.ActiveBlockers)
                                        {
                                            <div class="blocker-item @GetBlockerSeverityClass(b.Severity)">
                                                <div class="blocker-icon">
                                                    <i class="bi @GetBlockerIcon(b.Severity)"></i>
                                                </div>
                                                <div class="blocker-body">
                                                    <div class="blocker-text">@b.Description</div>
                                                    <div class="blocker-meta">
                                                        <span class="badge @GetBlockerSeverityBadge(b.Severity)">@GetBlockerSeverityText(b.Severity)</span>
                                                        <span class="text-muted smallest">@b.CreatedAt.ToString("dd.MM HH:mm")</span>
                                                    </div>
                                                </div>
                                                @if (!isViewer && CanModifyTask(selectedTask))
                                                {
                                                    <button class="btn btn-outline-success btn-sm blocker-resolve" @onclick="() => ResolveBlocker(b.Id)" title="Разрешить">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-3 text-muted small">
                                        <i class="bi bi-shield-check fs-4 opacity-25 d-block mb-2"></i>
                                        Нет активных блокеров
                                    </div>
                                }
                                @if (!isViewer && CanModifyTask(selectedTask))
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <label class="form-label small fw-medium">Добавить блокер</label>
                                        <textarea @bind="newBlockerDescription" class="form-control form-control-sm mb-2" rows="2" placeholder="Опишите проблему..."></textarea>
                                        <div class="d-flex gap-2">
                                            <select @bind="newBlockerSeverity" class="form-select form-select-sm" style="width: auto;">
                                                <option value="Low">Низкий</option>
                                                <option value="Medium">Средний</option>
                                                <option value="High">Высокий</option>
                                                <option value="Critical">Критический</option>
                                            </select>
                                            <button class="btn btn-danger btn-sm" @onclick="AddBlocker" disabled="@(string.IsNullOrWhiteSpace(newBlockerDescription))">
                                                <i class="bi bi-exclamation-triangle me-1"></i> Добавить
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                            else if (taskDetailTab == "attachments")
                            {
                                @if (taskDetail.Attachments?.Any() == true)
                                {
                                    <div class="attachments-list mb-3">
                                        @foreach (var a in taskDetail.Attachments)
                                        {
                                            <div class="attachment-item">
                                                <div class="attachment-icon">
                                                    <i class="bi @GetAttachmentIcon(a.MimeType)"></i>
                                                </div>
                                                <div class="attachment-body">
                                                    <div class="attachment-name">@a.FileName</div>
                                                    <div class="attachment-meta">
                                                        <span class="text-muted smallest">@a.FileSizeFormatted · @a.UploadedAt.ToString("dd.MM HH:mm")</span>
                                                        <span class="text-muted smallest">@a.UploadedBy?.FullName</span>
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => DownloadAttachment(a.Id)" title="Скачать">
                                                        <i class="bi bi-download"></i>
                                                    </button>
                                                    @if (!isViewer && CanModifyTask(selectedTask))
                                                    {
                                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAttachment(a.Id)" title="Удалить">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-3 text-muted small">
                                        <i class="bi bi-paperclip fs-4 opacity-25 d-block mb-2"></i>
                                        Нет вложений
                                    </div>
                                }
                                @if (!isViewer && CanModifyTask(selectedTask))
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <label class="form-label small fw-medium">Загрузить файл</label>
                                        <InputFile OnChange="OnFileSelected" class="form-control form-control-sm" />
                                        @if (selectedFile != null)
                                        {
                                            <div class="d-flex align-items-center gap-2 mt-2">
                                                <span class="small text-muted">@selectedFile.Name</span>
                                                <button class="btn btn-primary btn-sm" @onclick="UploadFile" disabled="@isUploading">
                                                    @if (isUploading)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                    }
                                                    <i class="bi bi-upload me-1"></i> Загрузить
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="modal-footer"><button class="btn btn-secondary btn-sm" @onclick="CloseTaskDetail">Закрыть</button></div>
                </div>
            </div>
        </div>
    }
    else if (isTaskDetailLoading)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <div class="spinner-border text-primary mb-2"></div>
                        <p class="text-muted small mb-0">Загрузка задачи...</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }
</div>

