@code {
    [Parameter] public Guid SprintId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private Guid? currentUserId;
    private string taskDetailTab = "info";
    private string activeView = "board";
    private Guid? editingCommentId;
    private string editCommentText = "";
    private string newCommentText = "";
    private string newSubTaskTitle = "";
    private double? newSubTaskHours = null;
    private string newBlockerDescription = "";
    private string newBlockerSeverity = "Medium";
    private bool isAddingComment = false;
    private List<BurndownPoint>? burndownData;
    private bool isBurndownLoading = false;
    private bool isGanttLoading = false;
    private SprintBoardResponse? sprint;
    private BacklogItemDetailResponse? taskDetail;
    private BacklogItemBoardResponse? selectedTask;
    private BacklogItemBoardResponse? draggedTask;
    private string selectedStatus = "ToDo";
    private bool isLoading = true;
    private bool showCompleteModal = false;
    private bool isViewer = false;
    private bool isScrumMaster = false;
    private bool isProductOwner = false;
    private string currentUserRole = "";
    private CompleteSprintRequest completeRequest = new();
    private bool isTaskDetailLoading = false;
    private bool isUpdating = false;


    private string GetPriorityClass(int? p)
    {
        if (p == null)
        {
            return "";
        }
        return p switch
        {
            <= 3 => "priority-high",
            <= 6 => "priority-medium",
            _ => "priority-low"
        };
    }

    private string GetTypeBadge(string t)
    {
        return t switch
        {
            "UserStory" => "bg-primary",
            "Bug" => "bg-danger",
            "TechnicalTask" => "bg-warning text-dark",
            "Improvement" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetBlockerSeverityBadge(string s)
    {
        return s switch
        {
            "Critical" => "bg-danger",
            "High" => "bg-warning text-dark",
            "Medium" => "bg-info",
            _ => "bg-secondary"
        };
    }

    private void ShowInfoTab()
    {
        taskDetailTab = "info";
        StateHasChanged();
    }

    private void ShowSubtasksTab()
    {
        taskDetailTab = "subtasks";
        StateHasChanged();
    }

    private void ShowCommentsTab()
    {
        taskDetailTab = "comments";
        StateHasChanged();
    }

    private void ShowBlockersTab()
    {
        taskDetailTab = "blockers";
        StateHasChanged();
    }

    private void ShowBoardTab()
    {
        activeView = "board";
        StateHasChanged();
    }

    private void ShowBurndownTab()
    {
        activeView = "burndown";
        StateHasChanged();
        ShowBurndown();
    }

    private void ShowGanttTab()
    {
        activeView = "gantt";
        StateHasChanged();
        ShowGantt();
    }

    private bool CanModifyTask(BacklogItemBoardResponse t)
    {
        if (isViewer)
        {
            return false;
        }
        if (t == null || currentUserId == null)
        {
            return false;
        }
        if (t.Assignee == null)
        {
            return true;
        }
        return t.Assignee.Id == currentUserId;
    }

    private bool IsProductOwner
    {
        get
        {
            return sprint?.ProjectOwnerId == currentUserId || currentUserRole == "ProductOwner";
        }
    }

    private bool IsScrumMaster
    {
        get
        {
            return currentUserRole == "ScrumMaster";
        }
    }

    private void OnDragStart(BacklogItemBoardResponse t)
    {
        if (isViewer)
        {
            return;
        }
        draggedTask = t;
    }

    private void OnDragEnd()
    {
        draggedTask = null;
    }

    private void OnDragOver()
    {
    }


    private async Task OnDropTo(string status)
    {
        if (isViewer || isUpdating)
        {
            return;
        }

        if (draggedTask == null || draggedTask.Status == status)
        {
            draggedTask = null;
            return;
        }

        isUpdating = true;
        var taskId = draggedTask.Id;
        draggedTask = null;

        try
        {
            var r = await SprintService.UpdateTaskStatusAsync(taskId, status);
            if (r.Success)
            {
                await LoadSprint();
            }
            else
            {
                await InvokeAsync(async () =>
                {
                    await DialogService.AlertAsync(
                        r.Message ?? "Не удалось изменить статус задачи",
                        "Ошибка",
                        "",
                        "danger");
                });
            }
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadSprint();
        await CheckViewerRole();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
            if (claim != null)
            {
                currentUserId = Guid.Parse(claim.Value);
            }
        }
        catch
        {
        }
    }

    private async Task CheckViewerRole()
    {
        try
        {
            if (sprint == null || currentUserId == null)
            {
                return;
            }
            var membersResult = await ProjectService.GetProjectMembersAsync(sprint.ProjectId);
            if (membersResult.Success && membersResult.Data != null)
            {
                var member = membersResult.Data.FirstOrDefault(m => m.UserId == currentUserId.Value);
                if (member != null)
                {
                    isViewer = member.Role == "Viewer";
                    isScrumMaster = member.Role == "ScrumMaster";
                    isProductOwner = member.Role == "ProductOwner";
                    currentUserRole = member.Role;
                }
                if (sprint.ProjectOwnerId == currentUserId)
                {
                    isProductOwner = true;
                }
            }
        }
        catch
        {
        }
    }

    private async Task LoadSprint()
    {
        isLoading = true;
        try
        {
            var r = await SprintService.GetSprintBoardAsync(SprintId);
            if (r.Success && r.Data != null)
            {
                sprint = r.Data;
                completeRequest = new CompleteSprintRequest { SprintId = SprintId };
                await LoadBurndownData();
                if (TaskId != Guid.Empty)
                {
                    await OpenTaskDetailFromUrl(TaskId);
                }
            }
            else
            {
                Navigation.NavigateTo("/projects");
            }
        }
        catch
        {
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AssignToMe()
    {
        if (isViewer || selectedTask == null || currentUserId == null)
        {
            return;
        }
        var r = await BacklogService.UpdateBacklogItemAsync(
            selectedTask.Id,
            new UpdateBacklogItemRequest { AssigneeId = currentUserId.Value });
        if (r.Success)
        {
            await LoadSprint();
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message);
        }
    }

    private async Task UnassignFromMe()
    {
        if (isViewer || selectedTask == null || currentUserId == null)
        {
            return;
        }
        var r = await BacklogService.UpdateBacklogItemAsync(
            selectedTask.Id,
            new UpdateBacklogItemRequest { AssigneeId = Guid.Empty });
        if (r.Success)
        {
            await LoadSprint();
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message);
        }
    }

    private async Task AddComment()
    {
        if (isViewer || selectedTask == null || string.IsNullOrWhiteSpace(newCommentText))
        {
            return;
        }
        isAddingComment = true;
        var r = await BacklogService.AddCommentAsync(
            selectedTask.Id,
            new AddCommentRequest { Content = newCommentText });
        if (r.Success)
        {
            newCommentText = "";
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message);
        }
        isAddingComment = false;
    }

    private async Task OpenTaskDetail(Guid id, bool forceReload = false)
    {
        if (!forceReload && taskDetail?.Id == id)
        {
            selectedTask = sprint?.Tasks.FirstOrDefault(t => t.Id == id);
            selectedStatus = selectedTask?.Status ?? "ToDo";
            StateHasChanged();
            return;
        }

        isTaskDetailLoading = true;
        StateHasChanged();

        taskDetail = null;

        var r = await BacklogService.GetBacklogItemDetailAsync(id);
        if (r.Success && r.Data != null)
        {
            taskDetail = r.Data;
            selectedTask = sprint?.Tasks.FirstOrDefault(t => t.Id == id);
            selectedStatus = selectedTask?.Status ?? "ToDo";
        }

        isTaskDetailLoading = false;
        StateHasChanged();
    }

    private async Task AddSubTask()
    {
        if (selectedTask == null || string.IsNullOrWhiteSpace(newSubTaskTitle))
        {
            return;
        }
        var r = await SubTaskService.CreateSubTaskAsync(new CreateSubTaskRequest
        {
            BacklogItemId = selectedTask.Id,
            Title = newSubTaskTitle,
            EstimatedHours = (decimal?)newSubTaskHours
        });

        if (r.Success)
        {
            newSubTaskTitle = "";
            newSubTaskHours = null;
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message ?? "Ошибка создания подзадачи");
        }
    }

    private async Task DeleteSubTask(Guid subTaskId)
    {
        var ok = await DialogService.ConfirmAsync("Удалить подзадачу?", "Удаление", "Удалить", "danger");
        if (!ok)
        {
            return;
        }
        var r = await SubTaskService.DeleteSubTaskAsync(subTaskId);
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message ?? "Ошибка удаления");
        }
    }

    private async Task AddBlocker()
    {
        if (selectedTask == null || string.IsNullOrWhiteSpace(newBlockerDescription))
        {
            return;
        }
        var r = await BacklogService.AddBlockerAsync(selectedTask.Id, new AddBlockerRequest
        {
            Description = newBlockerDescription,
            Severity = newBlockerSeverity
        });

        if (r.Success)
        {
            newBlockerDescription = "";
            newBlockerSeverity = "Medium";
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message ?? "Ошибка добавления блокера");
        }
    }

    private async Task ResolveBlocker(Guid blockerId)
    {
        var r = await BacklogService.ResolveBlockerAsync(blockerId, new ResolveBlockerRequest { ResolutionNote = "Разрешено" });
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message ?? "Ошибка разрешения блокера");
        }
    }

    private void CloseTaskDetail()
    {
        selectedTask = null;
        taskDetail = null;
    }

    private async Task LoadBurndownData()
    {
        if (sprint == null)
        {
            return;
        }
        isBurndownLoading = true;
        StateHasChanged();
        var r = await SprintService.GetBurndownChartAsync(SprintId);
        if (r.Success && r.Data != null && r.Data.Any())
        {
            burndownData = r.Data;
            await Task.Delay(100);
            await JS.InvokeVoidAsync("drawBurndownChart", burndownData);
        }
        else
        {
            burndownData = new();
        }
        isBurndownLoading = false;
        StateHasChanged();
    }

    private async void ShowBurndown()
    {
        if (burndownData?.Any() == true)
        {
            await Task.Delay(300);
            await JS.InvokeVoidAsync("drawBurndownChart", burndownData);
        }
    }

    private async void ShowGantt()
    {
        await Task.Delay(300);
        await DrawGanttChart();
    }

    private async Task DrawGanttChart()
    {
        if (sprint?.Tasks == null)
        {
            return;
        }
        isGanttLoading = true;
        StateHasChanged();
        var tasks = sprint.Tasks
            .Where(t => t.Status != "Backlog")
            .OrderBy(t => t.Status == "Done" ? 2 : t.Status == "InProgress" ? 1 : 0)
            .ThenBy(t => t.Title)
            .Select(t => new
            {
                id = t.Id.ToString(),
                title = t.Title.Length > 50 ? t.Title[..47] + "..." : t.Title,
                fullTitle = t.Title,
                status = t.Status,
                storyPoints = t.StoryPoints,
                estimatedHours = t.EstimatedHours,
                assignee = t.Assignee?.FullName ?? "Не назначен",
                startDate = GetTaskStartDate(t),
                endDate = GetTaskEndDate(t)
            }).ToList();
        await JS.InvokeVoidAsync("drawGanttChart", tasks, sprint.StartDate.ToString("yyyy-MM-dd"), sprint.EndDate.ToString("yyyy-MM-dd"));
        isGanttLoading = false;
        StateHasChanged();
    }

    private DateTime GetTaskStartDate(BacklogItemBoardResponse t)
    {
        var d = (sprint!.EndDate - sprint.StartDate).Days;
        return t.Status switch
        {
            "Done" => sprint.StartDate.AddDays(d * 0.1),
            "InProgress" => sprint.StartDate.AddDays(d * 0.2),
            "ToDo" => sprint.StartDate.AddDays(d * 0.5),
            _ => sprint.StartDate
        };
    }

    private DateTime GetTaskEndDate(BacklogItemBoardResponse t)
    {
        var d = (sprint!.EndDate - sprint.StartDate).Days;
        return t.Status switch
        {
            "Done" => sprint.EndDate.AddDays(-d * 0.1),
            "InProgress" => sprint.EndDate.AddDays(-d * 0.05),
            "ToDo" => sprint.EndDate.AddDays(-d * 0.1),
            _ => sprint.EndDate
        };
    }

    private async Task OpenTaskDetailFromUrl(Guid id)
    {
        var r = await BacklogService.GetBacklogItemDetailAsync(id);
        if (r.Success && r.Data != null)
        {
            taskDetail = r.Data;
            selectedTask = sprint?.Tasks.FirstOrDefault(t => t.Id == id);
            selectedStatus = selectedTask?.Status ?? "ToDo";
            StateHasChanged();
        }
    }

    private async Task StartSprint()
    {
        if (isViewer || sprint?.Status != "Planned")
        {
            await ErrorHandling.TriggerError("Нельзя запустить");
            return;
        }
        var r = await SprintService.StartSprintAsync(new StartSprintRequest
        {
            SprintId = SprintId,
            BacklogItemIds = sprint.Tasks.Where(t => t.Status == "Backlog").Select(t => t.Id).ToList()
        });
        if (r.Success)
        {
            await LoadSprint();
            await DialogService.AlertAsync("Спринт запущен", "", "bi bi-play-circle", "success");
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message);
        }
    }

    private void ShowCompleteModal()
    {
        completeRequest = new CompleteSprintRequest { SprintId = SprintId };
        showCompleteModal = true;
        StateHasChanged();
    }

    private void CloseCompleteModal()
    {
        showCompleteModal = false;
        StateHasChanged();
    }

    private async Task CompleteSprint()
    {
        if (isViewer || string.IsNullOrWhiteSpace(completeRequest.ReviewNotes))
        {
            await ErrorHandling.TriggerError("Заполните заметки");
            return;
        }
        var r = await SprintService.CompleteSprintAsync(completeRequest);
        if (r.Success)
        {
            CloseCompleteModal();
            await LoadSprint();
            await DialogService.AlertAsync("Спринт завершён", "", "bi bi-check-circle", "success");
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message);
        }
    }

    private async Task CancelSprint()
    {
        if (isViewer)
        {
            return;
        }
        var ok = await DialogService.ConfirmAsync("Отменить спринт?", "Отмена", "Отменить", "danger");
        if (!ok)
        {
            return;
        }
        var r = await SprintService.CancelSprintAsync(SprintId);
        if (r.Success)
        {
            await LoadSprint();
            await DialogService.AlertAsync("Спринт отменён", "", "bi bi-x-circle", "info");
        }
        else
        {
            await ErrorHandling.TriggerError(r.Message);
        }
    }

    private void GoToRetrospective()
    {
        Navigation.NavigateTo($"/retrospective/{SprintId}");
    }

    private void GoToProject()
    {
        if (sprint?.ProjectId != null && sprint.ProjectId != Guid.Empty)
        {
            Navigation.NavigateTo($"/projects/{sprint.ProjectId}");
        }
        else
        {
            ErrorHandling.TriggerError("Не удалось определить проект");
        }
    }

    private bool IsSubTaskDone(SubTaskResponse st)
    {
        return st.Status == "Done";
    }

    private string GetSubTaskClass(SubTaskResponse st)
    {
        return st.Status == "Done" ? "text-decoration-line-through text-muted" : "";
    }

    private async Task ToggleSubTask(SubTaskResponse st)
    {
        if (isViewer)
        {
            return;
        }
        var newStatus = st.Status == "Done" ? "ToDo" : "Done";
        var r = await SubTaskService.ChangeStatusAsync(st.Id, new ChangeSubTaskStatusRequest { NewStatus = newStatus });
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
    }

    private void StartEditComment(CommentResponse c)
    {
        editingCommentId = c.Id;
        editCommentText = c.Content;
        StateHasChanged();
    }

    private void CancelEditComment()
    {
        editingCommentId = null;
        editCommentText = "";
        StateHasChanged();
    }

    private async Task StartSubTask(SubTaskResponse st)
    {
        var r = await SubTaskService.StartSubTaskAsync(new StartSubTaskRequest { SubTaskId = st.Id });
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
    }

    private async Task CompleteSubTask(SubTaskResponse st)
    {
        var r = await SubTaskService.CompleteSubTaskAsync(new CompleteSubTaskRequest { SubTaskId = st.Id });
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
    }

    private async Task ReopenSubTask(SubTaskResponse st)
    {
        var r = await SubTaskService.ChangeStatusAsync(st.Id, new ChangeSubTaskStatusRequest { NewStatus = "ToDo" });
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
    }

    private async Task SaveEditedComment()
    {
        if (editingCommentId == null || selectedTask == null)
        {
            return;
        }
        var r = await BacklogService.UpdateCommentAsync(editingCommentId.Value, new UpdateCommentRequest { Content = editCommentText });
        if (r.Success)
        {
            editingCommentId = null;
            editCommentText = "";
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
    }

    private async Task DeleteComment(Guid id)
    {
        var ok = await DialogService.ConfirmAsync("Удалить комментарий?", "Удаление", "Удалить", "danger");
        if (!ok)
        {
            return;
        }
        var r = await BacklogService.DeleteCommentAsync(id);
        if (r.Success && selectedTask != null)
        {
            await OpenTaskDetail(selectedTask.Id, forceReload: true);
        }
    }

    private string GetBlockerSeverityText(string s)
    {
        return s switch
        {
            "Critical" => "Критический",
            "High" => "Высокий",
            "Medium" => "Средний",
            "Low" => "Низкий",
            _ => s
        };
    }

    private string GetBlockerIcon(string s)
    {
        return s switch
        {
            "Critical" => "bi-exclamation-diamond-fill",
            "High" => "bi-exclamation-triangle-fill",
            "Medium" => "bi-exclamation-circle-fill",
            "Low" => "bi-info-circle-fill",
            _ => "bi-dot"
        };
    }

    private string GetBlockerSeverityClass(string s)
    {
        return s switch
        {
            "Critical" => "severity-critical",
            "High" => "severity-high",
            "Medium" => "severity-medium",
            "Low" => "severity-low",
            _ => ""
        };
    }
}