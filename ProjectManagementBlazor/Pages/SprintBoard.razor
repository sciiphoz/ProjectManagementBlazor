    private async Task CheckViewerRole()
    {
        try
        {
            if (sprint == null || currentUserId == null)
            {
                return;
            }
            var membersResult = await ProjectService.GetProjectMembersAsync(sprint.ProjectId);
            if (membersResult.Success && membersResult.Data != null)
            {
                var member = membersResult.Data.FirstOrDefault(m => m.UserId == currentUserId.Value);
                if (member != null)
                {
                    isViewer = member.Role == "Viewer";
                    isScrumMaster = member.Role == "ScrumMaster";
                    isProductOwner = member.Role == "ProductOwner";
                    currentUserRole = member.Role;
                }
                if (sprint.ProjectOwnerId == currentUserId)
                {
                    isProductOwner = true;
                }
            }
            if (IsScrumMaster && membersResult.Data != null)
            {
                availableDevelopers = membersResult.Data
                    .Where(m => m.Role == "Developer")
                    .Select(m => new DeveloperInfo
                    {
                        UserId = m.UserId.ToString(),
                        FullName = m.FullName,
                        CurrentTasks = sprint?.Tasks.Count(t => t.Assignee?.Id == m.UserId && t.Status != "Done") ?? 0
                    })
                    .OrderBy(d => d.CurrentTasks)
                    .ToList();
            }
            if (sprint != null && !sprint.IsActive)
            {
                var sprintsResult = await SprintService.GetProjectSprintsAsync(sprint.ProjectId);
                if (sprintsResult.Success && sprintsResult.Data != null)
                {
                    hasOtherActiveSprint = sprintsResult.Data.Any(s => s.IsActive && s.Id != SprintId);
                }
            }
        }
        catch
        {
        }
    }

