@page "/register"
@using System.ComponentModel.DataAnnotations
@using ProjectManagementBlazor.DTO.Requests
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>

<div class="auth-container">
    <div class="auth-split">
        <!-- Левая сторона — форма -->
        <div class="auth-form-side">
            <div class="auth-form-wrapper">
                <h3 class="mb-3">Регистрация</h3>
                <p class="text-muted mb-4">Создайте аккаунт для управления проектами</p>

                <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister">
                    <DataAnnotationsValidator />

                    <div class="mb-2">
                        <label class="form-label">Имя пользователя</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <InputText @bind-Value="registerModel.Username" class="form-control" placeholder="Придумайте логин" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.Username)" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <InputText type="email" @bind-Value="registerModel.Email" class="form-control" placeholder="Введите email" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.Email)" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Полное имя</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                            <InputText @bind-Value="registerModel.FullName" class="form-control" placeholder="Введите полное имя" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.FullName)" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Пароль</label>
                        <InputText type="password" @bind-Value="registerModel.Password" class="form-control" placeholder="Минимум 6 символов" />
                        <ValidationMessage For="@(() => registerModel.Password)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Подтверждение пароля</label>
                        <InputText type="password" @bind-Value="registerModel.ConfirmPassword" class="form-control" placeholder="Повторите пароль" />
                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Зарегистрироваться
                    </button>
                </EditForm>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3 small" style="white-space: pre-line;">@errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success mt-3 small">@successMessage</div>
                }

                <p class="text-center mt-3 mb-0 small">
                    Уже есть аккаунт? <a href="/login" class="fw-bold">Войти</a>
                </p>
            </div>
        </div>

        <!-- Правая сторона — брендинг -->
        <div class="auth-brand-side" style="background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);">
            <div class="auth-brand-content">
                <h2>Присоединяйтесь!</h2>
                <p class="lead">Создайте аккаунт и начните эффективно управлять проектами с командой</p>
                <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-kanban"></i>
                        <span class="small">Визуальное управление задачами</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-check"></i>
                        <span class="small">Планирование спринтов</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart"></i>
                        <span class="small">Отслеживание прогресса команды</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span class="small">Безопасность и ролевая модель</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        display: flex;
        margin: -1.1rem;
    }

    .auth-split {
        display: flex;
        width: 100%;
    }

    .auth-form-side {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 3rem;
        background: #fff;
    }

    .auth-form-wrapper {
        width: 100%;
        max-width: 420px;
    }

        .auth-form-wrapper h3 {
            font-weight: 700;
            color: var(--text-primary);
        }

    .auth-brand-side {
        flex: 1;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
    }

    .auth-brand-content {
        max-width: 420px;
    }

        .auth-brand-content h2 {
            color: #fff !important;
            font-weight: 700;
            font-size: 1.75rem;
        }

        .auth-brand-content .lead {
            color: rgba(255,255,255,0.9) !important;
            font-size: 0.95rem;
        }

        .auth-brand-content i {
            font-size: 1.2rem;
            opacity: 0.85;
            width: 1.5rem;
            text-align: center;
        }

    @@media (max-width: 768px) {
        .auth-split {
            flex-direction: column;
        }

        .auth-brand-side {
            display: none;
        }

        .auth-form-side {
            padding: 2rem 1.5rem;
        }

        .auth-container {
            margin: 0;
        }
    }
</style>

@code {
    private RegisterRequest registerModel = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (System.Web.HttpUtility.ParseQueryString(uri.Query).Get("registered") == "true")
        {
            successMessage = "Регистрация успешна! Теперь вы можете войти.";
        }
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var result = await AuthService.RegisterAsync(registerModel);

            if (result.Success)
            {
                successMessage = "Регистрация успешна! Перенаправляем на страницу входа...";
                StateHasChanged();
                await Task.Delay(1500);
                Navigation.NavigateTo("/login?registered=true");
            }
            else
            {
                errorMessage = result.Message;

                if (result.Errors != null && result.Errors.Any())
                {
                    errorMessage += "\n\n" + string.Join("\n", result.Errors.Select(e => $"• {e}"));
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}Ё