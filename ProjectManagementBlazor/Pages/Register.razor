@page "/register"
@using System.ComponentModel.DataAnnotations
@using ProjectManagementBlazor.DTO.Requests
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>

<div class="auth-container">
    <div class="auth-split">
        <div class="auth-form-side">
            <div class="auth-form-wrapper">
                <h3 class="mb-3">Регистрация</h3>
                <p class="text-muted mb-4">Создайте аккаунт для управления проектами</p>

                <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister">
                    <DataAnnotationsValidator />

                    <div class="mb-2">
                        <label class="form-label">Имя пользователя</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <InputText @bind-Value="registerModel.Username" class="form-control" placeholder="Придумайте логин" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.Username)" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <InputText type="email" @bind-Value="registerModel.Email" class="form-control" placeholder="Введите email" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.Email)" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Полное имя</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                            <InputText @bind-Value="registerModel.FullName" class="form-control" placeholder="Введите полное имя" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.FullName)" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Пароль</label>
                        <InputText type="password" @bind-Value="registerModel.Password" class="form-control" placeholder="Минимум 6 символов" />
                        <ValidationMessage For="@(() => registerModel.Password)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Подтверждение пароля</label>
                        <InputText type="password" @bind-Value="registerModel.ConfirmPassword" class="form-control" placeholder="Повторите пароль" />
                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Зарегистрироваться
                    </button>
                </EditForm>

                @if (hasError)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3 small" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span style="white-space: pre-line;">@errorMessage</span>
                        <button type="button" class="btn-close" @onclick="ClearError" aria-label="Close"></button>
                    </div>
                }

                @if (hasSuccess)
                {
                    <div class="alert alert-success alert-dismissible fade show mt-3 small" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @successMessage
                        <button type="button" class="btn-close" @onclick="ClearSuccess" aria-label="Close"></button>
                    </div>
                }

                <p class="text-center mt-3 mb-0 small">
                    Уже есть аккаунт? <a href="/login@(returnUrl != null ? $"?returnUrl={Uri.EscapeDataString(returnUrl)}" : "")" class="fw-bold">Войти</a>
                </p>
            </div>
        </div>

        <div class="auth-brand-side" style="background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);">
            <div class="auth-brand-content">
                <h2>Присоединяйтесь!</h2>
                <p class="lead">Создайте аккаунт и начните эффективно управлять проектами с командой</p>
                <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-kanban"></i>
                        <span class="small">Визуальное управление задачами</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-check"></i>
                        <span class="small">Планирование спринтов</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart"></i>
                        <span class="small">Отслеживание прогресса команды</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span class="small">Безопасность и ролевая модель</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        display: flex;
        margin: -1.1rem;
    }

    .auth-split {
        display: flex;
        width: 100%;
    }

    .auth-form-side {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 3rem;
        background: #fff;
    }

    .auth-form-wrapper {
        width: 100%;
        max-width: 420px;
    }

        .auth-form-wrapper h3 {
            font-weight: 700;
            color: var(--text-primary);
        }

    .auth-brand-side {
        flex: 1;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
    }

    .auth-brand-content {
        max-width: 420px;
    }

        .auth-brand-content h2 {
            color: #fff !important;
            font-weight: 700;
            font-size: 1.75rem;
        }

        .auth-brand-content .lead {
            color: rgba(255,255,255,0.9) !important;
            font-size: 0.95rem;
        }

        .auth-brand-content i {
            font-size: 1.2rem;
            opacity: 0.85;
            width: 1.5rem;
            text-align: center;
        }

    [data-bs-theme="dark"] .auth-form-side {
        background: #1E293B;
    }

    [data-bs-theme="dark"] .auth-form-wrapper h3 {
        color: #F1F5F9;
    }

    [data-bs-theme="dark"] .auth-form-wrapper .text-muted {
        color: #94A3B8 !important;
    }

    [data-bs-theme="dark"] .form-control {
        background: #334155;
        border-color: #475569;
        color: #F1F5F9;
    }

    [data-bs-theme="dark"] .input-group-text {
        background: #475569;
        border-color: #475569;
        color: #CBD5E1;
    }

    [data-bs-theme="dark"] a {
        color: #818CF8;
    }

    @@media (max-width: 768px) {
        .auth-split {
            flex-direction: column;
        }

        .auth-brand-side {
            display: none;
        }

        .auth-form-side {
            padding: 2rem 1.5rem;
        }

        .auth-container {
            margin: 0;
        }
    }
</style>

@code {
    private RegisterRequest registerModel = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string? returnUrl;
    private bool hasError = false;
    private bool hasSuccess = false;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        returnUrl = query.Get("returnUrl");

        if (query.Get("registered") == "true")
        {
            successMessage = "Регистрация успешна! Теперь вы можете войти.";
            hasSuccess = true;
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        hasError = false;
        hasSuccess = false;

        if (string.IsNullOrWhiteSpace(registerModel.Username))
        {
            errorMessage = "Введите имя пользователя";
            hasError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(registerModel.Email))
        {
            errorMessage = "Введите email";
            hasError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(registerModel.FullName))
        {
            errorMessage = "Введите полное имя";
            hasError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(registerModel.Password))
        {
            errorMessage = "Введите пароль";
            hasError = true;
            return;
        }

        if (registerModel.Password.Length < 6)
        {
            errorMessage = "Пароль должен содержать минимум 6 символов";
            hasError = true;
            return;
        }

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            errorMessage = "Пароли не совпадают";
            hasError = true;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await AuthService.RegisterAsync(registerModel);

            if (result == null)
            {
                errorMessage = "Не удалось зарегистрироваться: сервер не ответил";
                hasError = true;
                return;
            }

            if (result.Success)
            {
                hasSuccess = true;
                successMessage = "Регистрация успешна! Перенаправляем на страницу входа...";
                StateHasChanged();
                await Task.Delay(1500);
                Navigation.NavigateTo($"/login?registered=true{(returnUrl != null ? $"&returnUrl={Uri.EscapeDataString(returnUrl)}" : "")}");
                return;
            }
            else
            {
                errorMessage = string.IsNullOrEmpty(result.Message) ? "Ошибка регистрации" : result.Message;

                if (result.Errors != null && result.Errors.Any())
                {
                    errorMessage += "\n" + string.Join("\n", result.Errors.Select(e => $"• {e}"));
                }
                hasError = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка соединения: {ex.Message}";
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        errorMessage = string.Empty;
        hasError = false;
    }

    private void ClearSuccess()
    {
        successMessage = string.Empty;
        hasSuccess = false;
    }
}