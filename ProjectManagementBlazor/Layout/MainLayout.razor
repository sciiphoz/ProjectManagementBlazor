@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IErrorHandlingService ErrorHandling
@inject DialogService DialogService

<PageTitle>Project Management System</PageTitle>

<div class="page">
    @if (showSidebar)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        @if (showErrorDialog)
        {
            <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5); z-index: 1060;">
                <div class="modal-dialog modal-sm modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h6 class="modal-title">Ошибка</h6>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseErrorDialog"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0 small">@errorDialogMessage</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary btn-sm" @onclick="CloseErrorDialog">Закрыть</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-backdrop show"></div>
        }

        <article class="content px-4" style="padding-right: 0rem !important;">
            @Body
        </article>
    </main>
</div>

<ConfirmDialog @ref="confirmDialog" />
<AlertDialog @ref="alertDialog" />

<style>
    .page {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }

    .sidebar {
        background-color: #F8F9FB !important;
        background-image: none !important;
        border-right: 1px solid #E2E8F0;
    }

    @@media (min-width: 641px) {
        .page {
            flex-direction: row;
        }

        .sidebar {
            width: 240px;
            height: 100vh;
            position: sticky;
            top: 0;
        }

        .top-row, article {
            padding-left: 2rem !important;
            padding-right: 1.5rem !important;
        }
    }
</style>

@code {
    private bool showSidebar = true;
    private ConfirmDialog confirmDialog = default!;
    private AlertDialog alertDialog = default!;
    private bool showErrorDialog = false;
    private string errorDialogMessage = "";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        CheckLocation(Navigation.Uri);
        DialogService.OnConfirm += HandleConfirm;
        DialogService.OnAlert += HandleAlert;
        ErrorHandling.OnError += OnErrorReceived;
    }

    private Task OnErrorReceived(string message)
    {
        errorDialogMessage = message;
        showErrorDialog = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CloseErrorDialog()
    {
        showErrorDialog = false;
        StateHasChanged();
    }


    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CheckLocation(e.Location);
        StateHasChanged();
    }

    private void CheckLocation(string uri)
    {
        if (uri.Contains("/login") ||
            uri.Contains("/register") ||
            uri.Contains("/forgot-password") ||
            uri.Contains("/reset-password"))
        {
            showSidebar = false;
        }
        else
        {
            showSidebar = true;
        }
    }

    private async Task<bool> HandleConfirm(string message, string title, string confirmText, string type)
    {
        var tcs = new TaskCompletionSource<bool>();

        await confirmDialog.ShowAsync(message, title, confirmText, "Отмена", type, result =>
        {
            tcs.SetResult(result);
        });

        return await tcs.Task;
    }

    private async Task HandleAlert(string message, string title, string icon, string type)
    {
        await alertDialog.ShowAsync(message, title, icon, type);
    }

    public void Dispose()
    {
        ErrorHandling.OnError -= OnErrorReceived;
        DialogService.OnConfirm -= HandleConfirm;
        DialogService.OnAlert -= HandleAlert;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}