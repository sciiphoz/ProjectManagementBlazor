@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IErrorHandlingService ErrorHandling

<PageTitle>Project Management System</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="ms-auto">
                <button class="btn btn-link" @onclick="Logout">Выйти</button>
            </span>
        </div>

        <ErrorDisplay />

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task Logout()
    {
        try
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            await ErrorHandling.TriggerError($"Ошибка при выходе: {ex.Message}");
        }
    }
}