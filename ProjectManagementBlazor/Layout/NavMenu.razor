@inject INotificationService NotificationService
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Project Management</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Главная
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Проекты
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard">
                <span class="oi oi-dashboard" aria-hidden="true"></span> Мой день
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profile">
                <span class="oi oi-person" aria-hidden="true"></span> Профиль
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <span class="oi oi-bell" aria-hidden="true"></span>
                Уведомления
                @if (unreadCount > 0)
                {
                    <span class="badge bg-danger ms-1">@unreadCount</span>
                }
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private int unreadCount = 0;
    private bool isInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        if (!isInitialized)
        {
            await LoadUnreadCount();
            isInitialized = true;
        }
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            // Проверяем, есть ли токен в localStorage
            var token = await GetTokenFromLocalStorage();
            if (string.IsNullOrEmpty(token))
            {
                return;
            }

            var result = await NotificationService.GetUnreadCountAsync();
            if (result.Success)
            {
                unreadCount = result.Data;
            }
        }
        catch (Exception ex)
        {
            // Игнорируем ошибки авторизации
            Console.WriteLine($"Ошибка загрузки уведомлений: {ex.Message}");
            unreadCount = 0;
        }
    }

    private async Task<string?> GetTokenFromLocalStorage()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", "authToken");
        }
        catch
        {
            return null;
        }
    }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}